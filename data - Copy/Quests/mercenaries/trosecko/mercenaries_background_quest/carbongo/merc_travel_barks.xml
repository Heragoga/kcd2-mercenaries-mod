<?xml version="1.0" encoding="utf-8"?>
<Database xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Name="brambora">
    <Skald>
        <Dialog Name="merc_travel_barks">
            <Text StringName="merc_travel_barks_name" Text="Mercenary merc_travel_barks" />
            <Dialogue Type="ingame monolog" TechnicalStatus="Enabled" Initiator="NonPlayer" ForceMood="noScope" ClashPriority="OpenWorld" GesturesNotNeeded="true">
                <SelectedSouls>
                    <SelectedSoul Role="role_mercenary_test" Voice="jcom" Type="Wave" Language="ENG" />
                    <SelectedSoul Role="role_mercenary_test" Voice="phos2" Type="Wave" Language="ENG" />
                    <SelectedSoul Role="role_mercenary_test" Voice="sbar" Type="Wave" Language="ENG" />
                </SelectedSouls>
                <Decision Name="dec_merc_travel_barks" Priority="General" Autoselect="true" Alias="merc_travel_barks">
                    <Sequences>
                        <Sequence EndType="EndDialogue" Name="seq_1">
                            <Elements><Response Role="role_mercenary_test"><Text StringName="goss_gossip_na_dobrodruzs_S1eB" Text="Adventure, that's my middle name." /></Response></Elements>
                        </Sequence>
                        <Sequence EndType="EndDialogue" Name="seq_2">
                            <Elements><Response Role="role_mercenary_test"><Text StringName="goss_gossip_na_reknu_ti_p_7CCR" Text="I've had a bout of bad luck lately." /></Response></Elements>
                        </Sequence>
                        <Sequence EndType="EndDialogue" Name="seq_3">
                            <Elements><Response Role="role_mercenary_test"><Text StringName="goss_gossip_na_doufam_ze__VhoC" Text="I hope we make it all the way today..." /></Response></Elements>
                        </Sequence>
                        <Sequence EndType="EndDialogue" Name="seq_4">
                            <Elements><Response Role="role_mercenary_test"><Text StringName="goss_gossip_na_ja_bych_pr_CGqO" Text="I think we should speed up..." /></Response></Elements>
                        </Sequence>
                        <Sequence EndType="EndDialogue" Name="seq_5">
                            <Elements><Response Role="role_mercenary_test"><Text StringName="goss_gossip_na_at_sou_lid_kS6T" Text="People are either good or bad. It makes no difference where they're from." /></Response></Elements>
                        </Sequence>
                        <Sequence EndType="EndDialogue" Name="seq_6">
                            <Elements><Response Role="role_mercenary_test"><Text StringName="goss_gossip_na_svata_prav_f8mO" Text="God's truth! When a fellah's enjoying himself, time flies like a greased pig." /></Response></Elements>
                        </Sequence>
                        <Sequence EndType="EndDialogue" Name="seq_7">
                            <Elements><Response Role="role_mercenary_test"><Text StringName="goss_gossip_na_cha_cha_to_2iay" Text="Not a chance, that's not for me... I always need something new." /></Response></Elements>
                        </Sequence>
                        <Sequence EndType="EndDialogue" Name="seq_8">
                            <Elements><Response Role="role_mercenary_test"><Text StringName="goss_gossip_na_ale_jo_na__H6sU" Text="Oh, no, not me. There are plenty of things that really piss me off." /></Response></Elements>
                        </Sequence>
                        <Sequence EndType="EndDialogue" Name="seq_9">
                            <Elements><Response Role="role_mercenary_test"><Text StringName="goss_gossip_hu_svet_prost_QAUB" Text="Life's not fair, and that's all there is to it..." /></Response></Elements>
                        </Sequence>
                        <Sequence EndType="EndDialogue" Name="seq_10">
                            <Elements><Response Role="role_mercenary_test"><Text StringName="goss_gossip_hu_doplnit01_BCrE" Text="You know what I'd like to know? How much silver has passed through my hands in my life?" /></Response></Elements>
                        </Sequence>
                        <Sequence EndType="EndDialogue" Name="seq_11">
                            <Elements><Response Role="role_mercenary_test"><Text StringName="goss_gossip_hu_kuklik_ze__QeU3" Text="A hill of silver... You see? And I'm still poor as a church mouse." /></Response></Elements>
                        </Sequence>
                        <Sequence EndType="EndDialogue" Name="seq_12">
                            <Elements><Response Role="role_mercenary_test"><Text StringName="goss_gossip_hu_no_tak_vid_Yw7x" Text="Stop going on about death and be glad for what you've got." /></Response></Elements>
                        </Sequence>
                        <Sequence EndType="EndDialogue" Name="seq_13">
                            <Elements><Response Role="role_mercenary_test"><Text StringName="goss_gossip_v__spis_prokl_ZWhe" Text="Not really, no... Lots of experiences, but not a lot of memories..." /></Response></Elements>
                        </Sequence>
                        <Sequence EndType="EndDialogue" Name="seq_14">
                            <Elements><Response Role="role_mercenary_test"><Text StringName="goss_gossip_v__bleh__ale__Xppj" Text="But you know what they say, an experience doesn't have to be good, as long as it's memorable." /></Response></Elements>
                        </Sequence>
                        <Sequence EndType="EndDialogue" Name="seq_15">
                            <Elements><Response Role="role_mercenary_test"><Text StringName="s_ce_raubritte_buh_vi_moz_FOOt" Text="Lord knows. Must be some higher goal. Those types are the worst." /></Response></Elements>
                        </Sequence>
                        <Sequence EndType="EndDialogue" Name="seq_16">
                            <Elements><Response Role="role_mercenary_test"><Text StringName="s_ce_raubritte_zaslouzil__k8UF" Text="He deserves to die in peace, with a woman in his arms. Not being hunted down like some vermin." /></Response></Elements>
                        </Sequence>
                        <Sequence EndType="EndDialogue" Name="seq_17">
                            <Elements><Response Role="role_mercenary_test"><Text StringName="s_ce_raubritte_takovyho_j_4y7G" Text="It would be dishonorable to kill someone like that, you know." /></Response></Elements>
                        </Sequence>
                        <Sequence EndType="EndDialogue" Name="seq_18">
                            <Elements><Response Role="role_mercenary_test"><Text StringName="dial_michal_umeni_pro_ume_PDka" Text="Art for its own sake! That is the true goal of real poetry!" /></Response></Elements>
                        </Sequence>
                    </Sequences>
                </Decision>
            </Dialogue>
        </Dialog>
    </Skald>
