<?xml version="1.0" encoding="us-ascii"?>
<BehaviorTrees>
    <!-- TEST NPC waypoint walk. Fired as its own interrupt (priority 200) so it owns
         the NPC outright - groundwork for a custom navmesh, where Lua decides the route
         and the BT only executes it.

         SMOOTH CORNERS: there is ONE long-running Move, not one per waypoint. Its
         destination variable is retargeted by the advance loop as he approaches each
         corner, and additionalParams carries destChangedThreshold, which is what lets a
         Move follow a changing destination without ending and restarting - the same
         mechanism follow.xml uses to track the moving player. A Move per waypoint made
         him decelerate into every corner, because reaching a destination completes the
         node. changeNPCState is false for the same reason follow.xml sets it false: the
         state change is part of what produced the full stop. -->
    <BehaviorTree name="testnpc_walk" is_function="0">
        <Variables>
            <Variable name="wpPos" type="vec3" values="" isPersistent="0" form="single" />
            <Variable name="routeDone" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="MoveParams_walk" type="additionalMoveParams" values="destChangedThreshold('150ms')" isPersistent="0" form="single" />
        </Variables>
        <Root OneTimeOnly="false" FailState="Recoverable" saveVersion="2">
            <Behavior canSkip="1">
                <EntityContext context="crime_preventDespawn" target="">
                  <FuseBox StatusPropagation="Child" OneCleanup="true" saveVersion="2">
                    <Child canSkip="1">
                        <Sequence>
                            <ExecuteLua code="mercenaries:TestNpcWalkStart(data, entity)" />

                            <SuppressFailure>
                                <Parallel successMode="Any" failureMode="Any">

                                    <!-- one continuous move, retargeted underneath it -->
                                    <Loop count="-1">
                                        <Move stopWithinDistance="0.500000" stopDistanceVariation="0.200000" rayCasteFlee="false" successDistance="0.000000" changeNPCState="false" fastForwardIncludesMove="false" destinationSpecification="$wpPos" destinationSpecification2="" destinationSpecification3="" speed="Run" additionalParams="$MoveParams_walk" pathFindingParams="" staminaPolicy="" pathInfo="" />
                                    </Loop>

                                    <!-- corner cutting: hand over the next waypoint before he arrives -->
                                    <Loop count="-1">
                                        <Sequence>
                                            <Wait duration="'150ms'" timeType="GameTime" doFail="false" variation="'50ms'" />
                                            <ExecuteLua code="mercenaries:TestNpcAdvanceWaypoint(data, entity)" />
                                            <IfCondition failOnCondition="false" condition="$routeDone">
                                                <Fail />
                                            </IfCondition>
                                        </Sequence>
                                    </Loop>

                                </Parallel>
                            </SuppressFailure>

                            <ExecuteLua code="mercenaries:TestNpcWalkEnd(entity, 'route finished')" />
                        </Sequence>
                    </Child>

                    <OnFail canSkip="1">
                        <ExecuteLua code="mercenaries:TestNpcWalkEnd(entity, 'evicted/failed')" />
                    </OnFail>
                  </FuseBox>
                </EntityContext>
            </Behavior>
        </Root>
    </BehaviorTree>
</BehaviorTrees>
