<?xml version="1.0" encoding="us-ascii"?>
<BehaviorTrees>
    <!-- Wall-aware approach. One continuous Move whose destination is rewritten by Lua
         each tick (NavGotoTick): straight at the target while the line is clear, or the
         next detour waypoint while a camp wall is in the way. Because the destination
         is retargeted rather than the node being re-issued (destChangedThreshold), the
         NPC corners smoothly and never stops between legs.

         The target may be an entity, so it is re-read every tick and the route is
         recomputed when it has moved far enough - that is what makes this usable during
         a fight. Ends when Lua reports arrival. See mercenaries_navmesh.lua. -->
    <BehaviorTree name="nav_goto" is_function="0">
        <Variables>
            <Variable name="wpPos" type="vec3" values="" isPersistent="0" form="single" />
            <Variable name="gotoDone" type="_bool" values="false" isPersistent="0" form="single" />
            <!-- Walk instead of run. Two Move nodes rather than a variable speed: speed is
                 an enum attribute, and follow.xml already picks between two Moves this way. -->
            <Variable name="navWalk" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="MoveParams_nav" type="additionalMoveParams" values="destChangedThreshold('150ms')" isPersistent="0" form="single" />
        </Variables>
        <Root OneTimeOnly="false" FailState="Recoverable" saveVersion="2">
            <Behavior canSkip="1">
                <EntityContext context="crime_preventDespawn" target="">
                  <FuseBox StatusPropagation="Child" OneCleanup="true" saveVersion="2">
                    <Child canSkip="1">
                        <Sequence>
                            <ExecuteLua code="mercenaries:NavGotoStart(data, entity)" />

                            <SuppressFailure>
                                <Parallel successMode="Any" failureMode="Any">

                                    <!-- These stop distances are the ones that work. A tighter
                                         radius was tried to stop the node deciding it had
                                         arrived (the loop then restarts it from a standstill,
                                         which reads as a halt) and the NPCs stopped moving
                                         altogether - a stop radius the engine cannot satisfy
                                         fails the Move, and failure takes the whole tree down.
                                         Waypoint smoothing is done in Lua instead, in
                                         NavAimAhead. -->
                                    <Loop count="-1">
                                        <ContinuousSwitch>
                                            <IfCondition failOnCondition="false" condition="$navWalk">
                                                <Move stopWithinDistance="0.500000" stopDistanceVariation="0.200000" rayCasteFlee="false" successDistance="0.000000" changeNPCState="false" fastForwardIncludesMove="false" destinationSpecification="$wpPos" destinationSpecification2="" destinationSpecification3="" speed="Walk" additionalParams="$MoveParams_nav" pathFindingParams="" staminaPolicy="" pathInfo="" />
                                            </IfCondition>
                                            <IfCondition failOnCondition="false" condition="true">
                                                <Move stopWithinDistance="0.500000" stopDistanceVariation="0.200000" rayCasteFlee="false" successDistance="0.000000" changeNPCState="false" fastForwardIncludesMove="false" destinationSpecification="$wpPos" destinationSpecification2="" destinationSpecification3="" speed="Run" additionalParams="$MoveParams_nav" pathFindingParams="" staminaPolicy="" pathInfo="" />
                                            </IfCondition>
                                        </ContinuousSwitch>
                                    </Loop>

                                    <Loop count="-1">
                                        <Sequence>
                                            <Wait duration="'150ms'" timeType="GameTime" doFail="false" variation="'60ms'" />
                                            <ExecuteLua code="mercenaries:NavGotoTick(data, entity)" />
                                            <IfCondition failOnCondition="false" condition="$gotoDone">
                                                <Fail />
                                            </IfCondition>
                                        </Sequence>
                                    </Loop>

                                </Parallel>
                            </SuppressFailure>

                            <ExecuteLua code="mercenaries:NavGotoEnd(entity, 'arrived')" />
                        </Sequence>
                    </Child>

                    <OnFail canSkip="1">
                        <ExecuteLua code="mercenaries:NavGotoEnd(entity, 'evicted/failed')" />
                    </OnFail>
                  </FuseBox>
                </EntityContext>
            </Behavior>
        </Root>
    </BehaviorTree>
</BehaviorTrees>
