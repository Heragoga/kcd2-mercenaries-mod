<?xml version="1.0" encoding="us-ascii"?>
<BehaviorTrees>
    <!-- The quartermaster's default behaviour: return to his post, sheathe,
         then stand there and occasionally play a standing eating animation.
         Fired as an interrupt by quartermaster_scheduler.xml (like
         mercenary_follow is fired by the merc scheduler), so it declares the
         same attackData In-parameter even though it never uses it.

         The "return to post + sheathe" step is what brings him home after a
         raid: the shared combat tree (mercenary_attack) drags him toward the
         enemy, so once the fight ends and this behaviour re-fires he walks
         back to his post (the vec3 the scheduler reads from
         mercenaries:GetQuartermasterPost), puts his weapon away, and turns to
         face the tent again. When he's already home the Move returns
         immediately, so in peacetime this is just stand + eat.

         eating_standing is a mode-2 standing activity (UseLocationObject=false,
         needs nothing in hand - it even spawns its own bun) and is confirmed
         working in-game; see docs/camp.md "Camp activities". The Move to a
         vec3 destination with changeNPCState="true" is the same proven
         move-to-a-point setup the camp guard patrol uses in mercenary_follow.xml. -->
    <BehaviorTree name="quartermaster_idle" is_function="0">
        <Variables>
            <Variable name="postPos" type="vec3" values="" isPersistent="0" form="single" />
            <Variable name="facePos" type="vec3" values="" isPersistent="0" form="single" />
            <Variable name="hasPost" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="hasFace" type="_bool" values="false" isPersistent="0" form="single" />
        </Variables>
        <Parameters>
            <Variable name="attackData" type="switch:interruptData:attack" values="" isPersistent="0" form="single" requirementType="In" />
        </Parameters>
        <Root OneTimeOnly="false" FailState="Recoverable" saveVersion="2">
            <Behavior canSkip="1">
                <Loop count="-1">
                    <Sequence>
                        <!-- Pull his post (stand spot + tent-centre face point) from Lua
                             into the vec3s, set component-wise the way
                             references/AI/quests/questbehaviors.xml does. -->
                        <ExecuteLua code="
                            data.hasPost = false
                            data.hasFace = false
                            pcall(function()
                                local p = mercenaries:GetQuartermasterPost()
                                if p then
                                    data.postPos.x = p.x
                                    data.postPos.y = p.y
                                    data.postPos.z = p.z
                                    data.hasPost = true
                                    if p.faceX then
                                        data.facePos.x = p.faceX
                                        data.facePos.y = p.faceY
                                        data.facePos.z = p.faceZ
                                        data.hasFace = true
                                    end
                                end
                            end)
                        " />

                        <!-- Walk back to the post (returns instantly if already there). -->
                        <IfCondition failOnCondition="false" condition="$hasPost">
                            <SuppressFailure>
                                <Move stopWithinDistance="0.600000" stopDistanceVariation="0.200000" rayCasteFlee="false" successDistance="0.000000" changeNPCState="true" fastForwardIncludesMove="false" destinationSpecification="$postPos" destinationSpecification2="" destinationSpecification3="" speed="Walk" additionalParams="" pathFindingParams="" staminaPolicy="" pathInfo="" />
                            </SuppressFailure>
                        </IfCondition>

                        <!-- Put the weapon away (he may still be holding it from a fight). -->
                        <SuppressFailure>
                            <ExecuteLua code="pcall(function() if entity.human and entity.human:IsWeaponDrawn() then entity.human:DrawWeapon(false) end end)" />
                        </SuppressFailure>

                        <!-- Face the tent again (Move leaves him facing the way he arrived). -->
                        <IfCondition failOnCondition="false" condition="$hasFace">
                            <SuppressFailure>
                                <Turn target="$facePos" align="false" />
                            </SuppressFailure>
                        </IfCondition>

                        <!-- Stand idle for a while (the engine's own idle animation
                             set takes over when no node is driving movement). -->
                        <Wait duration="'45s'" timeType="GameTime" doFail="false" variation="'25s'" />

                        <!-- Then have a bite to eat. SuppressFailure so a missing
                             fragment just skips rather than failing the whole tree. -->
                        <SuppressFailure>
                            <Sequence>
                                <UnstanceAction unstance="eating_standing" locationObject="" slaveObject="" />
                                <Wait duration="'12s'" timeType="GameTime" doFail="false" variation="'4s'" />
                            </Sequence>
                        </SuppressFailure>
                    </Sequence>
                </Loop>
            </Behavior>
        </Root>
    </BehaviorTree>
</BehaviorTrees>
