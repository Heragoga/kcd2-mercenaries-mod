<?xml version="1.0" encoding="us-ascii"?>
<BehaviorTrees>
    <BehaviorTree name="onUpdate" is_function="0">
        <Variables>
            <Variable name="distanceToPlayer"    type="_float"               values="0"                                 isPersistent="0" form="single" />
            <!-- De-target/sheathe distance. Set every cycle by MercLeashes so it scales with
                 squad size and stays in step with the combat modules' own leash; the flat 40m
                 this replaced was below the acquisition range, so a rear-rank archer was handed
                 a target and told to drop it on the same tick. Same fix as mercenary_scheduler.xml. -->
            <Variable name="deTargetDist"        type="_float"               values="40.0"                              isPersistent="0" form="single" />
            <Variable name="MoveParams_fleeing"  type="additionalMoveParams" values="destChangedThreshold('1s')"        isPersistent="0" form="single" />
            <Variable name="pathParams_fleeing"  type="pathFindingParams"    values="usePaths(true),useGeneratedNSO(true),useSmartObjects(true)" isPersistent="0" form="single" />
            <Variable name="distanceToFlee"      type="_float"               values="50.0"                              isPersistent="0" form="single" />
            <Variable name="keepMinimalDistance" type="_float"               values="10.0"                              isPersistent="0" form="single" />

            <Variable name="inCombat"            type="_bool"                values="false"                             isPersistent="0" form="single" />
            <Variable name="goFlee"              type="_bool"                values="false"                             isPersistent="0" form="single" />
            <Variable name="isIdle"              type="_bool"                values="false"                             isPersistent="0" form="single" />
            <Variable name="isFollowingActive"   type="_bool"                values="false"                             isPersistent="0" form="single" />
            <!-- Raised by FollowStalled (the teleporter's repeat-straggler counter) and consumed
                 by the re-arm loop below. Without it an archer flagged as stalled kept the latch
                 set forever - the melee scheduler has had this since the same bug was found there. -->
            <Variable name="followStuck"         type="_bool"                values="false"                             isPersistent="0" form="single" />
            <!-- No 'follow' interrupt while this is set. Mirrors mercenary_scheduler.xml -
                 see NoteFollowEviction in mercenaries_formation_handler.lua and
                 docs/formations.md, "The eviction race". This file is a parallel copy of
                 that scheduler and needs every fix made there. -->
            <Variable name="refireBlock"         type="_bool"                values="false"                             isPersistent="0" form="single" />
            <!-- Which follow-family behaviour is running: camp_actor (true) or follow (false). -->
            <Variable name="firedCampActor"     type="_bool"                values="false"                             isPersistent="0" form="single" />
            <!-- Mirror of _G.PlayerMounted; keeps the self-heal from restarting a
                 mounted archer's follow tree (same fix as mercenary_scheduler.xml). -->
            <Variable name="playerMounted"       type="_bool"                values="false"                             isPersistent="0" form="single" />

            <!-- campActive/campFurniture/campStanceCode: only used by the disabled camp sit/sleep block below. -->
            <Variable name="campActive"          type="_bool"                values="false"                             isPersistent="0" form="single" />
            <Variable name="campFurniture"       type="_wuid"                values=""                                  isPersistent="0" form="single" />
            <Variable name="campStanceCode"      type="_int"                 values="0"                                 isPersistent="0" form="single" />

            <!-- isCampActor: this archer has any camp role (guard/sitter/sleeper). Camp
                 actors are excluded from the idle branch and run camp_actor.xml; the rest run follow.xml. patrol* here are unused leftovers. -->
            <Variable name="isCampActor"         type="_bool"                values="false"                             isPersistent="0" form="single" />
            <Variable name="campPoseHold"       type="_bool"                values="false"                             isPersistent="0" form="single" />
            <Variable name="patrolActive"        type="_bool"                values="false"                             isPersistent="0" form="single" />
            <Variable name="patrolWaypoint"      type="_wuid"                values=""                                  isPersistent="0" form="single" />
            <Variable name="patrolLongPause"     type="_bool"                values="false"                             isPersistent="0" form="single" />

            <Variable name="isFriendly"          type="_bool"                values="true"                              isPersistent="0" form="single" />
            <Variable name="playerTarget"        type="_wuid"                values=""                                  isPersistent="0" form="single" />
            <Variable name="currentTarget"       type="_wuid"                values=""                                  isPersistent="0" form="single" />
            <Variable name="mercTarget"          type="_wuid"                values=""                                  isPersistent="0" form="single" />
            <Variable name="playerWUID"          type="_wuid"                values=""                                  isPersistent="0" form="single" />
            <Variable name="playerCombatTarget"  type="_wuid"                values=""                                  isPersistent="0" form="single" />
            <!-- Gate for the GetTarget on the PLAYER below. Written by MercLeashes off the
                 combat scan's own threat flag - see the note there: the node cannot resolve
                 the player as an NPC host, so unguarded it is a failed engine lookup on every
                 poll of every merc. -->
            <Variable name="playerFighting"      type="_bool"                values="false"                             isPersistent="0" form="single" />
            <Variable name="foundTarget"         type="_bool"                values="false"                             isPersistent="0" form="single" />
            <Variable name="idleTicks"           type="_int"                 values="0"                                 isPersistent="0" form="single" />
            <!-- Behaviour LOD: cheapMode says the squad has nothing to find (set by
                 MercCheapMode); cheapSkip counts polls skipped so a FULL pass still runs
                 every cheapEvery+1 polls. See mercenaries_ai_modules.lua. -->
            <Variable name="cheapMode"           type="_bool"                values="false"                             isPersistent="0" form="single" />
            <Variable name="cheapSkip"           type="_int"                 values="0"                                 isPersistent="0" form="single" />
            <Variable name="cheapEvery"          type="_int"                 values="3"                                 isPersistent="0" form="single" />
            <Variable name="doAcquire"           type="_bool"                values="true"                              isPersistent="0" form="single" />

            <Variable name="stanceMode"          type="_int"                 values="0"                                 isPersistent="0" form="single" />
            <Variable name="enemiesArray"        type="_wuid"                values=""                                  isPersistent="0" form="array"  />
            <Variable name="candidate"           type="_wuid"                values=""                                  isPersistent="0" form="single" />
            <Variable name="candidateTarget"     type="_wuid"                values=""                                  isPersistent="0" form="single" />

            <Variable name="dialogRequest"       type="dialogModule:onDialogRequest" values=""                          isPersistent="0" form="single" />

            <Variable name="attackData"          type="switch:interruptData:attack" values=""                           isPersistent="0" form="single" />
            <Variable name="crimeInformation"    type="information"          values=""                                  isPersistent="0" form="single" />
            <Variable name="mrkev"               type="_wuid"                values=""                                  isPersistent="0" form="single" />

            <Variable name="mercIsDead"          type="_bool"                values="false"                             isPersistent="0" form="single" />
        <!-- wbLocked: forming up for a walled battle - do not start fights. -->
        <Variable name="wbLocked" type="_bool" values="false" isPersistent="0" form="single" />
        <Variable name="wbStageGo" type="_bool" values="false" isPersistent="0" form="single" />
        <Variable name="wbMrkev" type="_wuid" values="" isPersistent="0" form="single" />
        <!-- Hold/escort order destination for this archer. See mercenaries_hold.lua. -->
        <Variable name="navOrderGo" type="_bool" values="false" isPersistent="0" form="single" />
        <Variable name="navOrderMrkev" type="_wuid" values="" isPersistent="0" form="single" />
        </Variables>
        <Root OneTimeOnly="false" FailState="Recoverable" saveVersion="2">
            <Behavior canSkip="1">
                <SuppressFailure>
                    <Parallel successMode="Any" failureMode="Any">

                        <!-- Main decision loop: read stance, acquire target, fire the right combat interrupt -->
                        <Loop count="-1">
                            <Sequence>

                                <!-- 600ms: reaction time to a new threat; halved from 300ms with the merc
                                     scheduler, see the note there. idleTicks thresholds below
                                     are scaled to it (55 ticks ~ 16s). -->
                                <Wait duration="'600ms'" timeType="GameTime" doFail="false" variation="'240ms'" />

                                <AtomicDecorator>
                                    <Sequence>
                                        <ExecuteLua code="if _G.MercenariesDismissed then data.goFlee = true end" />
                                        <ExecuteLua code="data.isIdle = mercenaries:MercIsIdle(entity)" />
                                        <ExecuteLua code="mercenaries:FollowGate(data, entity.this.id)" />
                                        <ExecuteLua code="data.isCampActor = mercenaries:IsCampActor(entity.this.id)" />
                                        <ExecuteLua code="mercenaries:CampPoseHold(data, entity.this.id)" />
                                        <ExecuteLua code="data.stanceMode = mercenaries:GetArcherStanceCode()" />
                                        <ExecuteLua code="mercenaries:MercLeashes(data)" />
                                        <!-- BEHAVIOUR LOD. cheapMode means the squad-wide caches say there is
                                             nothing to acquire; cheapSkip then lets a FULL pass through every
                                             cheapEvery+1 polls so nothing the caches could miss is missed for
                                             long. Not cheap -> doAcquire is true every poll, exactly as before. -->
                                        <ExecuteLua code="mercenaries:MercCheapMode(data, entity.this.id)" />
                                        <IfElseCondition failOnCondition="false" condition="$cheapMode &amp; $cheapSkip &lt; $cheapEvery" saveVersion="2">
                                            <Then canSkip="1">
                                                <Expression expressions="$cheapSkip = $cheapSkip + 1 &#10; $doAcquire = false" />
                                            </Then>
                                            <Else canSkip="1">
                                                <Expression expressions="$cheapSkip = 0 &#10; $doAcquire = true" />
                                            </Else>
                                        </IfElseCondition>

                                        <Expression expressions="$playerTarget = $__null &#10; $mercTarget = $__null &#10; $playerWUID = $__player &#10; $foundTarget = false &#10; $isFriendly = true" />

                                        <!-- Target acquisition is always on, same rule as the melee mercs.
                                             The archer stance only picks the combat behaviour below -
                                             except "hold" (2), which means don't acquire at all.
                                             See docs/combat-target-selection.md. -->
                                        <SuppressFailure>
                                            <IfCondition failOnCondition="false" condition="~$inCombat &amp; $stanceMode ~= 2 &amp; $doAcquire">
                                                <Sequence>
                                                    <Expression expressions="$playerCombatTarget = $__null" />
                                                    <SuppressFailure>
                                                        <IfCondition failOnCondition="false" condition="$playerFighting">
                                                            <GetTarget ReferenceNPC="$playerWUID" TargetVarOut="$playerCombatTarget" />
                                                        </IfCondition>
                                                    </SuppressFailure>

                                                    <!-- Pass 1: whoever has locked onto the player or onto this archer. -->
                                                    <ExecuteLua code="mercenaries:ScanForEnemies(data, entity.this.id)" />

                                                    <For startIndex="0" endIndex="-1" step="1" array="$enemiesArray" iterator="" value="$candidate" break="$foundTarget">
                                                        <Sequence>
                                                            <Expression expressions="$candidateTarget = $__null" />
                                                            <SuppressFailure>
                                                                <GetTarget ReferenceNPC="$candidate" TargetVarOut="$candidateTarget" />
                                                            </SuppressFailure>

                                                            <ExecuteLua code="mercenaries:EvaluateCombatTarget(data, entity.this.id)" />
                                                        </Sequence>
                                                    </For>

                                                    <!-- Pass 2: the player's own target, else the nearest armed hostile. -->
                                                    <ExecuteLua code="mercenaries:PickCombatTarget(data, entity.this.id)" />
                                                </Sequence>
                                            </IfCondition>
                                        </SuppressFailure>

                                        <!-- This is the one engine call that must NOT be skipped on the squad-wide
                                             caches alone: it is how the mod learns a man is being attacked by
                                             something the caches never saw - a town guard turning on him with
                                             nothing yet hostile in CachedEnemies. So it rides the SAME cheapSkip
                                             counter as the acquisition block rather than a gate of its own: on a
                                             cheap poll it is skipped, on the full pass every cheapEvery+1 polls it
                                             runs. Worst case he learns he is being hit ~2.4s late instead of never,
                                             and any hit that lands sets inCombat, which clears cheapMode outright. -->
                                        <IfCondition failOnCondition="false" condition="$doAcquire">
                                            <SuppressFailure><GetTarget ReferenceNPC="$this.id" TargetVarOut="$mercTarget" /></SuppressFailure>
                                        </IfCondition>

                                        <!-- idleTicks = "how long have I had nothing to do". It must NOT tick
                                             while in combat: acquisition is gated on ~inCombat, so playerTarget
                                             is null every tick of a fight, and a fight lasting past the
                                             threshold below would sheathe the archer's bow mid-fight. -->
                                        <IfElseCondition failOnCondition="false" condition="$playerTarget == $__null &amp; ~$inCombat" saveVersion="2">
                                            <Then canSkip="1"><Expression expressions="$idleTicks = $idleTicks + 1" /></Then>
                                            <Else canSkip="1"><Expression expressions="$idleTicks = 0" /></Else>
                                        </IfElseCondition>
                                        <IfCondition failOnCondition="false" condition="$idleTicks &gt; 33">
                                            <Expression expressions="$idleTicks = 33" />
                                        </IfCondition>
                                    </Sequence>
                                </AtomicDecorator>

                                <IfCondition failOnCondition="false" condition="~$goFlee">
                                    <EntityContextCheck context="crime_interruptAttack" target="$this.id" saveVersion="2">
                                        <Then canSkip="1">
                                            <Sequence>
                                                <IfCondition failOnCondition="false" condition="$distanceToPlayer &gt; $deTargetDist | $idleTicks &gt; 27 | $stanceMode == 2">
                                                    <Sequence>
                                                        <ExecuteLua code="pcall(function() entity.soul:SetTarget(nil) end); pcall(function() entity.human:DrawWeapon(false) end); pcall(function() mercenaries:MercDropClaim(entity.this.id) end)" />
                                                        <Expression expressions="$currentTarget = $__null" />
                                                    </Sequence>
                                                </IfCondition>
                                                <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'200ms'" />
                                            </Sequence>
                                        </Then>
                                        <Else canSkip="1">
                                            <Sequence>
                                                <SuppressFailure>
                                                    <ProcessMessage Atomic="false" timeout="'0ms'" timeType="GameTime" variable="$dialogRequest" senderInfo="" inbox="'dialogMailbox'" condition="" answerVar="">
                                                        <Function_switch_handleDialog dialogRequest="$dialogRequest" nodeLabel="68945294" />
                                                    </ProcessMessage>
                                                </SuppressFailure>
                                                <IfElseCondition failOnCondition="false" condition="$playerTarget ~= $__null &amp; ~$isFriendly &amp; $playerTarget ~= $this.id &amp; ($playerTarget ~= $currentTarget | ~$inCombat)" saveVersion="2">
                                                    <Then canSkip="1">
                                                        <Sequence>
                                                            <Expression expressions="$currentTarget = $playerTarget" />
                                                            <Function_crime_getMrkev mrkev="$mrkev" nodeLabel="1235" />
                                                            <CreateInformationWrapper Label="'assault'" PerceivedWuid="$this.id" PositionType="positionWuid" PositionVec3="" PositionWuid="$playerTarget" Information="$crimeInformation" />
                                                            <LockDynamicInformationValues Information="$crimeInformation">
                                                                <SetDynamicInformationValue Information="$crimeInformation" Tag="'stimulusKind'" Variable="$enum:crime_stimulusKind.combat" Type="" Value="" />
                                                            </LockDynamicInformationValues>
                                                            <SuppressFailure><Function_crime_limits_reserveReactionLink ffCrimeIcon="false" information="$crimeInformation" priority="160" reactionKind="$enum:crime_reactionKind.attack" nodeLabel="898991" /></SuppressFailure>
                                                            <Expression expressions="$attackData.target = $playerTarget &#10; $attackData.information = $crimeInformation &#10; $attackData.stimulusKind = $enum:crime_stimulusKind.combat &#10; $attackData.previousReaction = $enum:crime_reactionKind.unknown &#10; $attackData.initiatedBy = $enum:switch_interruptInitiator.switch &#10; $attackData.defenceMode = false &#10; $attackData.relationOverride = true &#10; $attackData.source = $enum:crime_source.direct &#10; $attackData.freshlyAttributedCrime = false &#10; $attackData.criminalFreshness = $enum:crime_criminalFreshness.unknown &#10; $attackData.escalatedFromFailedSurrender = false" />

                                                            <!-- Stance picks the combat behaviour: 0 skirmish, 1 melee (2 hold disengages above). -->
                                                            <IfCondition failOnCondition="false" condition="$stanceMode == 1">
                                                                <IfCondition failOnCondition="false" condition="~$wbLocked &amp; ~$campPoseHold"><!-- wbLockedWrapped; campPoseHold = he is still standing up out of a camp pose -->
                                                                    <AddInterrupt_attack attackData="$attackData" Target="$this.id" Host="$mrkev" Behavior="'combat_melee'" Priority="160" IgnorePriorityOnPreviousInterrupt="true" urgency="Fast" Aliveness="Alive" Privileged="false" FastForward="false" />
                                                                </IfCondition>
                                                            </IfCondition>
                                                            <IfCondition failOnCondition="false" condition="$stanceMode == 0">
                                                                <IfCondition failOnCondition="false" condition="~$wbLocked &amp; ~$campPoseHold"><!-- wbLockedWrapped; campPoseHold = he is still standing up out of a camp pose -->
                                                                    <AddInterrupt_attack attackData="$attackData" Target="$this.id" Host="$mrkev" Behavior="'combat_archer_dynamic'" Priority="160" IgnorePriorityOnPreviousInterrupt="true" urgency="Fast" Aliveness="Alive" Privileged="false" FastForward="false" />
                                                                </IfCondition>
                                                            </IfCondition>
                                                            <!-- Optimistic: the tracker loop below needs a tick to see the
                                                                 crime context, and until it does this branch would re-fire
                                                                 and IgnorePriorityOnPreviousInterrupt would replace the
                                                                 combat we just started (its OnFail sheathes + drops the
                                                                 target, leaving the archer stood there disarmed). -->
                                                            <IfCondition failOnCondition="false" condition="~$campPoseHold"><Expression expressions="$inCombat = true" /></IfCondition>
                                                        </Sequence>
                                                    </Then>
                                                    <Else canSkip="1">
                                                        <AtomicDecorator>
                                                            <IfCondition failOnCondition="false" condition="$idleTicks &gt; 27">
                                                                <Sequence>
                                                                    <Expression expressions="$currentTarget = $__null" />
                                                                    <ExecuteLua code="
                                                                        pcall(function()
                                                                        if entity.human:IsWeaponDrawn() then
                                                                            entity.human:DrawWeapon(false)
                                                                        end
                                                                        end)
                                                                    " />
                                                                </Sequence>
                                                            </IfCondition>
                                                        </AtomicDecorator>
                                                    </Else>
                                                </IfElseCondition>
                                            </Sequence>
                                        </Else>
                                    </EntityContextCheck>
                                </IfCondition>
                            </Sequence>
                        </Loop>

                        <!-- Combat state tracker. Matches the acquisition loop: inCombat gates it,
                             so a stale value costs reaction time. -->
                        <Loop count="-1">
                            <Sequence>
                                <EntityContextCheck context="crime_interruptAttack" target="$this.id" saveVersion="2">
                                    <Then canSkip="1">
                                        <Expression expressions="$inCombat = true" />
                                    </Then>
                                    <Else canSkip="1">
                                        <Expression expressions="$inCombat = false" />
                                    </Else>
                                </EntityContextCheck>
                                <Wait duration="'600ms'" timeType="GameTime" doFail="false" variation="'240ms'" />
                            </Sequence>
                        </Loop>

                        <!-- Distance to player tracker -->
                        <Loop count="-1">
                            <Sequence>
                                <ExecuteLua code="
                                    pcall(function()
                                        local isDead = false
                                        if not entity.actor then isDead = true end
                                        if entity.actor and entity.actor.IsDead and entity.actor:IsDead() then isDead = true end
                                        local ok2, health = pcall(function() return entity.soul:GetState('health') end)
                                        if not ok2 or health == nil or health &lt;= 0 or entity.actor:IsUnconscious() then isDead = true end

                                        if isDead then
                                            data.distanceToPlayer = 0.0
                                            return
                                        end

                                        local pp = player and player:GetPos()
                                        local mp = entity:GetPos()
                                        if pp and mp then
                                            local dx,dy,dz = pp.x-mp.x, pp.y-mp.y, pp.z-mp.z
                                            data.distanceToPlayer = math.sqrt(dx*dx+dy*dy+dz*dz)
                                        end
                                    end)
                                " />
                                <Wait duration="'1s'" timeType="GameTime" doFail="false" variation="'400ms'" />
                            </Sequence>
                        </Loop>

                        <!-- Movement / following state machine -->
                        <Loop count="-1">
                            <ContinuousSwitch>

                                <IfCondition failOnCondition="false" condition="$goFlee">
                                    <Sequence>
                                        <Expression expressions="$isFollowingActive = false" />
                                        <Move stopWithinDistance="5.0" stopDistanceVariation="2.5" rayCasteFlee="false" successDistance="0.0" changeNPCState="false" fastForwardIncludesMove="false" destinationSpecification="$__player" destinationSpecification2="$distanceToFlee" destinationSpecification3="$keepMinimalDistance" speed="Sprint" additionalParams="$MoveParams_fleeing" pathFindingParams="$pathParams_fleeing" staminaPolicy="" pathInfo="" />
                                        <Despawn DeSpawnedEntity="$this.id" />
                                    </Sequence>
                                </IfCondition>

                                <!-- Idle / stand-still branch. Camp actors are excluded (they fall through
                                     to follow, which runs their camp role); plain idle archers stand here. -->
                                <IfCondition failOnCondition="false" condition="$isIdle &amp; ~$isCampActor">
                                    <EntityContext context="crime_suppressBehavioralReaction" target="$this.id">
                                        <Sequence>
                                            <IfCondition failOnCondition="false" condition="$isFollowingActive">
                                                <Sequence>
                                                    <Expression expressions="$isFollowingActive = false &#10; $refireBlock = true" />
                                                    <ExecuteLua code="mercenaries:NoteFollowEviction(entity.this.id)" />
                                                    <AddInterrupt_teleport destination="$this.id" Target="$this.id" Host="$__land" Behavior="'teleport'" Priority="160" IgnorePriorityOnPreviousInterrupt="true" urgency="Instant" Aliveness="Alive" Privileged="false" FastForward="true" />
                                                </Sequence>
                                            </IfCondition>

                                            <!-- Just stand. Camp sit/sleep and guard patrol live in
                                                 camp_actor.xml now (this branch only plain-idles). -->
                                            <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'200ms'" />
                                        </Sequence>
                                    </EntityContext>
                                </IfCondition>

                                <IfCondition failOnCondition="false" condition="$inCombat | $mercTarget ~= $__null">
                                    <EntityContext context="crime_suppressBehavioralReaction" target="$this.id">
                                        <Sequence>
                                            <Expression expressions="$isFollowingActive = false" />
                                            <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'200ms'" />
                                        </Sequence>
                                    </EntityContext>
                                </IfCondition>

                                <IfCondition failOnCondition="false" condition="true">
                                    <EntityContext context="crime_suppressBehavioralReaction" target="$this.id">
                                        <Sequence>
                                            <!-- Camp role changed while a follow-family behaviour runs: force a re-fire of the right one. -->
                                            <IfCondition failOnCondition="false" condition="$isFollowingActive &amp; (($isCampActor &amp; ~$firedCampActor) | (~$isCampActor &amp; $firedCampActor))">
                                                <Expression expressions="$isFollowingActive = false" />
                                            </IfCondition>
                                            <!-- ~$refireBlock: never fire follow while an eviction of this
                                                 archer's tree is still in flight, or the eviction lands on the
                                                 behaviour we just started and the latch pins him for good. -->
                                            <IfCondition failOnCondition="false" condition="~$isFollowingActive &amp; ~$refireBlock">
                                                <Sequence>
                                                    <SuppressFailure>
                                                        <Function_crime_getMrkev mrkev="$mrkev" nodeLabel="1235" />
                                                        <CreateInformationWrapper Label="'assault'" PerceivedWuid="$this.id" PositionType="positionWuid" PositionVec3="" PositionWuid="$__player" Information="$crimeInformation" />
                                                        <LockDynamicInformationValues Information="$crimeInformation">
                                                            <SetDynamicInformationValue Information="$crimeInformation" Tag="'stimulusKind'" Variable="$enum:crime_stimulusKind.combat" Type="" Value="" />
                                                        </LockDynamicInformationValues>
                                                        <Function_crime_limits_reserveReactionLink ffCrimeIcon="false" information="$crimeInformation" priority="160" reactionKind="$enum:crime_reactionKind.attack" nodeLabel="898991" />
                                                    </SuppressFailure>

                                                    <Expression expressions="$attackData.target = $__player &#10; $attackData.information = $crimeInformation &#10; $attackData.stimulusKind = $enum:crime_stimulusKind.combat &#10; $attackData.previousReaction = $enum:crime_reactionKind.unknown &#10; $attackData.initiatedBy = $enum:switch_interruptInitiator.switch &#10; $attackData.defenceMode = false &#10; $attackData.relationOverride = true &#10; $attackData.source = $enum:crime_source.direct &#10; $attackData.freshlyAttributedCrime = false &#10; $attackData.criminalFreshness = $enum:crime_criminalFreshness.unknown &#10; $attackData.escalatedFromFailedSurrender = false" />
                                                    <!-- Camp actors run their camp life (camp_actor); everyone else follows in formation. -->
                                                    <IfElseCondition failOnCondition="false" condition="$isCampActor" saveVersion="2">
                                                        <Then canSkip="1">
                                                            <Sequence>
                                                                <IfCondition failOnCondition="false" condition="~$wbLocked"><!-- wbLockedWrapped -->
                                                                    <AddInterrupt_attack attackData="$attackData" Target="$this.id" Host="$mrkev" Behavior="'camp_actor'" Priority="160" IgnorePriorityOnPreviousInterrupt="true" urgency="Fast" Aliveness="Alive" Privileged="false" FastForward="false" />
                                                                </IfCondition>
                                                                <Expression expressions="$firedCampActor = true" />
                                                            </Sequence>
                                                        </Then>
                                                        <Else canSkip="1">
                                                            <Sequence>
                                                                <IfCondition failOnCondition="false" condition="~$wbLocked"><!-- wbLockedWrapped -->
                                                                    <AddInterrupt_attack attackData="$attackData" Target="$this.id" Host="$mrkev" Behavior="'follow'" Priority="160" IgnorePriorityOnPreviousInterrupt="true" urgency="Fast" Aliveness="Alive" Privileged="false" FastForward="false" />
                                                                </IfCondition>
                                                                <Expression expressions="$firedCampActor = false" />
                                                            </Sequence>
                                                        </Else>
                                                    </IfElseCondition>
                                                    <Expression expressions="$isFollowingActive = true" />

                                                </Sequence>
                                            </IfCondition>
                                            <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'200ms'" />
                                        </Sequence>
                                    </EntityContext>
                                </IfCondition>
                            </ContinuousSwitch>
                        </Loop>

                        <!-- Direct re-arm, same as mercenary_scheduler.xml: the follow behaviour told
                             us it ended. Consume FIRST so it runs once per raised flag; re-firing
                             'follow' over a running 'follow' does not displace it, so fire 'teleport'
                             (destination = self, nothing visibly moves) purely to evict it. -->
                        <Loop count="-1">
                            <Sequence>
                                <ExecuteLua code="mercenaries:PollFollowRefire(data, entity.this.id)" />
                                <IfCondition failOnCondition="false" condition="$followStuck &amp; ~$isIdle &amp; ~$inCombat &amp; ~$goFlee">
                                    <Sequence>
                                        <ExecuteLua code="mercenaries:ConsumeFollowRefire(entity.this.id); mercenaries:NoteFollowEviction(entity.this.id)" />
                                        <Expression expressions="$isFollowingActive = false &#10; $refireBlock = true" />
                                        <AddInterrupt_teleport destination="$this.id" Target="$this.id" Host="$__land" Behavior="'teleport'" Priority="160" IgnorePriorityOnPreviousInterrupt="true" urgency="Instant" Aliveness="Alive" Privileged="false" FastForward="true" />
                                    </Sequence>
                                </IfCondition>
                                <Wait duration="'1s'" timeType="GameTime" doFail="false" variation="'400ms'" />
                            </Sequence>
                        </Loop>

                        <!-- Self-heal for a rare stuck-follower bug (same as mercenary_scheduler.xml):
                             a follower marked following but idle and far forces a retry by clearing
                             $isFollowingActive. 35m, not 15: archers form up at the BACK of the
                             formation, so a rear-rank archer is legitimately that far out, and each
                             needless restart drops him out of FormationFollower - his only
                             locomotion - so he coasts further back and re-trips it 8s later. -->
                        <Loop count="-1">
                            <Sequence>
                                <Wait duration="'8s'" timeType="GameTime" doFail="false" variation="'2s'" />
                                <!-- Skip the retry while mounted - restarting the follow tree throws
                                     the archer off the horse mid-ride (see mercenary_scheduler.xml). -->
                                <ExecuteLua code="data.playerMounted = _G.PlayerMounted or false" />
                                <IfCondition failOnCondition="false" condition="$isFollowingActive &amp; ~$isIdle &amp; ~$inCombat &amp; ~$goFlee &amp; ~$playerMounted &amp; $mercTarget == $__null &amp; $distanceToPlayer &gt; 35.0">
                                    <Expression expressions="$isFollowingActive = false" />
                                </IfCondition>
                            </Sequence>
                        </Loop>

                        <!-- Corpse cleanup -->
                        <Loop count="-1">
                            <Sequence>
                                <Wait duration="'60s'" timeType="GameTime" doFail="false" variation="'10s'" />
                                <ExecuteLua code="
                                    local ok, err = pcall(function()

                                        if not entity.actor then return end
                                        local isDead = false

                                        if entity.actor.IsDead and entity.actor:IsDead() then isDead = true end
                                        if entity.actor:IsUnconscious() then
                                            local ok2, health = pcall(function() return entity.soul:GetState('health') end)
                                            if not ok2 or health == nil or health &lt;= 0 then isDead = true end
                                        end

                                        data.mercIsDead = isDead
                                    end)
                                    if not ok then System.LogAlways('[Archer] Death check error: ' .. tostring(err)) end
                                " />
                                <IfCondition failOnCondition="false" condition="$mercIsDead">
                                    <Sequence>
                                        <Wait duration="'120s'" timeType="GameTime" doFail="false" variation="'10s'" />
                                        <Despawn DeSpawnedEntity="$this.id" />
                                    </Sequence>
                                </IfCondition>
                            </Sequence>
                        </Loop>

                        <!-- Staged walled battle: walk to the muster point at the gap. Only a tree can
                             fire the interrupt that actually moves him, and this fires only while he
                             has a staging assignment, so it cannot compete with anything else. -->
                        <Loop count="-1">
                            <Sequence>
                                <ExecuteLua code="mercenaries:WBCombatPoll(data, entity); mercenaries:WBStagePoll(data, entity)" />
                                <IfCondition failOnCondition="false" condition="$wbStageGo">
                                    <Sequence>
                                        <SuppressFailure>
                                            <Function_crime_getMrkev mrkev="$wbMrkev" nodeLabel="1243" />
                                        </SuppressFailure>
                                        <AddInterrupt Target="$this.id" Host="$wbMrkev" Behavior="'nav_goto'" Priority="200" IgnorePriorityOnPreviousInterrupt="true" urgency="Fast" Aliveness="Alive" Privileged="false" FastForward="false" />
                                    </Sequence>
                                </IfCondition>
                                <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'200ms'" />
                            </Sequence>
                        </Loop>

                        <!-- Hold ground / escort: walk to the station the order assigned this
                             archer (the flank, a little back). Gated on ~inCombat so shooting
                             always wins, and he re-takes his mark once the fight is over. -->
                        <Loop count="-1">
                            <Sequence>
                                <ExecuteLua code="mercenaries:NavOrderPoll(data, entity)" />
                                <IfCondition failOnCondition="false" condition="$navOrderGo &amp; ~$inCombat &amp; ~$wbStageGo &amp; ~$wbLocked">
                                    <Sequence>
                                        <SuppressFailure>
                                            <Function_crime_getMrkev mrkev="$navOrderMrkev" nodeLabel="1245" />
                                        </SuppressFailure>
                                        <AddInterrupt Target="$this.id" Host="$navOrderMrkev" Behavior="'nav_goto'" Priority="150" IgnorePriorityOnPreviousInterrupt="true" urgency="Fast" Aliveness="Alive" Privileged="false" FastForward="false" />
                                    </Sequence>
                                </IfCondition>
                                <Wait duration="'700ms'" timeType="GameTime" doFail="false" variation="'250ms'" />
                            </Sequence>
                        </Loop>

                    </Parallel>
                </SuppressFailure>
            </Behavior>
        </Root>
    </BehaviorTree>
</BehaviorTrees>
