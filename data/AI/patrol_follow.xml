<?xml version="1.0" encoding="us-ascii"?>
<BehaviorTrees>
    <!-- Patrol follower: a CrimeFollower chain, two abreast.

         This is an INTERRUPT BEHAVIOUR, not an arm of patrol_scheduler.xml, because the
         engine refuses to run follower nodes anywhere else:

           [FollowerBase]: This node can run only in SchedulerSubbrain

         FormationFollower and CrimeFollower share that base, so both are rejected when the
         tree is the switching subbrain itself, and the man simply stands still with no
         other symptom. follow.xml gets away with them because it is fired as a behaviour
         too. Schedulers fire; behaviours act.

         SHAPE is the follow CHAIN the mod used before (AssignNpcFormation): the first two
         men follow the leader, and everyone after follows the man two places ahead, so
         each file trails the man in front of him and the body walks as a double column.
         MakeFormation is not involved - an authored formation holds a rigid shape, and a
         rigid shape cannot absorb a leader who is moving faster than his men.

         SPEED: everyone walks - the decorator and RelativeSpeedLimit here, and the Move's
         speed in patrol_scheduler.xml. These MUST be kept in step: a leader faster than his
         followers' ceiling simply runs away from them.

         Role is a node ATTRIBUTE and cannot be a variable, so the two files are two nodes
         behind a switch - the same reason follow.xml spells out every FormationMode. -->
    <BehaviorTree name="patrol_follow" is_function="0">
        <Variables>
            <Variable name="followTarget"   type="_wuid" values="" isPersistent="0" form="single" />
            <Variable name="crimeRole"      type="_int"  values="0" isPersistent="0" form="single" />
            <Variable name="stillFollowing" type="_bool" values="true" isPersistent="0" form="single" />
            <Variable name="chainChanged"   type="_bool" values="false" isPersistent="0" form="single" />
        </Variables>
        <Root OneTimeOnly="false" FailState="Recoverable" saveVersion="2">
            <Behavior canSkip="1">
                <EntityContext context="crime_preventDespawn" target="">
                  <FuseBox StatusPropagation="Child" OneCleanup="true" saveVersion="2">
                    <Child canSkip="1">
                        <Loop count="-1">
                            <Sequence>
                                <ExecuteLua code="mercenaries:PatrolFollowRole(data, entity)" />
                                <IfCondition failOnCondition="false" condition="~$stillFollowing | $followTarget == $__null">
                                    <Fail />
                                </IfCondition>

                                <!-- Ends on a CHANGE, not on a timer.
                                     CrimeFollower never returns on its own, so something has to
                                     end it or the chain could never be re-read when a man ahead
                                     dies. A fixed time-box did that - and restarting CrimeFollower
                                     makes the follower dash to re-acquire his station, so a 1.5s
                                     box produced a catch-up sprint every 1.5s forever. The watcher
                                     arm below only finishes when PatrolChainPoll says the man he
                                     follows has actually changed, so in steady state the node runs
                                     uninterrupted and he simply walks. -->
                                <Parallel successMode="Any" failureMode="Any">
                                    <SuppressFailure>
                                        <MoveParamsDecorator speed="Walk" pathFindingParams="" doorClosingPolicy="LeaveOpened">
                                            <ContinuousSwitch>
                                                <IfCondition failOnCondition="false" condition="$crimeRole == 1">
                                                    <CrimeFollower Target="$followTarget" Mode="Default" Role="Assist" RelativeSpeedLimit="Walk" DisableGhosting="false" BlockWay="false"/>
                                                </IfCondition>
                                                <IfCondition failOnCondition="false" condition="true">
                                                    <CrimeFollower Target="$followTarget" Mode="Default" Role="Main" RelativeSpeedLimit="Walk" DisableGhosting="false" BlockWay="false"/>
                                                </IfCondition>
                                            </ContinuousSwitch>
                                        </MoveParamsDecorator>
                                    </SuppressFailure>
                                    <Loop count="-1">
                                        <Sequence>
                                            <Wait duration="'1s'" timeType="GameTime" doFail="false" variation="'400ms'" />
                                            <ExecuteLua code="mercenaries:PatrolChainPoll(data, entity)" />
                                            <IfCondition failOnCondition="false" condition="$chainChanged | ~$stillFollowing">
                                                <Fail />
                                            </IfCondition>
                                        </Sequence>
                                    </Loop>
                                </Parallel>
                            </Sequence>
                        </Loop>
                    </Child>

                    <OnFail canSkip="1">
                        <ExecuteLua code="mercenaries:PatrolFollowEnd(entity)" />
                    </OnFail>
                  </FuseBox>
                </EntityContext>
            </Behavior>
        </Root>
    </BehaviorTree>
</BehaviorTrees>
