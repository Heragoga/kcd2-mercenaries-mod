<?xml version="1.0" encoding="us-ascii"?>
<BehaviorTrees>
    <!-- Aleksej's own switch. Modelled on quartermaster_scheduler.xml (the two schedulers
         used to be the same file - Aleksej borrowed quartermaster_brain - and are now split
         apart, docs/aleksej.md). Same shape: stand and occasionally eat (aleksej_idle, the
         default), sit/sleep in his lodging (camp_actor, whenever the Lua camp-furniture
         tables have him assigned), defend himself with the shared melee tree when attacked,
         and start the beat-9 marsh speech on cue (forced_dialog). No follow/schedule/squad
         logic, and no walled-battle staging arm - Aleksej never mans the camp wall. -->
    <BehaviorTree name="onUpdate" is_function="0">
        <Variables>
            <Variable name="currentTarget" type="_wuid" values="" isPersistent="0" form="single" />
            <!-- Set by FindQuartermasterTarget (mercenaries_quartermaster.lua) - a generic
                 "nearest hostile near myWuid" scan, not quartermaster-specific despite the
                 name, so it is reused as-is rather than duplicated. The switch reads THIS,
                 not currentTarget: Lua cannot clear a BT _wuid, so currentTarget is only
                 ever written, never unset. Named qmHasTarget because that is the variable
                 FindQuartermasterTarget writes - a local alias here was declared but never
                 written by anything, so the write errored and this switch was always false. -->
            <Variable name="qmHasTarget" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="inCombat" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="isIdleActive" type="_bool" values="false" isPersistent="0" form="single" />

            <Variable name="attackData" type="switch:interruptData:attack" values="" isPersistent="0" form="single" />
            <Variable name="crimeInformation" type="information" values="" isPersistent="0" form="single" />
            <Variable name="mrkev" type="_wuid" values="" isPersistent="0" form="single" />
            <!-- Required so he answers when talked to: the switch pulls dialog requests
                 off the mailbox for Function_switch_handleDialog. Without it the
                 "Talk" prompt shows but pressing E does nothing (the request is
                 never processed). Copied from mercenary_scheduler.xml. -->
            <Variable name="dialogRequest" type="dialogModule:onDialogRequest" values="" isPersistent="0" form="single" />

            <!-- Forced dialogue (beat 9's marsh speech, and any future beat that needs one
                 while he is not registered as a camp actor). This brain cannot reach
                 camp_actor from anywhere except its own arm below, so the fire has to live
                 here too - same shape as quartermaster_scheduler.xml carried for him before. -->
            <Variable name="fdWant" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="fdFired" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="fdSeen" type="_int" values="0" isPersistent="0" form="single" />
            <Variable name="fdAttackData" type="switch:interruptData:attack" values="" isPersistent="0" form="single" />
            <Variable name="fdCrimeInfo" type="information" values="" isPersistent="0" form="single" />
            <Variable name="fdMrkev" type="_wuid" values="" isPersistent="0" form="single" />

            <!-- Aleksej lives in his lodging: stool by day, bed by night (AlxLodgingTick,
                 mercenaries_aleksej.lua). camp_actor is what consumes the camp furniture
                 tables, and this brain reaches none of the four schedulers that normally
                 fire it, so it is fired here. -->
            <Variable name="isCampActor" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="campFired" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="campAttackData" type="switch:interruptData:attack" values="" isPersistent="0" form="single" />
            <Variable name="campCrimeInfo" type="information" values="" isPersistent="0" form="single" />
            <Variable name="campMrkev" type="_wuid" values="" isPersistent="0" form="single" />
        </Variables>
        <Root OneTimeOnly="false" FailState="Recoverable" saveVersion="2">
            <Behavior canSkip="1">
                <SuppressFailure>
                    <Parallel successMode="Any" failureMode="Any">

                        <!-- Camp routine: fire camp_actor whenever Lua says he currently has a
                             camp role (furniture/activity/guard/column) and nothing else has
                             the slot. Fires once (campFired latches); combat clears the latch
                             so the routine resumes once a fight ends. -->
                        <Loop count="-1">
                            <Sequence>
                                <ExecuteLua code="data.isCampActor = mercenaries:IsCampActor(entity.this.id)" />
                                <IfCondition failOnCondition="false" condition="$inCombat">
                                    <Expression expressions="$campFired = false" />
                                </IfCondition>
                                <IfCondition failOnCondition="false" condition="~$inCombat &amp; $isCampActor &amp; $currentTarget == $__null &amp; ~$campFired">
                                    <Sequence>
                                        <SuppressFailure>
                                            <Function_crime_getMrkev mrkev="$campMrkev" nodeLabel="92000001" />
                                            <CreateInformationWrapper Label="'assault'" PerceivedWuid="$this.id" PositionType="positionWuid" PositionVec3="" PositionWuid="$this.id" Information="$campCrimeInfo" />
                                            <LockDynamicInformationValues Information="$campCrimeInfo">
                                                <SetDynamicInformationValue Information="$campCrimeInfo" Tag="'stimulusKind'" Variable="$enum:crime_stimulusKind.combat" Type="" Value="" />
                                            </LockDynamicInformationValues>
                                            <Function_crime_limits_reserveReactionLink ffCrimeIcon="false" information="$campCrimeInfo" priority="160" reactionKind="$enum:crime_reactionKind.attack" nodeLabel="92000002" />
                                        </SuppressFailure>
                                        <Expression expressions="$campAttackData.target = $this.id &#10; $campAttackData.information = $campCrimeInfo &#10; $campAttackData.stimulusKind = $enum:crime_stimulusKind.combat &#10; $campAttackData.previousReaction = $enum:crime_reactionKind.unknown &#10; $campAttackData.initiatedBy = $enum:switch_interruptInitiator.switch &#10; $campAttackData.defenceMode = false &#10; $campAttackData.relationOverride = true &#10; $campAttackData.source = $enum:crime_source.direct &#10; $campAttackData.freshlyAttributedCrime = false &#10; $campAttackData.criminalFreshness = $enum:crime_criminalFreshness.unknown &#10; $campAttackData.escalatedFromFailedSurrender = false" />
                                        <AddInterrupt_attack attackData="$campAttackData" Target="$this.id" Host="$campMrkev" Behavior="'camp_actor'" Priority="160" IgnorePriorityOnPreviousInterrupt="true" urgency="Fast" Aliveness="Alive" Privileged="false" FastForward="false" />
                                        <Expression expressions="$campFired = true" />
                                    </Sequence>
                                </IfCondition>
                                <Wait duration="'2s'" timeType="GameTime" doFail="false" variation="'800ms'" />
                            </Sequence>
                        </Loop>

                        <!-- Forced dialogue at the player: fire forced_dialog while Lua asks for
                             it (RequestForceTalk -> ForceTalkWanted). Same interrupt shape the
                             camp arm above uses, because a behaviour only ever runs if an
                             interrupt fires it. -->
                        <Loop count="-1">
                            <Sequence>
                                <ExecuteLua code="mercenaries:ForceTalkWanted(data, entity)" />
                                <IfCondition failOnCondition="false" condition="~$fdWant">
                                    <Expression expressions="$fdFired = false" />
                                </IfCondition>
                                <IfCondition failOnCondition="false" condition="$fdWant &amp; ~$fdFired">
                                    <Sequence>
                                        <LogToConsole LogLevel="Info" Message="&apos;[fd] aleksej_scheduler firing forced_dialog&apos;" />
                                        <SuppressFailure>
                                            <Function_crime_getMrkev mrkev="$fdMrkev" nodeLabel="92000003" />
                                            <CreateInformationWrapper Label="&apos;assault&apos;" PerceivedWuid="$this.id" PositionType="positionWuid" PositionVec3="" PositionWuid="$this.id" Information="$fdCrimeInfo" />
                                            <LockDynamicInformationValues Information="$fdCrimeInfo">
                                                <SetDynamicInformationValue Information="$fdCrimeInfo" Tag="&apos;stimulusKind&apos;" Variable="$enum:crime_stimulusKind.combat" Type="" Value="" />
                                            </LockDynamicInformationValues>
                                            <Function_crime_limits_reserveReactionLink ffCrimeIcon="false" information="$fdCrimeInfo" priority="170" reactionKind="$enum:crime_reactionKind.attack" nodeLabel="92000004" />
                                        </SuppressFailure>
                                        <Expression expressions="$fdAttackData.target = $this.id &#10; $fdAttackData.information = $fdCrimeInfo &#10; $fdAttackData.stimulusKind = $enum:crime_stimulusKind.combat &#10; $fdAttackData.previousReaction = $enum:crime_reactionKind.unknown &#10; $fdAttackData.initiatedBy = $enum:switch_interruptInitiator.switch &#10; $fdAttackData.defenceMode = false &#10; $fdAttackData.relationOverride = true &#10; $fdAttackData.source = $enum:crime_source.direct &#10; $fdAttackData.freshlyAttributedCrime = false &#10; $fdAttackData.criminalFreshness = $enum:crime_criminalFreshness.unknown &#10; $fdAttackData.escalatedFromFailedSurrender = false" />
                                        <AddInterrupt_attack attackData="$fdAttackData" Target="$this.id" Host="$fdMrkev" Behavior="&apos;forced_dialog&apos;" Priority="170" IgnorePriorityOnPreviousInterrupt="true" urgency="Fast" Aliveness="Alive" Privileged="false" FastForward="false" />
                                        <Expression expressions="$fdFired = true" />
                                    </Sequence>
                                </IfCondition>
                                <Wait duration="&apos;1s&apos;" timeType="GameTime" doFail="false" variation="&apos;400ms&apos;" />
                            </Sequence>
                        </Loop>

                        <!-- Talk handling: pull dialog requests off the mailbox and run them (makes "Talk" work). -->
                        <Loop count="-1">
                            <Sequence>
                                <SuppressFailure>
                                    <ProcessMessage Atomic="false" timeout="'0ms'" timeType="GameTime" variable="$dialogRequest" senderInfo="" inbox="'dialogMailbox'" condition="" answerVar="">
                                        <Function_switch_handleDialog dialogRequest="$dialogRequest" nodeLabel="92000005" />
                                    </ProcessMessage>
                                </SuppressFailure>
                                <Wait duration="'300ms'" timeType="GameTime" doFail="false" variation="'120ms'" />
                            </Sequence>
                        </Loop>

                        <!-- Combat detection: are we currently under attack? -->
                        <Loop count="-1">
                            <Sequence>
                                <EntityContextCheck context="crime_interruptAttack" target="$this.id" saveVersion="2">
                                    <Then canSkip="1">
                                        <!-- Drop the idle latch here too, not only where the switch
                                             fires combat itself: an attacker who strikes first puts
                                             him in combat without that arm ever running, and the
                                             latch would then block the idle re-fire afterwards. -->
                                        <Expression expressions="$inCombat = true &#10; $isIdleActive = false" />
                                    </Then>
                                    <Else canSkip="1">
                                        <Expression expressions="$inCombat = false" />
                                    </Else>
                                </EntityContextCheck>
                                <Wait duration="'800ms'" timeType="GameTime" doFail="false" variation="'320ms'" />
                            </Sequence>
                        </Loop>

                        <!-- Defensive target pick: nearest genuinely-hostile, weapon-drawn NPC
                             near him. -->
                        <Loop count="-1">
                            <Sequence>
                                <ExecuteLua code="mercenaries:FindQuartermasterTarget(data, entity.this.id)" />
                                <Wait duration="'1s'" timeType="GameTime" doFail="false" variation="'400ms'" />
                            </Sequence>
                        </Loop>

                        <Loop count="-1">
                            <ContinuousSwitch>

                                <!-- An attacker showed up and we're not yet fighting: fire the
                                     shared melee combat interrupt on it. Dropping isIdleActive
                                     means the idle behaviour re-fires once the fight is over. -->
                                <IfCondition failOnCondition="false" condition="~$inCombat &amp; $qmHasTarget">
                                    <Sequence>
                                        <SuppressFailure>
                                            <Function_crime_getMrkev mrkev="$mrkev" nodeLabel="92000006" />
                                            <CreateInformationWrapper Label="'assault'" PerceivedWuid="$this.id" PositionType="positionWuid" PositionVec3="" PositionWuid="$currentTarget" Information="$crimeInformation" />
                                            <LockDynamicInformationValues Information="$crimeInformation">
                                                <SetDynamicInformationValue Information="$crimeInformation" Tag="'stimulusKind'" Variable="$enum:crime_stimulusKind.combat" Type="" Value="" />
                                            </LockDynamicInformationValues>
                                            <Function_crime_limits_reserveReactionLink ffCrimeIcon="false" information="$crimeInformation" priority="160" reactionKind="$enum:crime_reactionKind.attack" nodeLabel="92000007" />
                                        </SuppressFailure>
                                        <Expression expressions="$attackData.target = $currentTarget &#10; $attackData.information = $crimeInformation &#10; $attackData.stimulusKind = $enum:crime_stimulusKind.combat &#10; $attackData.previousReaction = $enum:crime_reactionKind.unknown &#10; $attackData.initiatedBy = $enum:switch_interruptInitiator.switch &#10; $attackData.defenceMode = false &#10; $attackData.relationOverride = true &#10; $attackData.source = $enum:crime_source.direct &#10; $attackData.freshlyAttributedCrime = false &#10; $attackData.criminalFreshness = $enum:crime_criminalFreshness.unknown &#10; $attackData.escalatedFromFailedSurrender = false" />
                                        <AddInterrupt_attack attackData="$attackData" Target="$this.id" Host="$mrkev" Behavior="'combat_melee'" Priority="160" IgnorePriorityOnPreviousInterrupt="true" urgency="Fast" Aliveness="Alive" Privileged="false" FastForward="false" />
                                        <Expression expressions="$isIdleActive = false" />
                                        <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'200ms'" />
                                    </Sequence>
                                </IfCondition>

                                <!-- Fight ongoing (or a target still pending): let the combat
                                     tree run, don't touch the idle behaviour. -->
                                <IfCondition failOnCondition="false" condition="$inCombat | $qmHasTarget">
                                    <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'200ms'" />
                                </IfCondition>

                                <!-- Default: stand and occasionally eat - ONLY while he is not a
                                     camp actor. camp_actor and this arm both fire at priority 160
                                     and would otherwise race each other every cycle (both loops
                                     evaluate true at the same time and whichever AddInterrupt
                                     lands last evicts the other); gating on ~$isCampActor makes
                                     this arm a true fallback, not a competing default. Fired once
                                     (isIdleActive latches) and re-fired after any fight. -->
                                <IfCondition failOnCondition="false" condition="~$isCampActor">
                                    <Sequence>
                                        <IfCondition failOnCondition="false" condition="~$isIdleActive">
                                            <Sequence>
                                                <SuppressFailure>
                                                    <Function_crime_getMrkev mrkev="$mrkev" nodeLabel="92000006" />
                                                    <CreateInformationWrapper Label="'assault'" PerceivedWuid="$this.id" PositionType="positionWuid" PositionVec3="" PositionWuid="$__player" Information="$crimeInformation" />
                                                    <LockDynamicInformationValues Information="$crimeInformation">
                                                        <SetDynamicInformationValue Information="$crimeInformation" Tag="'stimulusKind'" Variable="$enum:crime_stimulusKind.combat" Type="" Value="" />
                                                    </LockDynamicInformationValues>
                                                    <Function_crime_limits_reserveReactionLink ffCrimeIcon="false" information="$crimeInformation" priority="160" reactionKind="$enum:crime_reactionKind.attack" nodeLabel="92000007" />
                                                </SuppressFailure>
                                                <Expression expressions="$attackData.target = $__player &#10; $attackData.information = $crimeInformation &#10; $attackData.stimulusKind = $enum:crime_stimulusKind.combat &#10; $attackData.previousReaction = $enum:crime_reactionKind.unknown &#10; $attackData.initiatedBy = $enum:switch_interruptInitiator.switch &#10; $attackData.defenceMode = false &#10; $attackData.relationOverride = true &#10; $attackData.source = $enum:crime_source.direct &#10; $attackData.freshlyAttributedCrime = false &#10; $attackData.criminalFreshness = $enum:crime_criminalFreshness.unknown &#10; $attackData.escalatedFromFailedSurrender = false" />
                                                <AddInterrupt_attack attackData="$attackData" Target="$this.id" Host="$mrkev" Behavior="'aleksej_idle'" Priority="160" IgnorePriorityOnPreviousInterrupt="true" urgency="Fast" Aliveness="Alive" Privileged="false" FastForward="false" />
                                                <Expression expressions="$isIdleActive = true" />
                                            </Sequence>
                                        </IfCondition>
                                        <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'200ms'" />
                                    </Sequence>
                                </IfCondition>

                                <!-- Catch-all: he is a camp actor and camp_actor already holds the
                                     slot (fired by the loop above) - nothing to do here but wait,
                                     and keep the idle latch dropped so aleksej_idle fires cleanly
                                     the moment isCampActor goes false again. -->
                                <IfCondition failOnCondition="false" condition="true">
                                    <Sequence>
                                        <Expression expressions="$isIdleActive = false" />
                                        <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'200ms'" />
                                    </Sequence>
                                </IfCondition>

                            </ContinuousSwitch>
                        </Loop>

                    </Parallel>
                </SuppressFailure>
            </Behavior>
        </Root>
    </BehaviorTree>
</BehaviorTrees>
