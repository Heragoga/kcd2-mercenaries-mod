<?xml version="1.0" encoding="us-ascii"?>
<BehaviorTrees>
    <!-- Foe pre-combat state: stand around until something is spotted. This is the
         placeholder for whatever the foe type is actually doing before the fight -
         camp life, a march, a patrol - and is the only piece of the foe AI meant to
         be swapped per foe type. It deliberately does NOT open the
         crime_interruptAttack context, so foe_combat replaces it cleanly.

         Two arms: a fast heartbeat that tells Lua this behaviour is running (without
         it the scheduler would re-fire idle every second), and the emote loop. -->
    <BehaviorTree name="foe_idle" is_function="0">
        <Variables>
            <Variable name="foeEmote" type="_string" values="" isPersistent="0" form="single" />
        </Variables>
        <Root OneTimeOnly="false" FailState="Recoverable" saveVersion="2">
            <Behavior canSkip="1">
                <SuppressFailure>
                    <Parallel successMode="Any" failureMode="Any">

                        <Loop count="-1">
                            <Sequence>
                                <ExecuteLua code="mercenaries:FoeBeat(entity.this.id, 'idle')" />
                                <Wait duration="'700ms'" timeType="GameTime" doFail="false" variation="'280ms'" />
                            </Sequence>
                        </Loop>

                        <Loop count="-1">
                            <Sequence>
                                <ExecuteLua code="mercenaries:FoeIdleTick(data, entity.this.id)" />
                                <SuppressFailure>
                                    <ExecuteLua code="pcall(function() if entity.human and entity.human:IsWeaponDrawn() then entity.human:DrawWeapon(false) end end)" />
                                </SuppressFailure>
                                <!-- UnstanceElement, not UnstanceAction: the emote is scoped to the hold,
                                     so combat ending this tree also ends the animation instead of leaving
                                     the foe walking about in the pose. -->
                                <SuppressFailure>
                                    <UnstanceElement unstance="$foeEmote" locationObject="" slaveObject="" enabled="true">
                                        <Sequence>
                                            <WaitAction />
                                            <Wait duration="'8s'" timeType="GameTime" doFail="false" variation="'4s'" />
                                        </Sequence>
                                    </UnstanceElement>
                                </SuppressFailure>
                                <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'200ms'" />
                            </Sequence>
                        </Loop>

                    </Parallel>
                </SuppressFailure>
            </Behavior>
        </Root>
    </BehaviorTree>
</BehaviorTrees>
