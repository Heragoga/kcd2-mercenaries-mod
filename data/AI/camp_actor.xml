<?xml version="1.0" encoding="us-ascii"?>
<BehaviorTrees>
    <!-- Camp actor module: everything an NPC does while living in a camp -
         guard patrol, sit/sleep on furniture, activities (training, smithing,
         eating...), and paired gossip. All state comes from the WUID-keyed
         camp tables in mercenaries_camp.lua (IsCampGuard / GetCampFurniture /
         GetCampActivity / _G.MercCampChats), which are side-agnostic: populate
         them for any NPC - merc or bandit - and fire this behaviour on it.
         Extracted from the old composite follow tree. See docs/ai-modules.md. -->
    <BehaviorTree name="camp_actor" is_function="0">
        <Variables>
            <!-- Marching column (bandit patrol contracts): follow the man ahead.
                 CrimeFollower may only run inside a FIRED interrupt behaviour, which this tree
                 is - the same constraint patrol_follow.xml documents. -->
            <Variable name="columnTarget" type="_wuid" values="" isPersistent="0" form="single" />
            <Variable name="followTarget" type="_wuid" values="" isPersistent="0" form="single" />
            <Variable name="stillFollowing" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="inColumn" type="_bool" values="false" isPersistent="0" form="single" />
            <!-- Camp-guard patrol: Move to patrolWaypoint (a vec3 position) instead of following. -->
            <Variable name="isCampGuard" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="patrolWaypoint" type="vec3" values="" isPersistent="0" form="single" />
            <Variable name="patrolHasWaypoint" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="patrolLongPause" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="patrolNoPause" type="_bool" values="false" isPersistent="0" form="single" />
            <!-- Set by CampActorYield: leave the camp behaviour so combat can have the slot. -->
            <Variable name="campYield" type="_bool" values="false" isPersistent="0" form="single" />
            <!-- Camp sit/sleep: Move to campFurniturePos (StanceElement doesn't navigate),
                 then StanceElement against campFurniture (the seat/bed StanceSmartObject WUID). -->
            <Variable name="isCampSitter" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="isCampSleeper" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="campFurniture" type="_wuid" values="" isPersistent="0" form="single" />
            <Variable name="campFurniturePos" type="vec3" values="" isPersistent="0" form="single" />
            <!-- campFurnitureFace: campfire a seated merc turns to face (the seated pose
                 doesn't inherit the seat's rotation, so a Turn is needed). -->
            <Variable name="campFurnitureFace" type="vec3" values="" isPersistent="0" form="single" />
            <Variable name="hasCampFurnitureFace" type="_bool" values="false" isPersistent="0" form="single" />
            <!-- Camp activities (CampActivityCatalogue in mercenaries_camp.lua).
                 campActUnstance = the NPCStateUnstanceDatabase action; campActMode:
                 1 sit on campActLoc, 2 stand, 3 stand aligned to campActLoc, 4 duo leader. -->
            <Variable name="campActMode" type="_int" values="0" isPersistent="0" form="single" />
            <Variable name="campActUnstance" type="_string" values="" isPersistent="0" form="single" />
            <Variable name="campActPos" type="vec3" values="" isPersistent="0" form="single" />
            <Variable name="campActLoc" type="_wuid" values="" isPersistent="0" form="single" />
            <Variable name="campActSlave" type="_wuid" values="" isPersistent="0" form="single" />
            <Variable name="campActDrawWeapon" type="_bool" values="false" isPersistent="0" form="single" />
            <!-- campActFace: vec3 the merc turns to face at the spot; campActHasFace gates the Turn. -->
            <Variable name="campActFace" type="vec3" values="" isPersistent="0" form="single" />
            <Variable name="campActHasFace" type="_bool" values="false" isPersistent="0" form="single" />
            <!-- Camp conversations: CampChatTick publishes _G.MercCampChats[wuid];
                 chatRole 1 = initiator, 2 = receiver, 0 = not chatting. -->
            <Variable name="chatRole" type="_float" values="0" isPersistent="0" form="single" />
            <Variable name="chatPartner" type="_wuid" values="" isPersistent="0" form="single" />
            <!-- chatAlias: specific gossip_merc_*.xml to tell; empty = vanilla GOSSIP pool. -->
            <Variable name="chatAlias" type="_string" values="" isPersistent="0" form="single" />
            <Variable name="hasChatAlias" type="_bool" values="false" isPersistent="0" form="single" />
            <!-- Order bark: RequestBark queues an alias in _G.MercBarkReq[wuid]; the bark loop below plays it once. -->
            <Variable name="barkReqAlias" type="_string" values="" isPersistent="0" form="single" />
            <Variable name="hasBarkReq" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="polylog_participants" type="_wuid" values="" isPersistent="0" form="array" />
            <Variable name="polylog_participantsMetaroles" type="soulToMetaroles" values="" isPersistent="0" form="array" />
            <!-- Camp smith (mode 10): the conjured work item and the one-time-equip guard flag. -->
            <Variable name="forgeHammerItem" type="_wuid" values="" isPersistent="0" form="single" />
            <Variable name="m10Equipped" type="_bool" values="false" isPersistent="0" form="single" />
        </Variables>
        <Parameters>
            <Variable name="attackData" type="switch:interruptData:attack" values="" isPersistent="0" form="single" requirementType="In" />
        </Parameters>
        <Root OneTimeOnly="false" FailState="Recoverable" saveVersion="2">
            <Behavior canSkip="1">
                <Sequence>
                    <Parallel successMode="Any" failureMode="Any">

                        <Loop count="-1">
                            <Sequence>
                                <!-- Refresh camp role each cycle (guard/sitter/sleeper; only one true at a time). -->
                                <!-- FIRST, every cycle: should this man still be a camp actor
                                     at all? This tree is an infinite Loop and nothing else
                                     ever ends it, so without this a besieger with a target
                                     stands in the middle of a battle being hit. The patrol
                                     trees do exactly this via PatrolYieldToCombat. -->
                                <ExecuteLua code="mercenaries:CampActorYield(data, entity)" />
                                <IfCondition failOnCondition="false" condition="$campYield">
                                    <Fail />
                                </IfCondition>
                                <ExecuteLua code="data.isCampGuard = mercenaries:IsCampGuard(entity.this.id)" />
                                <ExecuteLua code="mercenaries:ColumnFollowRole(data, entity)" />
                                <ExecuteLua code="
                                    data.isCampSitter = false
                                    data.isCampSleeper = false
                                    data.hasCampFurnitureFace = false
                                    local f = mercenaries:GetCampFurniture(entity.this.id)
                                    if f and f.wuid and f.pos then
                                        data.campFurniture = f.wuid
                                        data.campFurniturePos.x = f.pos.x
                                        data.campFurniturePos.y = f.pos.y
                                        data.campFurniturePos.z = f.pos.z
                                        if f.facePos then
                                            data.campFurnitureFace.x = f.facePos.x
                                            data.campFurnitureFace.y = f.facePos.y
                                            data.campFurnitureFace.z = f.facePos.z
                                            data.hasCampFurnitureFace = true
                                        end
                                        if f.kind == 'bed' then data.isCampSleeper = true else data.isCampSitter = true end
                                    end
                                " />
                                <!-- Camp conversation pairing: read this merc's role/partner/alias from _G.MercCampChats. -->
                                <ExecuteLua code="
                                    data.chatRole = 0
                                    data.chatAlias = ''
                                    data.hasChatAlias = false
                                    local chats = _G.MercCampChats
                                    local c = chats and chats[tostring(entity.this.id)]
                                    if c then
                                        data.chatRole = c.role
                                        data.chatPartner = c.partner
                                        if c.alias and c.alias ~= '' then
                                            data.chatAlias = c.alias
                                            data.hasChatAlias = true
                                        end
                                    end
                                " />
                                <!-- Camp activity refresh; campActMode 0 = none assigned. -->
                                <ExecuteLua code="
                                    data.campActMode = 0
                                    data.campActDrawWeapon = false
                                    data.campActHasFace = false
                                    local a = mercenaries:GetCampActivity(entity.this.id)
                                    if a and a.pos then
                                        if a.unstance then data.campActUnstance = a.unstance end
                                        data.campActPos.x = a.pos.x
                                        data.campActPos.y = a.pos.y
                                        data.campActPos.z = a.pos.z
                                        if a.locWuid then data.campActLoc = a.locWuid end
                                        if a.slaveWuid then data.campActSlave = a.slaveWuid end
                                        if a.facePos then
                                            data.campActFace.x = a.facePos.x
                                            data.campActFace.y = a.facePos.y
                                            data.campActFace.z = a.facePos.z
                                            data.campActHasFace = true
                                        end
                                        data.campActDrawWeapon = (a.drawWeapon == true)
                                        data.campActMode = a.mode or 2
                                    end
                                " />
                                <Wait duration="'1s'" timeType="GameTime" doFail="false" variation="'200ms'" />
                            </Sequence>
                        </Loop>
                        <!-- Order-bark consumer: poll _G.MercBarkReq for this merc, play the alias once, clear it. -->
                        <Loop count="-1">
                            <Sequence>
                                <ExecuteLua code="
                                    data.hasBarkReq = false
                                    data.barkReqAlias = ''
                                    local br = _G.MercBarkReq
                                    if br then
                                        local a = br[tostring(entity.this.id)]
                                        if a and a ~= '' then
                                            data.barkReqAlias = a
                                            data.hasBarkReq = true
                                            br[tostring(entity.this.id)] = nil
                                        end
                                    end
                                " />
                                <IfCondition failOnCondition="false" condition="$hasBarkReq">
                                    <SuppressFailure>
                                        <Function_speech_schedulerMonolog alias="$barkReqAlias" animationApproach="$enum:animationApproach.dontPlayDialogAnimations" context="" lookAtId="$__player" metarole="" skipInLod="false" subtitlesDown="false" />
                                    </SuppressFailure>
                                </IfCondition>
                                <Wait duration="'1s'" timeType="GameTime" doFail="false" variation="'200ms'" />
                            </Sequence>
                        </Loop>

                        <Loop count="-1">
                            <ContinuousSwitch>

                                <!-- Marching in a column. FIRST case: a man on the march does
                                     nothing else - no gossip, no sitting, no perimeter beat.
                                     Ends on a CHANGE rather than a timer, exactly as
                                     patrol_follow.xml does: CrimeFollower never returns on its
                                     own, and restarting it makes the follower dash to
                                     re-acquire his station, so a short time-box would produce
                                     a catch-up sprint forever. -->
                                <IfCondition failOnCondition="false" condition="$inColumn">
                                    <Parallel successMode="Any" failureMode="Any">
                                        <SuppressFailure>
                                            <MoveParamsDecorator speed="Walk" pathFindingParams="" doorClosingPolicy="LeaveOpened">
                                                <CrimeFollower Target="$columnTarget" Mode="Default" Role="Main" RelativeSpeedLimit="Walk" DisableGhosting="false" BlockWay="false"/>
                                            </MoveParamsDecorator>
                                        </SuppressFailure>
                                        <Loop count="-1">
                                            <Sequence>
                                                <Wait duration="'1s'" timeType="GameTime" doFail="false" variation="'200ms'" />
                                                <ExecuteLua code="mercenaries:ColumnFollowRole(data, entity)" />
                                                <IfCondition failOnCondition="false" condition="~$stillFollowing | $followTarget != $columnTarget">
                                                    <Fail />
                                                </IfCondition>
                                            </Sequence>
                                        </Loop>
                                    </Parallel>
                                </IfCondition>

                                <!-- Camp conversations (first cases, so a paired merc turns and talks).
                                     The initiator (chatRole 1) drives a gossip polylog and ends the pair
                                     itself (EndCampChat) when done. See docs/camp.md and the two-NPC gossip notes. -->
                                <IfCondition failOnCondition="false" condition="$chatRole == 1.0">
                                    <Sequence>
                                        <!-- Only standing mercs turn to their partner: turning a merc seated on
                                             a chair spins the seated pose into a weird direction (tavern). -->
                                        <IfCondition failOnCondition="false" condition="~$isCampSitter">
                                            <SuppressFailure>
                                                <Turn target="$chatPartner" align="false" />
                                            </SuppressFailure>
                                        </IfCondition>
                                        <Expression expressions="$polylog_participants[0] = $chatPartner &#10;$polylog_participantsMetaroles[0].soul = $chatPartner &#10;$polylog_participantsMetaroles[0].metaroles = 'GOSSIP'" />
                                        <!-- One conversation like vanilla gossip: a single gossip topic
                                             (Selector: GOSSIP, else FALLBACK_GOSSIP - never both). The Timeout
                                             is a safety net; lines play in full. -->
                                        <SuppressFailure>
                                            <Timeout duration="'5m'" timeType="GameTime" doFail="false" variation="">
                                                <Sequence>
                                                    <!-- Gossip topic: prefer our own aliased gossip_merc_* ($chatAlias from
                                                         CampChatTick), else the vanilla GOSSIP / FALLBACK_GOSSIP pool.
                                                         Both souls must request metarole 'GOSSIP'; the alias alone pins
                                                         our Decision (a role name as metarole matches nothing and fails). -->
                                                    <SuppressFailure>
                                                        <Selector>
                                                            <IfCondition failOnCondition="false" condition="$hasChatAlias">
                                                                <Sequence>
                                                                    <Expression expressions="$polylog_participantsMetaroles[0].soul = $chatPartner &#10;$polylog_participantsMetaroles[0].metaroles = 'GOSSIP'" />
                                                                    <Function_speech_schedulerPolylog_initiator alias="$chatAlias" animationApproach="$enum:animationApproach.dontPlayDialogAnimations" areaForPlayer="" context="" customParameters="" metarole="'GOSSIP'" participants="$polylog_participants" participantsMetaroles="$polylog_participantsMetaroles" preset="$enum:dialogPreset.ingame" nodeLabel="73132072" />
                                                                </Sequence>
                                                            </IfCondition>
                                                            <Sequence>
                                                                <Expression expressions="$polylog_participantsMetaroles[0].metaroles = 'GOSSIP'" />
                                                                <Function_speech_schedulerPolylog_initiator alias="" animationApproach="$enum:animationApproach.dontPlayDialogAnimations" areaForPlayer="" context="" customParameters="" metarole="'GOSSIP'" participants="$polylog_participants" participantsMetaroles="$polylog_participantsMetaroles" preset="$enum:dialogPreset.ingame" nodeLabel="73132072" />
                                                            </Sequence>
                                                            <Sequence>
                                                                <Expression expressions="$polylog_participantsMetaroles[0].metaroles = 'FALLBACK_GOSSIP'" />
                                                                <Function_speech_schedulerPolylog_initiator alias="" animationApproach="$enum:animationApproach.dontPlayDialogAnimations" areaForPlayer="" context="" customParameters="" metarole="'FALLBACK_GOSSIP'" participants="$polylog_participants" participantsMetaroles="$polylog_participantsMetaroles" preset="$enum:dialogPreset.ingame" nodeLabel="73132072" />
                                                            </Sequence>
                                                        </Selector>
                                                    </SuppressFailure>
                                                    <SuppressFailure>
                                                        <Sequence>
                                                            <Expression expressions="$polylog_participantsMetaroles[0].metaroles = 'SITUACE_ROZLOUCENI'" />
                                                            <Function_speech_schedulerPolylog_initiator alias="" animationApproach="$enum:animationApproach.dontPlayDialogAnimations" areaForPlayer="" context="" customParameters="" metarole="'SITUACE_ROZLOUCENI'" participants="$polylog_participants" participantsMetaroles="$polylog_participantsMetaroles" preset="$enum:dialogPreset.ingame" nodeLabel="73132072" />
                                                        </Sequence>
                                                    </SuppressFailure>
                                                </Sequence>
                                            </Timeout>
                                        </SuppressFailure>
                                        <ExecuteLua code="pcall(function() mercenaries:EndCampChat(entity.this.id) end)" />
                                        <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                    </Sequence>
                                </IfCondition>
                                <IfCondition failOnCondition="false" condition="$chatRole == 2.0">
                                    <Sequence>
                                        <!-- Seated mercs don't turn - see the initiator branch. -->
                                        <IfCondition failOnCondition="false" condition="~$isCampSitter">
                                            <SuppressFailure>
                                                <Turn target="$chatPartner" align="false" />
                                            </SuppressFailure>
                                        </IfCondition>
                                        <!-- Receiver: each call blocks until the initiator drives the line;
                                             the initiator's EndCampChat clears the pair (chatRole back to 0). -->
                                        <SuppressFailure>
                                            <Timeout duration="'5m'" timeType="GameTime" doFail="false" variation="">
                                                <Sequence>
                                                    <!-- Gossip topic: receive our own aliased merc gossip if one was
                                                         assigned to the pair, else the generic vanilla GOSSIP. -->
                                                    <SuppressFailure>
                                                        <Selector>
                                                            <IfCondition failOnCondition="false" condition="$hasChatAlias">
                                                                <Function_speech_schedulerPolylog_receiver aliasOrMetarole="$chatAlias" initiator="$chatPartner" numberOfParticipants="2" useIngameDialogPoseAndAnimations="false" nodeLabel="71778248" />
                                                            </IfCondition>
                                                            <Function_speech_schedulerPolylog_receiver aliasOrMetarole="'GOSSIP'" initiator="$chatPartner" numberOfParticipants="2" useIngameDialogPoseAndAnimations="false" nodeLabel="71778248" />
                                                        </Selector>
                                                    </SuppressFailure>
                                                    <SuppressFailure><Function_speech_schedulerPolylog_receiver aliasOrMetarole="'SITUACE_ROZLOUCENI'" initiator="$chatPartner" numberOfParticipants="2" useIngameDialogPoseAndAnimations="false" nodeLabel="71778248" /></SuppressFailure>
                                                </Sequence>
                                            </Timeout>
                                        </SuppressFailure>
                                        <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                    </Sequence>
                                </IfCondition>
                                <!-- Camp activities (first cases, so an assigned activity preempts
                                     patrol/sit/sleep/follow). UnstanceAction plays $campActUnstance
                                     (a NPCStateUnstanceDatabase name); the following Wait is the hold
                                     before the Out fragment. See docs/camp.md. -->

                                <!-- Mode 1: sit on the anchor seat, then play the action seated.
                                     The <WaitAction/> performs the sit-down. -->
                                <IfCondition failOnCondition="false" condition="$campActMode == 1">
                                    <Sequence>
                                        <SuppressFailure>
                                            <Sequence>
                                                <!-- Tight stop: any distance left here is walked by the StanceElement
                                                     AFTER the Turn, re-facing the merc to the approach direction. -->
                                                <Move stopWithinDistance="0.100000" stopDistanceVariation="0.050000" rayCasteFlee="false" successDistance="0.000000" changeNPCState="true" fastForwardIncludesMove="false" destinationSpecification="$campActPos" destinationSpecification2="" destinationSpecification3="" speed="Walk" additionalParams="" pathFindingParams="" staminaPolicy="" pathInfo="" />
                                                <!-- Face the campfire before sitting (the seated pose keeps the merc's current facing). -->
                                                <IfCondition failOnCondition="false" condition="$campActHasFace">
                                                    <SuppressFailure>
                                                        <Turn target="$campActFace" align="false" />
                                                    </SuppressFailure>
                                                </IfCondition>
                                                <StanceElement smartObject="$campActLoc" stance="sitting" allowAny="false" enabled="true">
                                                    <Sequence>
                                                        <WaitAction />
                                                        <!-- locationObject MUST be the seat smart object; empty makes the merc stand on the stool. -->
                                                        <UnstanceAction unstance="$campActUnstance" locationObject="$campActLoc" slaveObject="" />
                                                        <Wait duration="'15s'" timeType="GameTime" doFail="false" variation="'5s'" />
                                                    </Sequence>
                                                </StanceElement>
                                            </Sequence>
                                        </SuppressFailure>
                                        <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                    </Sequence>
                                </IfCondition>

                                <!-- Mode 2: standing, no anchor (UseLocationObject="false" entries: sword training, stretching...). -->
                                <IfCondition failOnCondition="false" condition="$campActMode == 2">
                                    <Sequence>
                                        <SuppressFailure>
                                            <Sequence>
                                                <Move stopWithinDistance="0.500000" stopDistanceVariation="0.200000" rayCasteFlee="false" successDistance="0.000000" changeNPCState="true" fastForwardIncludesMove="false" destinationSpecification="$campActPos" destinationSpecification2="" destinationSpecification3="" speed="Walk" additionalParams="" pathFindingParams="" staminaPolicy="" pathInfo="" />
                                                <!-- Face the fire/dummies - Move leaves the merc facing the way they arrived. -->
                                                <IfCondition failOnCondition="false" condition="$campActHasFace">
                                                    <SuppressFailure>
                                                        <Turn target="$campActFace" align="false" />
                                                    </SuppressFailure>
                                                </IfCondition>
                                                <!-- DrawAction is a no-op gate: the unstance's In fragment re-sheathes anyway. -->
                                                <IfCondition failOnCondition="false" condition="$campActDrawWeapon">
                                                    <SuppressFailure>
                                                        <DrawAction WeaponSet="Primary" fullBody="false" tags="" />
                                                    </SuppressFailure>
                                                </IfCondition>
                                                <UnstanceAction unstance="$campActUnstance" locationObject="" slaveObject="" />
                                                <!-- Short hold so the switch can drop this activity promptly (e.g. on break-camp). -->
                                                <Wait duration="'8s'" timeType="GameTime" doFail="false" variation="'3s'" />
                                            </Sequence>
                                        </SuppressFailure>
                                        <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                    </Sequence>
                                </IfCondition>

                                <!-- Mode 10: camp smith (see mercenaries_forge.lua / docs/camp-forge.md).
                                     Conjure a sword into his hand once (CreateItem+EquipItem, guarded by
                                     $m10Equipped), sit on the bench, and play camper_knifeSharpening (a
                                     held-item camper anim). No Move - Lua teleports him onto the bench. -->
                                <IfCondition failOnCondition="false" condition="$campActMode == 10">
                                    <Sequence>
                                        <IfCondition failOnCondition="false" condition="~$m10Equipped">
                                            <Sequence>
                                                <SuppressFailure>
                                                    <CreateItem ItemGUID="'8c6b9277-e7ad-4246-974a-65b7000fbc5a'" Amount="1" CreatedItem="$forgeHammerItem" Target="$this.id" NotifyUI="false" />
                                                </SuppressFailure>
                                                <SuppressFailure>
                                                    <EquipItem item="$forgeHammerItem" Target="$this.id" />
                                                </SuppressFailure>
                                                <Expression expressions="$m10Equipped = true" />
                                            </Sequence>
                                        </IfCondition>
                                        <SuppressFailure>
                                            <StanceElement smartObject="$campActLoc" stance="sitting" allowAny="false" enabled="true">
                                                <Sequence>
                                                    <WaitAction />
                                                    <UnstanceAction unstance="$campActUnstance" locationObject="$campActLoc" slaveObject="" />
                                                    <Wait duration="'15s'" timeType="GameTime" doFail="false" variation="'5s'" />
                                                </Sequence>
                                            </StanceElement>
                                        </SuppressFailure>
                                        <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                    </Sequence>
                                </IfCondition>

                                <!-- Mode 3: standing, aligned to the campActLoc anchor (the anchor's facing decides direction). -->
                                <IfCondition failOnCondition="false" condition="$campActMode == 3">
                                    <Sequence>
                                        <SuppressFailure>
                                            <Sequence>
                                                <Move stopWithinDistance="0.800000" stopDistanceVariation="0.300000" rayCasteFlee="false" successDistance="0.000000" changeNPCState="true" fastForwardIncludesMove="false" destinationSpecification="$campActPos" destinationSpecification2="" destinationSpecification3="" speed="Walk" additionalParams="" pathFindingParams="" staminaPolicy="" pathInfo="" />
                                                <UnstanceAction unstance="$campActUnstance" locationObject="$campActLoc" slaveObject="" />
                                                <Wait duration="'15s'" timeType="GameTime" doFail="false" variation="'5s'" />
                                            </Sequence>
                                        </SuppressFailure>
                                        <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                    </Sequence>
                                </IfCondition>

                                <!-- Mode 4: duo animation leader. Confirmed dead in-game (paired fragments never played); no catalogue entry uses it. -->
                                <IfCondition failOnCondition="false" condition="$campActMode == 4">
                                    <Sequence>
                                        <SuppressFailure>
                                            <Sequence>
                                                <Move stopWithinDistance="0.500000" stopDistanceVariation="0.200000" rayCasteFlee="false" successDistance="0.000000" changeNPCState="true" fastForwardIncludesMove="false" destinationSpecification="$campActPos" destinationSpecification2="" destinationSpecification3="" speed="Walk" additionalParams="" pathFindingParams="" staminaPolicy="" pathInfo="" />
                                                <UnstanceAction unstance="$campActUnstance" locationObject="" slaveObject="$campActSlave" />
                                                <Wait duration="'15s'" timeType="GameTime" doFail="false" variation="'5s'" />
                                            </Sequence>
                                        </SuppressFailure>
                                        <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                    </Sequence>
                                </IfCondition>
                                <!-- Camp-guard patrol: Walk to the current perimeter waypoint (changeNPCState="true",
                                     required for move-to-a-point), advance, and pause (occasionally longer).
                                     SuppressFailure so a blocked path just retries next cycle. -->
                                <IfCondition failOnCondition="false" condition="$isCampGuard">
                                    <SuppressFailure>
                                        <Sequence>
                                            <ExecuteLua code="
                                                data.patrolHasWaypoint = false
                                                pcall(function()
                                                    local wp = mercenaries:GetPatrolWaypoint(entity.this.id)
                                                    if wp then
                                                        data.patrolWaypoint.x = wp.x
                                                        data.patrolWaypoint.y = wp.y
                                                        data.patrolWaypoint.z = wp.z
                                                        data.patrolHasWaypoint = true
                                                    end
                                                end)
                                            " />
                                            <IfCondition failOnCondition="false" condition="$patrolHasWaypoint">
                                                <Sequence>
                                                    <Move stopWithinDistance="1.000000" stopDistanceVariation="0.500000" rayCasteFlee="false" successDistance="0.000000" changeNPCState="true" fastForwardIncludesMove="false" destinationSpecification="$patrolWaypoint" destinationSpecification2="" destinationSpecification3="" speed="Walk" additionalParams="" pathFindingParams="" staminaPolicy="" pathInfo="" />
                                                    <ExecuteLua code="pcall(function() mercenaries:AdvancePatrolWaypoint(entity.this.id) end)" />
                                                    <ExecuteLua code="data.patrolNoPause = mercenaries:IsPatrolNoPause(entity.this.id)" />
                                                    <ExecuteLua code="data.patrolLongPause = (math.random(1, 5) == 1)" />
                                                    <IfElseCondition failOnCondition="false" condition="$patrolNoPause" saveVersion="2">
                                                        <Then canSkip="1">
                                                            <Wait duration="'200ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                                        </Then>
                                                        <Else canSkip="1">
                                                    <IfElseCondition failOnCondition="false" condition="$patrolLongPause" saveVersion="2">
                                                        <Then canSkip="1">
                                                            <Wait duration="'20s'" timeType="GameTime" doFail="false" variation="'8s'" />
                                                        </Then>
                                                        <Else canSkip="1">
                                                            <Wait duration="'6s'" timeType="GameTime" doFail="false" variation="'4s'" />
                                                        </Else>
                                                    </IfElseCondition>
                                                        </Else>
                                                    </IfElseCondition>
                                                </Sequence>
                                            </IfCondition>
                                            <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                        </Sequence>
                                    </SuppressFailure>
                                </IfCondition>
                                <!-- Camp sleeper: Move to the bed's StanceSmartObject position (StanceElement
                                     doesn't navigate), then StanceElement lying against its WUID. The
                                     <WaitAction/> inside is REQUIRED - it plays the enter animation;
                                     without it the merc just stands on the furniture. The trailing Wait is
                                     the hold before re-entering. See docs/camp.md. -->
                                <IfCondition failOnCondition="false" condition="$isCampSleeper">
                                    <Sequence>
                                        <SuppressFailure>
                                            <Sequence>
                                                <Move stopWithinDistance="0.500000" stopDistanceVariation="0.200000" rayCasteFlee="false" successDistance="0.000000" changeNPCState="true" fastForwardIncludesMove="false" destinationSpecification="$campFurniturePos" destinationSpecification2="" destinationSpecification3="" speed="Walk" additionalParams="" pathFindingParams="" staminaPolicy="" pathInfo="" />
                                                <StanceElement smartObject="$campFurniture" stance="lying" allowAny="false" enabled="true">
                                                    <Sequence>
                                                        <WaitAction />
                                                        <Wait duration="'40s'" timeType="GameTime" doFail="false" variation="'20s'" />
                                                    </Sequence>
                                                </StanceElement>
                                            </Sequence>
                                        </SuppressFailure>
                                        <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                    </Sequence>
                                </IfCondition>
                                <!-- Camp sitter: same Move-then-StanceElement (sitting) as the sleeper. -->
                                <IfCondition failOnCondition="false" condition="$isCampSitter">
                                    <Sequence>
                                        <SuppressFailure>
                                            <Sequence>
                                                <!-- Tight stop: leftover distance is walked by the StanceElement AFTER
                                                     the Turn, re-facing the merc to the approach direction. -->
                                                <Move stopWithinDistance="0.100000" stopDistanceVariation="0.050000" rayCasteFlee="false" successDistance="0.000000" changeNPCState="true" fastForwardIncludesMove="false" destinationSpecification="$campFurniturePos" destinationSpecification2="" destinationSpecification3="" speed="Walk" additionalParams="" pathFindingParams="" staminaPolicy="" pathInfo="" />
                                                <!-- Face the campfire before sitting (the seated pose keeps current facing). -->
                                                <IfCondition failOnCondition="false" condition="$hasCampFurnitureFace">
                                                    <SuppressFailure>
                                                        <Turn target="$campFurnitureFace" align="false" />
                                                    </SuppressFailure>
                                                </IfCondition>
                                                <StanceElement smartObject="$campFurniture" stance="sitting" allowAny="false" enabled="true">
                                                    <Sequence>
                                                        <WaitAction />
                                                        <Wait duration="'40s'" timeType="GameTime" doFail="false" variation="'20s'" />
                                                    </Sequence>
                                                </StanceElement>
                                            </Sequence>
                                        </SuppressFailure>
                                        <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                    </Sequence>
                                </IfCondition>
                                <IfCondition failOnCondition="false" condition="true">
                                    <Wait duration="'300ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                </IfCondition>

                            </ContinuousSwitch>
                        </Loop>

                    </Parallel>
                </Sequence>
            </Behavior>
        </Root>
        <ForestContainer />
    </BehaviorTree>
</BehaviorTrees>
