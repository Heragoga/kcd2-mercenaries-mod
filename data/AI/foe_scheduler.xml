<?xml version="1.0" encoding="us-ascii"?>
<BehaviorTrees>
    <!-- Foe switch. A dispatcher and nothing else: Lua (mercenaries_foe.lua) decides
         what this NPC should be doing and whether the behaviour it should be running
         actually IS running; this tree only carries out the fire.

         There is deliberately no "am I in combat" EntityContextCheck tracker here.
         That tracker is what the old enemy scheduler raced against: it polls at one
         rate, the fire loop at another, and an unlucky order re-fires (and so
         restarts) a fight that had just begun. Here the running behaviour itself
         reports a heartbeat to Lua, and Lua alone decides when to fire again - so a
         fire that silently failed is retried ~1s later, forever, instead of leaving
         the man standing there. See docs/foe-ai.md. -->
    <BehaviorTree name="onUpdate" is_function="0">
        <Variables>
            <Variable name="foeTarget" type="_wuid" values="" isPersistent="0" form="single" />
            <Variable name="foeHasTarget" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="foeFire" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="foeFireIdle" type="_bool" values="false" isPersistent="0" form="single" />
            <!-- Function_crime_getMrkev is wrapped in SuppressFailure everywhere in this
                 mod, so a failure to obtain an interrupt host was invisible and the
                 AddInterrupt below went nowhere. hasHost makes that outcome explicit
                 and reports it to Lua, which retries. -->
            <Variable name="hasHost" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="mrkev" type="_wuid" values="" isPersistent="0" form="single" />
            <Variable name="attackData" type="switch:interruptData:attack" values="" isPersistent="0" form="single" />
            <Variable name="crimeInformation" type="information" values="" isPersistent="0" form="single" />
        </Variables>
        <Root OneTimeOnly="false" FailState="Recoverable" saveVersion="2">
            <Behavior canSkip="1">
                <SuppressFailure>
                    <Loop count="-1">
                        <Sequence>
                          <!-- Everything except the Wait lives under one SuppressFailure, so no
                               failing node can skip the Wait and spin this loop. -->
                          <SuppressFailure>
                            <Sequence>
                                <ExecuteLua code="mercenaries:FoePoll(data, entity.this.id)" />

                                <!-- Combat. Priority 160 with IgnorePriorityOnPreviousInterrupt so a
                                     re-point (target changed) replaces the running fight; Lua only
                                     asks for that when the man is fighting the wrong target or is
                                     not fighting at all. -->
                                <SuppressFailure>
                                    <IfCondition failOnCondition="false" condition="$foeFire &amp; $foeHasTarget">
                                        <Sequence>
                                            <Expression expressions="$hasHost = false" />
                                            <SuppressFailure>
                                                <Sequence>
                                                    <Function_crime_getMrkev mrkev="$mrkev" nodeLabel="7010001" />
                                                    <Expression expressions="$hasHost = true" />
                                                </Sequence>
                                            </SuppressFailure>
                                            <IfElseCondition failOnCondition="false" condition="$hasHost &amp; $mrkev ~= $__null" saveVersion="2">
                                                <Then canSkip="1">
                                                    <Sequence>
                                                        <SuppressFailure>
                                                            <Sequence>
                                                                <CreateInformationWrapper Label="'assault'" PerceivedWuid="$this.id" PositionType="positionWuid" PositionVec3="" PositionWuid="$foeTarget" Information="$crimeInformation" />
                                                                <LockDynamicInformationValues Information="$crimeInformation">
                                                                    <SetDynamicInformationValue Information="$crimeInformation" Tag="'stimulusKind'" Variable="$enum:crime_stimulusKind.combat" Type="" Value="" />
                                                                </LockDynamicInformationValues>
                                                            </Sequence>
                                                        </SuppressFailure>
                                                        <!-- relationOverride: the fight does not depend on the crime
                                                             system agreeing that this is a hostile pair. -->
                                                        <Expression expressions="$attackData.target = $foeTarget &#10; $attackData.information = $crimeInformation &#10; $attackData.stimulusKind = $enum:crime_stimulusKind.combat &#10; $attackData.previousReaction = $enum:crime_reactionKind.unknown &#10; $attackData.initiatedBy = $enum:switch_interruptInitiator.switch &#10; $attackData.defenceMode = false &#10; $attackData.relationOverride = true &#10; $attackData.source = $enum:crime_source.direct &#10; $attackData.freshlyAttributedCrime = false &#10; $attackData.criminalFreshness = $enum:crime_criminalFreshness.unknown &#10; $attackData.escalatedFromFailedSurrender = false" />
                                                        <!-- Suppressed so the report below ALWAYS runs. An
                                                             AddInterrupt that fails here would otherwise skip
                                                             it, leave firedAt unset, and have Lua retry every
                                                             250ms forever. Whether the fight really started is
                                                             answered by the heartbeat, not by this node. -->
                                                        <SuppressFailure>
                                                            <AddInterrupt_attack attackData="$attackData" Target="$this.id" Host="$mrkev" Behavior="'foe_combat'" Priority="160" IgnorePriorityOnPreviousInterrupt="true" urgency="Fast" Aliveness="Alive" Privileged="false" FastForward="false" />
                                                        </SuppressFailure>
                                                        <ExecuteLua code="mercenaries:FoeOnFired(entity.this.id, 'combat', true)" />
                                                    </Sequence>
                                                </Then>
                                                <Else canSkip="1">
                                                    <ExecuteLua code="mercenaries:FoeOnFired(entity.this.id, 'combat', false)" />
                                                </Else>
                                            </IfElseCondition>
                                        </Sequence>
                                    </IfCondition>
                                </SuppressFailure>

                                <!-- Idle. Lower priority and no ignore flag, so it can never evict a
                                     running fight even if Lua and the tree disagree for a tick. -->
                                <SuppressFailure>
                                    <IfCondition failOnCondition="false" condition="$foeFireIdle">
                                        <Sequence>
                                            <Expression expressions="$hasHost = false" />
                                            <SuppressFailure>
                                                <Sequence>
                                                    <Function_crime_getMrkev mrkev="$mrkev" nodeLabel="7010002" />
                                                    <Expression expressions="$hasHost = true" />
                                                </Sequence>
                                            </SuppressFailure>
                                            <IfElseCondition failOnCondition="false" condition="$hasHost &amp; $mrkev ~= $__null" saveVersion="2">
                                                <Then canSkip="1">
                                                    <Sequence>
                                                        <SuppressFailure>
                                                            <AddInterrupt Target="$this.id" Host="$mrkev" Behavior="'foe_idle'" Priority="120" IgnorePriorityOnPreviousInterrupt="false" urgency="Default" Aliveness="Alive" Privileged="false" FastForward="false" />
                                                        </SuppressFailure>
                                                        <ExecuteLua code="mercenaries:FoeOnFired(entity.this.id, 'idle', true)" />
                                                    </Sequence>
                                                </Then>
                                                <Else canSkip="1">
                                                    <ExecuteLua code="mercenaries:FoeOnFired(entity.this.id, 'idle', false)" />
                                                </Else>
                                            </IfElseCondition>
                                        </Sequence>
                                    </IfCondition>
                                </SuppressFailure>
                            </Sequence>
                          </SuppressFailure>

                            <!-- Matches mercenaries.FoeTickMs: the detection pass and the fire
                                 poll run at the same rate, so worst-case time from "a foe sees
                                 you" to "the interrupt is issued" is two ticks, half a second. -->
                            <Wait duration="'250ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                        </Sequence>
                    </Loop>
                </SuppressFailure>
            </Behavior>
        </Root>
    </BehaviorTree>
</BehaviorTrees>
