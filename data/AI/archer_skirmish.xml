<?xml version="1.0" encoding="us-ascii"?>
<BehaviorTrees>
    <!-- SKIRMISH: pure standFire.
         Straight copy of the vanilla battle archer pattern (standFire in
         AI/battles/battlegroupcontroller.xml): offense automation +
         WeaponChange missile, no movement of any kind. The archer plants
         their feet wherever combat starts and looses arrows from there.
         They never chase a fleeing target - the leash to the player and the
         scheduler's follow logic bring them along when the fight moves.
         Sidearm fallback only when an enemy is within 5m or out of
         arrows. Weapon drawing is left entirely to the automation
         decorators (WeaponChange="missile"/"melee") - no manual DrawWeapon
         call, since that fights the automation and leaves them holding the
         sidearm instead of the bow. -->
    <BehaviorTree name="archer_skirmish" is_function="0">
        <Variables>
            <Variable name="distanceToTarget"  type="_float" values="9999.0" isPersistent="0" form="single" />
            <Variable name="distanceToPlayer"  type="_float" values="0.0"    isPersistent="0" form="single" />
            <Variable name="isTargetAlive"     type="_bool"  values="true"   isPersistent="0" form="single" />
            <Variable name="outOfAmmo"         type="_bool"  values="false"  isPersistent="0" form="single" />
            <Variable name="stanceValid"       type="_bool"  values="true"   isPersistent="0" form="single" />
            <Variable name="myHealthCritical"  type="_bool"  values="false"  isPersistent="0" form="single" />
        </Variables>
        <Parameters>
            <Variable name="attackData" type="switch:interruptData:attack" values="" isPersistent="0" form="single" requirementType="In" />
        </Parameters>
        <Root OneTimeOnly="false" FailState="Recoverable" saveVersion="2">
            <Behavior canSkip="1">
                <EntityContext context="crime_preventDespawn" target="">
                    <EntityContextElement context="crime_interrupt" enabled="true">
                        <EntityContext context="crime_interruptAttack" target="$this.id">
                            <FuseBox StatusPropagation="Child" OneCleanup="true" saveVersion="2">
                                <Child canSkip="1">
                                    <Parallel successMode="Any" failureMode="Any">

                                        <!-- Main combat loop -->
                                        <Loop count="-1">
                                            <Sequence>
                                                <Wait duration="'300ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                                <ExecuteLua code="mercenaries:UpdateArcherCombatData(data, entity.this.id, 'skirmish')" />
                                                <IfCondition failOnCondition="false" condition="~$isTargetAlive | ~$stanceValid">
                                                    <Fail />
                                                </IfCondition>

                                                <IfElseCondition failOnCondition="false" condition="$distanceToTarget &lt; 5.0 | $outOfAmmo" saveVersion="2">
                                                    <Then canSkip="1">
                                                        <!-- Melee fallback burst -->
                                                        <SuppressFailure>
                                                            <Parallel successMode="Any" failureMode="Any">
                                                                <MoveParamsDecorator speed="Run" pathFindingParams="" doorClosingPolicy="LeaveOpened">
                                                                    <MeleeOffenseAutomationDecorator active="true">
                                                                        <MeleeDefenseAutomationDecorator active="true">
                                                                            <MeleeGuardAutomationDecorator GuardMode="automate" active="true">
                                                                                <WeaponAutomationDecorator WeaponChange="melee" active="true">
                                                                                    <CombatFollowerDecorator ProbablisticDrivenSweetSpot="true" RPGSweetSpotArcDriver="true" active="true">
                                                                                        <CombatAction TargetNPC="$attackData.target" RelationOverride="Hostile" />
                                                                                    </CombatFollowerDecorator>
                                                                                </WeaponAutomationDecorator>
                                                                            </MeleeGuardAutomationDecorator>
                                                                        </MeleeDefenseAutomationDecorator>
                                                                    </MeleeOffenseAutomationDecorator>
                                                                </MoveParamsDecorator>
                                                                <Loop count="-1">
                                                                    <Sequence>
                                                                        <Wait duration="'700ms'" timeType="GameTime" doFail="false" variation="'200ms'" />
                                                                        <ExecuteLua code="mercenaries:UpdateArcherCombatData(data, entity.this.id, 'skirmish')" />
                                                                        <IfCondition failOnCondition="false" condition="(~$outOfAmmo &amp; $distanceToTarget &gt; 12.0) | ~$isTargetAlive | ~$stanceValid">
                                                                            <Fail />
                                                                        </IfCondition>
                                                                    </Sequence>
                                                                </Loop>
                                                            </Parallel>
                                                        </SuppressFailure>
                                                    </Then>
                                                    <Else canSkip="1">
                                                        <!-- Stand and fire, vanilla standFire style -->
                                                        <SuppressFailure>
                                                            <Parallel successMode="Any" failureMode="Any">
                                                                <AnyDecorator preset="crime_keepStateAndItems">
                                                                    <MeleeOffenseAutomationDecorator active="true">
                                                                        <WeaponAutomationDecorator WeaponChange="missile" active="true">
                                                                            <CombatAction TargetNPC="$attackData.target" RelationOverride="Hostile" />
                                                                        </WeaponAutomationDecorator>
                                                                    </MeleeOffenseAutomationDecorator>
                                                                </AnyDecorator>
                                                                <Loop count="-1">
                                                                    <Sequence>
                                                                        <Wait duration="'700ms'" timeType="GameTime" doFail="false" variation="'200ms'" />
                                                                        <ExecuteLua code="mercenaries:UpdateArcherCombatData(data, entity.this.id, 'skirmish')" />
                                                                        <IfCondition failOnCondition="false" condition="$distanceToTarget &lt; 5.0 | ~$isTargetAlive | ~$stanceValid | $outOfAmmo">
                                                                            <Fail />
                                                                        </IfCondition>
                                                                    </Sequence>
                                                                </Loop>
                                                            </Parallel>
                                                        </SuppressFailure>
                                                    </Else>
                                                </IfElseCondition>
                                            </Sequence>
                                        </Loop>

                                        <!-- Leash + self-preservation watchdog -->
                                        <Loop count="-1">
                                            <Sequence>
                                                <ExecuteLua code="
                                                    pcall(function()
                                                        if player then
                                                            local pp = player:GetPos()
                                                            local mp = entity:GetPos()
                                                            if pp and mp then
                                                                local dx = pp.x - mp.x
                                                                local dy = pp.y - mp.y
                                                                local dz = pp.z - mp.z
                                                                data.distanceToPlayer = math.sqrt(dx*dx + dy*dy + dz*dz)
                                                            end
                                                        end
                                                        local hp = entity.soul:GetState('health')
                                                        data.myHealthCritical = (hp ~= nil and hp &lt;= 15)
                                                    end)
                                                " />
                                                <IfCondition failOnCondition="false" condition="$distanceToPlayer &gt; 40.0 | $myHealthCritical">
                                                    <Fail />
                                                </IfCondition>
                                                <Wait duration="'2s'" timeType="GameTime" doFail="false" variation="'500ms'" />
                                            </Sequence>
                                        </Loop>

                                    </Parallel>
                                </Child>

                                <OnFail canSkip="1">
                                    <Sequence>
                                        <ExecuteLua code="pcall(function() entity.soul:SetTarget(nil) end); pcall(function() entity.human:DrawWeapon(false) end); pcall(function() mercenaries.MercTargetOf[tostring(entity.this.id)] = nil end)" />
                                        <Wait duration="'1s'" timeType="GameTime" doFail="false" variation="" />
                                    </Sequence>
                                </OnFail>
                            </FuseBox>
                        </EntityContext>
                    </EntityContextElement>
                </EntityContext>
            </Behavior>
        </Root>
    </BehaviorTree>
</BehaviorTrees>
