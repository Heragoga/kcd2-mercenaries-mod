<?xml version="1.0" encoding="us-ascii"?>
<BehaviorTrees>
    <!-- Static archer brain. Same shape as enemy_melee_scheduler (its own switch that
         scans for a target and fires an attack interrupt) rather than the archer
         one, because a static archer must never follow, patrol or camp - it stands
         where it was placed and shoots. Who it shoots is decided entirely in Lua
         by its per-archer mode (mercenaries:FindStaticArcherTarget); see
         mercenaries_static_archer.lua. -->
    <BehaviorTree name="onUpdate" is_function="0">
        <Variables>
            <Variable name="playerWUID" type="_wuid" values="" isPersistent="0" form="single" />
            <Variable name="playerCombatTarget" type="_wuid" values="" isPersistent="0" form="single" />
            <!-- Gate for the GetTarget on the PLAYER below. Written by MercLeashes off the
                 combat scan's own threat flag - see the note there: the node cannot resolve
                 the player as an NPC host, so unguarded it is a failed engine lookup on every
                 poll of every merc. -->
            <Variable name="playerFighting"      type="_bool"                values="false"                             isPersistent="0" form="single" />
            <Variable name="currentTarget" type="_wuid" values="" isPersistent="0" form="single" />
            <!-- Target the running (never-ending) combat was last aimed at. The
                 combat behaviour never ends on its own, so re-targeting happens
                 here: when FindStaticArcherTarget switches targets, re-fire with
                 the new one, replacing the old instance (IgnorePriorityOnPreviousInterrupt). -->
            <Variable name="firedTarget" type="_wuid" values="" isPersistent="0" form="single" />
            <Variable name="inCombat" type="_bool" values="false" isPersistent="0" form="single" />

            <Variable name="attackData" type="switch:interruptData:attack" values="" isPersistent="0" form="single" />
            <Variable name="crimeInformation" type="information" values="" isPersistent="0" form="single" />
            <Variable name="mrkev" type="_wuid" values="" isPersistent="0" form="single" />
        </Variables>
        <Root OneTimeOnly="false" FailState="Recoverable" saveVersion="2">
            <Behavior canSkip="1">
                <SuppressFailure>
                    <Parallel successMode="Any" failureMode="Any">

                        <Loop count="-1">
                            <Sequence>
                                <EntityContextCheck context="crime_interruptAttack" target="$this.id" saveVersion="2">
                                    <Then canSkip="1">
                                        <Expression expressions="$inCombat = true" />
                                    </Then>
                                    <Else canSkip="1">
                                        <Expression expressions="$inCombat = false" />
                                    </Else>
                                </EntityContextCheck>
                                <!-- 500ms tracker (match the fire loop) so a just-started burst is not re-fired/replaced before inCombat updates. -->
                                <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'200ms'" />
                            </Sequence>
                        </Loop>

                        <Loop count="-1">
                            <Sequence>
                                <!-- The player's own combat target, fetched the same way the merc
                                     scheduler does it (only a BT node can). "defend" mode backs the
                                     player up on it, exactly as the mercs' "everyone" stance does. -->
                                <Expression expressions="$playerWUID = $__player &#10; $playerCombatTarget = $__null" />
                                <ExecuteLua code="data.playerFighting = (_G.MercSquadThreat == true)" />
                                <SuppressFailure>
                                    <IfCondition failOnCondition="false" condition="$playerFighting">
                                        <GetTarget ReferenceNPC="$playerWUID" TargetVarOut="$playerCombatTarget" />
                                    </IfCondition>
                                </SuppressFailure>
                                <ExecuteLua code="mercenaries:FindStaticArcherTarget(data, entity.this.id)" />
                                <Wait duration="'1s'" timeType="GameTime" doFail="false" variation="'400ms'" />
                            </Sequence>
                        </Loop>

                        <Loop count="-1">
                            <Sequence>
                                <IfCondition failOnCondition="false" condition="$currentTarget ~= $__null &amp; ($currentTarget ~= $firedTarget | ~$inCombat)">
                                    <Sequence>
                                        <Expression expressions="$playerWUID = $__player" />
                                        <SuppressFailure>
                                            <Function_crime_getMrkev mrkev="$mrkev" nodeLabel="1236" />
                                            <CreateInformationWrapper Label="'assault'" PerceivedWuid="$this.id" PositionType="positionWuid" PositionVec3="" PositionWuid="$currentTarget" Information="$crimeInformation" />
                                            <LockDynamicInformationValues Information="$crimeInformation">
                                                <SetDynamicInformationValue Information="$crimeInformation" Tag="'stimulusKind'" Variable="$enum:crime_stimulusKind.combat" Type="" Value="" />
                                            </LockDynamicInformationValues>
                                            <Function_crime_limits_reserveReactionLink ffCrimeIcon="false" information="$crimeInformation" priority="160" reactionKind="$enum:crime_reactionKind.attack" nodeLabel="898992" />
                                        </SuppressFailure>
                                        <Expression expressions="$attackData.target = $currentTarget &#10; $attackData.information = $crimeInformation &#10; $attackData.stimulusKind = $enum:crime_stimulusKind.combat &#10; $attackData.previousReaction = $enum:crime_reactionKind.unknown &#10; $attackData.initiatedBy = $enum:switch_interruptInitiator.switch &#10; $attackData.defenceMode = false &#10; $attackData.relationOverride = true &#10; $attackData.source = $enum:crime_source.direct &#10; $attackData.freshlyAttributedCrime = false &#10; $attackData.criminalFreshness = $enum:crime_criminalFreshness.unknown &#10; $attackData.escalatedFromFailedSurrender = false" />
                                        <AddInterrupt_attack attackData="$attackData" Target="$this.id" Host="$mrkev" Behavior="'combat_archer_static'" Priority="160" IgnorePriorityOnPreviousInterrupt="true" urgency="Fast" Aliveness="Alive" Privileged="false" FastForward="false" />
                                        <Expression expressions="$firedTarget = $currentTarget &#10; $inCombat = true" />
                                    </Sequence>
                                </IfCondition>
                                <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'200ms'" />
                            </Sequence>
                        </Loop>

                    </Parallel>
                </SuppressFailure>
            </Behavior>
        </Root>
    </BehaviorTree>
</BehaviorTrees>
