<?xml version="1.0" encoding="us-ascii"?>
<BehaviorTrees>
    <!-- Melee combat module: the one melee attack behaviour for every side.
         Target comes entirely from $attackData.target (set by whichever
         scheduler fires it); side differences (leash to the player, stance
         disengage, none of that for enemies) are resolved in Lua by
         UpdateMeleeCombatData from the entity name. Archers fired into melee
         get WeaponChange=melee (sheathe bow, draw sidearm); everyone else
         keeps their weapon. See docs/ai-modules.md. -->
    <BehaviorTree name="combat_melee" is_function="0">
        <Variables>
            <Variable name="automation_defense" type="_bool" values="true" isPersistent="0" form="single" />
            <Variable name="automation_guard" type="_bool" values="true" isPersistent="0" form="single" />
            <Variable name="automation_movement" type="_bool" values="true" isPersistent="0" form="single" />
            <Variable name="automation_offense" type="_bool" values="true" isPersistent="0" form="single" />
            <Variable name="automation_weapon" type="_bool" values="true" isPersistent="0" form="single" />
            <!-- melee (not none): actively DRAW the melee weapon. A freshly spawned,
                 instantly-aggressive enemy races equip-vs-combat and a passive
                 (none) draw loses that race - the NPC swings with fists for a few
                 seconds until the offense automation gets around to it, or (worse)
                 never draws at all. melee makes the WeaponAutomationDecorator own
                 the draw, so weapons come out immediately. Mercs follow before they
                 fight, so their weapon has already settled; this is just as safe for
                 them. Archers fired into melee also want their sidearm drawn. -->
            <Variable name="weaponChange" type="enum:weaponChange" values="$enum:weaponChange.melee" isPersistent="0" form="single" />
            <Variable name="guardMode" type="enum:combatAutomationGuardMode" values="$enum:combatAutomationGuardMode.automate" isPersistent="0" form="single" />

            <Variable name="isTargetAlive" type="_bool" values="true" isPersistent="0" form="single" />
            <Variable name="disengage" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="isArcher" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="isEnemy" type="_bool" values="false" isPersistent="0" form="single" />
            <!-- False when the weapon is already drawn, so a re-fire of this behaviour
                 does not replay the draw animation and stop the NPC mid-approach. -->
            <Variable name="needsDraw" type="_bool" values="true" isPersistent="0" form="single" />
        </Variables>
        <Parameters>
            <Variable name="attackData" type="switch:interruptData:attack" values="" isPersistent="0" form="single" requirementType="In" />
        </Parameters>
        <Root OneTimeOnly="false" FailState="Recoverable" saveVersion="2">
            <Behavior canSkip="1">
                <EntityContext context="crime_preventDespawn" target="">
                    <EntityContextElement context="crime_interrupt" enabled="true">
                        <EntityContext context="crime_interruptAttack" target="$this.id">
                            <FuseBox StatusPropagation="Child" OneCleanup="true" saveVersion="2">
                                <Child canSkip="1">
                                    <Sequence>
                                        <!-- weaponChange defaults to melee for everyone (draws the melee
                                             weapon / an archer's sidearm), so nothing to set here. -->
                                        <ExecuteLua code="mercenaries:UpdateMeleeCombatData(data, entity.this.id)" />

                                        <!-- Enemies engage the instant they spawn, so the weapon-automation
                                             draw occasionally still loses the race and they charge in with
                                             fists for a moment. An explicit draw first (melee fighters only)
                                             gets the weapon out before the approach. Mercs follow before they
                                             fight, so their weapon is long settled - they skip this and keep
                                             their draw-while-charging (no engage delay).
                                             needsDraw: skip it when the weapon is ALREADY out. This is a
                                             full animation that stops the NPC where he stands, and it is
                                             replayed every time this behaviour is re-fired - so on a
                                             scheduler that re-fires at all often it reads as a pause every
                                             time, in the middle of the approach. -->
                                        <IfCondition failOnCondition="false" condition="$isEnemy &amp; ~$isArcher &amp; $needsDraw">
                                            <SuppressFailure>
                                                <DrawAction WeaponSet="Primary" fullBody="false" tags="" />
                                            </SuppressFailure>
                                        </IfCondition>

                                        <Parallel successMode="Any" failureMode="Any">

                                            <!-- Node for node vanilla's own NPC-vs-NPC melee,
                                                 references/AI/crime/friendlyFight.xml. Three things here
                                                 were all wrong at once and together made an approaching
                                                 fighter close in visible steps - step, pause, step. Proven
                                                 out on foe_combat.xml first; see docs/foe-ai.md.

                                                 1. CombatMoveDecorator is what puts the NPC into COMBAT
                                                    LOCOMOTION. It was missing everywhere in this mod.
                                                 2. MoveParamsDecorator must NOT wrap this chain. Vanilla
                                                    never puts one outside CombatFollowerDecorator and
                                                    mostly has none at all; CombatMoveDecorator replaces it.
                                                 3. CombatAction takes NO re-issue Loop. It is a continuous
                                                    whole-fight action - under the offense/weapon
                                                    automation it closes, swings and keeps swinging until
                                                    the target is down. An outer Loop rebuilt this whole
                                                    chain every time it returned, so the weapon automation
                                                    lowered and re-raised the weapon each cycle.

                                                 The liveness/disengage test that used to sit in here has
                                                 gone with the Loop: the watchdog below already tests
                                                 exactly the same condition on a timer, and IS the exit. -->
                                            <CombatMoveDecorator>
                                                <MeleeOffenseAutomationDecorator active="$automation_offense">
                                                    <MeleeDefenseAutomationDecorator active="$automation_defense">
                                                        <MeleeGuardAutomationDecorator GuardMode="$guardMode" active="$automation_guard">
                                                            <WeaponAutomationDecorator WeaponChange="$weaponChange" active="$automation_weapon">
                                                                <CombatFollowerDecorator ProbablisticDrivenSweetSpot="true" RPGSweetSpotArcDriver="true" active="$automation_movement">
                                                                    <CombatAction TargetNPC="$attackData.target" RelationOverride="Hostile" />
                                                                </CombatFollowerDecorator>
                                                            </WeaponAutomationDecorator>
                                                        </MeleeGuardAutomationDecorator>
                                                    </MeleeDefenseAutomationDecorator>
                                                </MeleeOffenseAutomationDecorator>
                                            </CombatMoveDecorator>

                                            <!-- Watchdog: disengage covers the per-side leash / stance /
                                                 critical-health rules (Lua decides; enemies never leash).
                                                 ~isTargetAlive is here too. Since the combat arm above is
                                                 now a bare continuous CombatAction with no test of its
                                                 own, this is the ONLY exit for every side - it ends the
                                                 fight within ~1.7s of the target going down or the leash
                                                 being crossed.
                                                 Confirmed on a second read 400ms later - UpdateMeleeCombatData
                                                 defaults isTargetAlive to false and only sets it after a
                                                 successful WUID lookup inside a pcall, so one hiccup reads as
                                                 death. Two reads cap the exit at ~1.7s with no false trip. -->
                                            <Loop count="-1">
                                                <Sequence>
                                                    <Wait duration="'1s'" timeType="GameTime" doFail="false" variation="'300ms'" />
                                                    <ExecuteLua code="mercenaries:UpdateMeleeCombatData(data, entity.this.id)" />
                                                    <IfCondition failOnCondition="false" condition="$disengage | ~$isTargetAlive">
                                                        <Sequence>
                                                            <Wait duration="'400ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                                            <ExecuteLua code="mercenaries:UpdateMeleeCombatData(data, entity.this.id)" />
                                                            <IfCondition failOnCondition="false" condition="$disengage | ~$isTargetAlive">
                                                                <Fail />
                                                            </IfCondition>
                                                        </Sequence>
                                                    </IfCondition>
                                                </Sequence>
                                            </Loop>

                                        </Parallel>
                                    </Sequence>
                                </Child>

                                <OnFail canSkip="1">
                                    <Sequence>
                                        <!-- The sheathe is gated on ~isEnemy. A merc leaving a fight is
                                             done fighting and must put his weapon away (without this he
                                             stands around in camp with his sword out). An enemy or patrol
                                             is NOT done: he has no leash, so the only way he gets here is
                                             his target dying, and he will be handed another within a
                                             second. Sheathing him meant every re-fire cost a sheathe AND
                                             a re-draw - which is what still made convoy fighters close in
                                             steps after the draw was already made conditional. foe_combat
                                             never sheathes for the same reason. See docs/foe-ai.md. -->
                                        <ExecuteLua code="pcall(function() entity.soul:SetTarget(nil) end); pcall(function() if not data.isEnemy then entity.human:DrawWeapon(false) end end); pcall(function() mercenaries:ClearCombatClaim(entity.this.id) end)" />
                                        <!-- This Wait sits INSIDE the crime_interruptAttack context opened at
                                             the top of this tree, which every scheduler reads as $inCombat -
                                             so it is added directly to the dead time before locomotion can
                                             re-fire. 300ms matches the 300ms CombatScanLoop, so a corpse still
                                             leaves CachedEnemies before re-acquisition can see it. Do NOT drop
                                             the cleanup Lua above with it: without it mercs stand around with
                                             their sword out, and ClearCombatClaim is what frees the swarm cap. -->
                                        <Wait duration="'300ms'" timeType="GameTime" doFail="false" variation="" />
                                    </Sequence>
                                </OnFail>
                            </FuseBox>
                        </EntityContext>
                    </EntityContextElement>
                </EntityContext>
            </Behavior>
        </Root>
    </BehaviorTree>
</BehaviorTrees>
