<?xml version="1.0" encoding="utf-8"?>
<Database xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Name="brambora">
	<Skald>
		<Level Name="kutnohorsko" HibernateMode="Auto" VoiceNamespace="false">
			<Definitions>
				<Definition File="kutnohorsko/mercenaries_background_quest.xml" />
				<Definition File="kutnohorsko/bandit_camp_quest.xml" />
				<Definition File="kutnohorsko/bounty_quest.xml" />
			</Definitions>
			<Nodes>
				<mercenaries_background_quest Name="mercenaries_background_quest" RequiredForOutput="kutnohorsko">
					<Edge From="OnWake" To="run" />
				</mercenaries_background_quest>
				<!-- Always awake, like the background quest: its own item triggers decide
				     when the journal entry actually appears. -->
				<bandit_camp_quest Name="bandit_camp_quest" RequiredForOutput="kutnohorsko">
					<Edge From="OnWake" To="run" />
				</bandit_camp_quest>
				<!-- The repeatable bounty. Kuttenberg only - Trosky has no authored camps, so
				     trosecko.xml deliberately does not register it. -->
				<bounty_quest Name="bounty_quest" RequiredForOutput="kutnohorsko">
					<Edge From="OnWake" To="run" />
				</bounty_quest>
			</Nodes>
			<Text Text="kutnohorsko" />
		</Level>
	</Skald>
</Database>
