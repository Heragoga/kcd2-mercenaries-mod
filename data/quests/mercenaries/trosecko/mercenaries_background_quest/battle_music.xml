<?xml version="1.0" encoding="utf-8"?>
<!-- Battle music for camp raids.

     KCD2 drives music from named states, switched by a SkaldBoxProbe whose IsActive is a
     Skald bool (see the main quests, e.g. utokNaMalesov .../tvrz/hudba.xml, which toggles
     STORY_M44B_ATTACK_PHASE_1/2 the same way).

     Lua has no way to set a Skald bool, so the bridge is an item: the wall-battle phase
     machine puts one token in the player's pocket when a fight opens and takes it away
     when it ends (WBMusic). utils.item.itemclasstrigger_playerinventory reports acquire
     and loss, a Tribool holds that between the two, and the probes read it.

     SEVERAL toggles are raised together on purpose. Which state name actually produces
     the battle theme could not be verified outside the game, so this fires the ones the
     main quests use for exactly this situation. Once one is confirmed in play, delete the
     others - leaving them all raised is a shotgun, not a design. -->
<Database xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Name="brambora">
    <Skald>
        <Module Name="battle_music">
            <Nodes>
                <itemclasstrigger_playerinventory Name="musicToken" PositionY="0" PositionX="0" Namespace="utils.item">
                    <Constant Name="itemclass" Value="679a655e-189d-4519-b437-ccc4b92be81d" />
                    <Constant Name="amount" Value="1" />
                    <Constant Name="isactive" Value="true" />
                </itemclasstrigger_playerinventory>

                <State Name="battleRunning" PositionY="0" PositionX="400" TypeT="Tribool">
                    <Edge From="musicToken.ontargetamountacquire" To="SetTrue" />
                    <Edge From="musicToken.onacquire" To="SetTrue" />
                    <Edge From="musicToken.onlose" To="SetFalse" />
                    <Edge From="musicToken.onafterlose" To="SetFalse" />
                </State>

                <SkaldBoxProbe Name="musicSkirmish" PositionY="-200" PositionX="800">
                    <Constant Name="Toggle" Value="SKIRMISH_FRIENDLY" />
                    <Edge From="battleRunning.True" To="IsActive" />
                </SkaldBoxProbe>
                <SkaldBoxProbe Name="musicCourtyard" PositionY="0" PositionX="800">
                    <Constant Name="Toggle" Value="STORY_M51_BATTLE_6_COURTYARD" />
                    <Edge From="battleRunning.True" To="IsActive" />
                </SkaldBoxProbe>
                <SkaldBoxProbe Name="musicAttack" PositionY="200" PositionX="800">
                    <Constant Name="Toggle" Value="STORY_M44B_ATTACK_PHASE_2" />
                    <Edge From="battleRunning.True" To="IsActive" />
                </SkaldBoxProbe>
            </Nodes>
            <Text StringName="battle_music_mercs" Text="Battle music" />
        </Module>
    </Skald>
</Database>
