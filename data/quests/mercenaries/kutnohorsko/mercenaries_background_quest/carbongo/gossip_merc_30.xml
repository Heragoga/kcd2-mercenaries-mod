                <SelectedSouls>
                    <SelectedSoul Role="GOSSIP_OBECNY_MUZ_1" Voice="jcom" Type="Wave" Language="ENG" />
                    <SelectedSoul Role="GOSSIP_OBECNY_MUZ_2" Voice="phos2" Type="Wave" Language="ENG" />
                </SelectedSouls>
                <Decision Name="dec_gossip_merc_30" Priority="General" Autoselect="true" VoiceoverFallbackLevel="2" VoiceoverFallbackLevelRoles="GOSSIP_OBECNY_MUZ_1 GOSSIP_OBECNY_MUZ_2" Alias="merc_gossip_30">
                    <Sequences>
                        <Sequence EndType="EndDialogue" Cooldown="10m" Name="seq_gossip_merc_30">
                            <DesignName StringName="gossip_merc_30_name" Text="Two Old Hands" />
                            <Elements>
                                <Response Role="GOSSIP_OBECNY_MUZ_1" ReferenceLength="3"><Text StringName="s_ce_raubritte_je_to_chla_5lAX" Text="He's a mountain of a man, a hell of a warrior. And everyone knows it." /></Response>
                                <Response Role="GOSSIP_OBECNY_MUZ_2" ReferenceLength="3"><Text StringName="tlam_jan_tlama_ten_starej_UGns" Text="That old git..." /></Response>
                                <Response Role="GOSSIP_OBECNY_MUZ_1" ReferenceLength="3"><Text StringName="s_ce_raubritte_sedm_zkuse_4Zw7" Text="Seven of our most experienced. And well armed." /></Response>
                                <Response Role="GOSSIP_OBECNY_MUZ_2" ReferenceLength="3"><Text StringName="tlam_jan_tlama_poslednich_U21j" Text="Aye, there were some sort of guards." /></Response>
                                <Response Role="GOSSIP_OBECNY_MUZ_1" ReferenceLength="3"><Text StringName="s_ce_raubritte_nevim_ale__zjs9" Text="No idea. But they're no ordinary thieves. They don't care about the silver." /></Response>
                                <Response Role="GOSSIP_OBECNY_MUZ_2" ReferenceLength="3"><Text StringName="tlam_jan_tlama_jeden_z_my_UBIc" Text="One of my men followed them all the way to their camp. Here in the cliffs over the pond." /></Response>
                                <Response Role="GOSSIP_OBECNY_MUZ_2" ReferenceLength="3"><Text StringName="tlam_jan_tlama_takze_ho_s_JHPe" Text="So Semine got to him after all. Well... it was to be expected. I had the feeling that the time would come when we'd be standing on opposite sides." /></Response>
                                <Response Role="GOSSIP_OBECNY_MUZ_1" ReferenceLength="3"><Text StringName="s_ce_raubritte_mam_toho_c_YIDO" Text="I truly like the man." /></Response>
                            </Elements>
                        </Sequence>
                    </Sequences>
                </Decision>
            </Dialogue>
