                <Decision Name="dec_gossip_merc_14" Priority="General" Autoselect="true" VoiceoverFallbackLevel="2" VoiceoverFallbackLevelRoles="GOSSIP_OBECNY_MUZ_1 GOSSIP_OBECNY_MUZ_2" Alias="merc_gossip_14">
                    <Sequences>
                        <Sequence EndType="EndDialogue" Cooldown="10m" Name="seq_gossip_merc_14">
                            <DesignName StringName="gossip_merc_14_name" Text="The Leaky Roof" />
                            <Elements>
                                <Response Role="GOSSIP_OBECNY_MUZ_1" ReferenceLength="3"><Text StringName="goss_gossip_v__ja_uz_ti_n_ukOE" Text="I don't know what to do. It's already leaking into my room. I need to redo that roof from scratch." /></Response>
                                <Response Role="GOSSIP_OBECNY_MUZ_2" ReferenceLength="3"><Text StringName="goss_gossip_v__to_at_ti_t_zroB" Text="You're better off with a leaky roof." /></Response>
                                <Response Role="GOSSIP_OBECNY_MUZ_1" ReferenceLength="3"><Text StringName="goss_gossip_v__nemusi_ale_M4Xz" Text="They don't! But your carpenters blow me off. Beranek from Pacha promised me he'd come take a look and he didn't." /></Response>
                                <Response Role="GOSSIP_OBECNY_MUZ_1" ReferenceLength="3"><Text StringName="goss_gossip_v__penize_mam_R2La" Text="I have money, but we don't have any carpenters in our community." /></Response>
                                <Response Role="GOSSIP_OBECNY_MUZ_1" ReferenceLength="3"><Text StringName="goss_gossip_v__nejakej_si_dVXN" Text="Simon? I tried him, but he has work for three years in advance. He's young and skilful." /></Response>
                                <Response Role="GOSSIP_OBECNY_MUZ_2" ReferenceLength="3"><Text StringName="goss_gossip_v__tak_prece__xbV4" Text="Well, he's not going to sleep in a house where the roof leaks, that's for certain." /></Response>
                            </Elements>
                        </Sequence>
                    </Sequences>
