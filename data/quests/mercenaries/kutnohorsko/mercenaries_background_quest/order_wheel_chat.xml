                                                <Elements><Response Role="role_mercenary_test" /></Elements>
                                            </Sequence>
                                            <Sequence EndType="Decision" ChatPosition="Fourth" Name="seq_wheel_formation_more">
                                                <UiPrompt StringName="ui_merc_wheel_more" />
                                                <Elements><Response Role="role_mercenary_test" /></Elements>

                                                <Decision Name="dec_wheel_formation2" Priority="General" TimeLimit="0">
                                                    <Sequences>
                                                    <Sequence EndType="EndDialogue" ChatPosition="First" Name="seq_wheel_formation_wedge">
                                                        <UiPrompt StringName="ui_merc_formation_wedge" />
                                                        <Triggers><Port Name="formation_wedge" /></Triggers>
                                                        <Elements><Response Role="role_mercenary_test" /></Elements>
                                                    </Sequence>
                                                    <Sequence EndType="EndDialogue" ChatPosition="Second" Name="seq_wheel_formation_circle">
                                                        <UiPrompt StringName="ui_merc_formation_circle" />
                                                        <Triggers><Port Name="formation_circle" /></Triggers>
                                                        <Elements><Response Role="role_mercenary_test" /></Elements>
                                                    </Sequence>
                                                    <Sequence EndType="EndDialogue" ChatPosition="Third" Name="seq_wheel_formation_escort">
                                                        <UiPrompt StringName="ui_merc_formation_escort" />
                                                        <Triggers><Port Name="formation_escort" /></Triggers>
                                                        <Elements><Response Role="role_mercenary_test" /></Elements>
                                                    </Sequence>
                                                    <Sequence EndType="EndDialogue" ChatPosition="Refusal" Name="seq_wheel_formation_cancel2">
                                                        <Elements><Response Role="HENRY" /></Elements>
                                                    </Sequence>
                                                    </Sequences>
                                                </Decision>
                                            </Sequence>
                                            <Sequence EndType="EndDialogue" ChatPosition="Refusal" Name="seq_wheel_formation_cancel">
                                                <Elements><Response Role="HENRY" /></Elements>
                                            </Sequence>
                                            </Sequences>
                                        </Decision>
                                    </Sequence>

                                    <Sequence EndType="Decision" ChatPosition="Fourth" Name="seq_wheel_equipment_hub">
                                        <UiPrompt StringName="ui_merc_wheel_equipment" />
                                        <Elements><Response Role="role_mercenary_test" /></Elements>

                                        <!-- Equipment: 3 siblings, same split as
                                             dismissal_dialog's own equipment hub -
                                             uniform, melee loadout, archer weapon. -->
                                        <Decision Name="dec_wheel_equipment" Priority="General" TimeLimit="0">
                                            <Sequences>

                                                <Sequence EndType="Decision" ChatPosition="First" Name="seq_wheel_change_equipment">
                                                    <UiPrompt StringName="ui_mercenary_change_equipment" />
                                                    <Elements><Response Role="role_mercenary_test" /></Elements>

                                                    <!-- 6 outfits, paginated 3+3. -->
                                                    <Decision Name="dec_wheel_outfit" Priority="General" TimeLimit="0">
                                                        <Sequences>
                                                            <Sequence EndType="EndDialogue" ChatPosition="First" Name="seq_wheel_equip_generic">
                                                                <UiPrompt StringName="ui_merc_equip_gen" />
                                                                <Triggers><Port Name="order_equip_generic" /></Triggers>
                                                                <Elements><Response Role="role_mercenary_test" /></Elements>
                                                            </Sequence>
                                                            <Sequence EndType="EndDialogue" ChatPosition="Second" Name="seq_wheel_equip_bandits">
                                                                <UiPrompt StringName="ui_merc_equip_ban" />
                                                                <Triggers><Port Name="order_equip_bandits" /></Triggers>
                                                                <Elements><Response Role="role_mercenary_test" /></Elements>
                                                            </Sequence>
                                                            <Sequence EndType="EndDialogue" ChatPosition="Third" Name="seq_wheel_equip_cumans">
                                                                <UiPrompt StringName="ui_merc_equip_cum" />
                                                                <Triggers><Port Name="order_equip_cumans" /></Triggers>
                                                                <Elements><Response Role="role_mercenary_test" /></Elements>
                                                            </Sequence>
                                                            <Sequence EndType="Decision" ChatPosition="Fourth" Name="seq_wheel_outfit_more">
                                                                <UiPrompt StringName="ui_merc_wheel_more" />
                                                                <Elements><Response Role="role_mercenary_test" /></Elements>

                                                                <Decision Name="dec_wheel_outfit_more" Priority="General" TimeLimit="0">
                                                                    <Sequences>
                                                                        <Sequence EndType="EndDialogue" ChatPosition="First" Name="seq_wheel_equip_leipa">
                                                                            <UiPrompt StringName="ui_merc_equip_lei" />
                                                                            <Triggers><Port Name="order_equip_leipa" /></Triggers>
                                                                            <Elements><Response Role="role_mercenary_test" /></Elements>
                                                                        </Sequence>
                                                                        <Sequence EndType="EndDialogue" ChatPosition="Second" Name="seq_wheel_equip_kuttenberg">
                                                                            <UiPrompt StringName="ui_merc_equip_kut" />
                                                                            <Triggers><Port Name="order_equip_kuttenberg" /></Triggers>
                                                                            <Elements><Response Role="role_mercenary_test" /></Elements>
                                                                        </Sequence>
                                                                        <Sequence EndType="EndDialogue" ChatPosition="Third" Name="seq_wheel_equip_skalitz">
                                                                            <UiPrompt StringName="ui_merc_equip_ska" />
                                                                            <Triggers><Port Name="order_equip_skalitz" /></Triggers>
                                                                            <Elements><Response Role="role_mercenary_test" /></Elements>
                                                                        </Sequence>
                                                                        <Sequence EndType="EndDialogue" ChatPosition="Refusal" Name="seq_wheel_outfit_more_cancel">
                                                                            <Elements><Response Role="HENRY" /></Elements>
                                                                        </Sequence>
                                                                    </Sequences>
                                                                </Decision>
                                                            </Sequence>
                                                            <Sequence EndType="EndDialogue" ChatPosition="Refusal" Name="seq_wheel_outfit_cancel">
                                                                <Elements><Response Role="HENRY" /></Elements>
                                                            </Sequence>
                                                        </Sequences>
                                                    </Decision>
                                                </Sequence>

                                                <Sequence EndType="Decision" ChatPosition="Second" Name="seq_wheel_change_gear">
                                                    <UiPrompt StringName="ui_mercenary_change_weapon" />
                                                    <Elements><Response Role="role_mercenary_test" /></Elements>

                                                    <!-- 9 melee loadouts, paginated 3+3+3. -->
                                                    <Decision Name="dec_wheel_melee" Priority="General" TimeLimit="0">
                                                        <Sequences>
                                                            <Sequence EndType="EndDialogue" ChatPosition="First" Name="seq_wheel_weapon_random">
                                                                <UiPrompt StringName="ui_merc_weapon_random" />
                                                                <Triggers><Port Name="order_weapon_random" /></Triggers>
                                                                <Elements><Response Role="role_mercenary_test" /></Elements>
                                                            </Sequence>
                                                            <Sequence EndType="EndDialogue" ChatPosition="Second" Name="seq_wheel_weapon_swordshield">
