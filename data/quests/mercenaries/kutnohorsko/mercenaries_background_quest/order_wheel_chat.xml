                                                                <Elements><Response Role="role_mercenary_test" /></Elements>

                                                                <Decision Name="dec_wheel_melee_more" Priority="General" TimeLimit="0">
                                                                    <Sequences>
                                                                        <Sequence EndType="EndDialogue" ChatPosition="First" Name="seq_wheel_weapon_longsword">
                                                                            <UiPrompt StringName="ui_merc_weapon_longsword" />
                                                                            <Triggers><Port Name="order_weapon_longsword" /></Triggers>
                                                                            <Elements><Response Role="role_mercenary_test" /></Elements>
                                                                        </Sequence>
                                                                        <Sequence EndType="EndDialogue" ChatPosition="Second" Name="seq_wheel_weapon_maceshield">
                                                                            <UiPrompt StringName="ui_merc_weapon_maceshield" />
                                                                            <Triggers><Port Name="order_weapon_maceshield" /></Triggers>
                                                                            <Elements><Response Role="role_mercenary_test" /></Elements>
