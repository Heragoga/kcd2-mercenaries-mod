                                            </Sequence>
                                            </Sequences>
                                        </Decision>
                                    </Sequence>

                                    <Sequence EndType="Decision" ChatPosition="Second" Name="seq_wheel_camp_hub">
                                        <UiPrompt StringName="ui_mercenary_camp_hub" />
                                        <Elements><Response Role="role_mercenary_test" /></Elements>

                                        <Decision Name="dec_wheel_camp" Priority="General" TimeLimit="0">
                                            <Sequences>
                                                <Sequence EndType="EndDialogue" ChatPosition="First" Name="seq_wheel_camp_make">
                                                    <UiPrompt StringName="ui_mercenary_camp_make" />
