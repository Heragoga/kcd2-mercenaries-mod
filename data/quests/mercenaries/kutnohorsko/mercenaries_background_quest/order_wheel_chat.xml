<?xml version="1.0" encoding="utf-8"?>
<Database xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Name="brambora">
    <Skald>
        <!-- Silent squad-order wheel, modelled on Mutt's command menu
             (vanilla open_world/dog/chat/ovladani_chatem.xml). Hold the chat key
             while looking at a merc and the options appear without a dialog
             camera or a spoken line - see docs/order-wheel.md.

             Type="chat" + Initiator="Player" is what makes it a wheel instead of
             a dialog; ForceMood="noScope" keeps the camera free; responses with
             no <Text> keep it silent. A chat Decision only has four real
             ChatPositions (First..Fourth) plus Refusal, so anything with more
             options than that (outfits, weapon loadouts) is paginated behind a
             "More options..." leaf rather than crammed into one screen.

             Reuses dismissal_dialog's own option labels (ui_merc_equip_*,
             ui_merc_weapon_*, ui_archer_weapon_*, ...) so no new translation
             work is needed beyond the handful of hub labels below. Reuses its
             tokens too - every leaf here fires the SAME Out-port-driven token
             the E-dialog already uses, wired via extra <Edge> entries in
             mercenaries_background_quest.xml - so this file adds no new Lua
             and no new item classes.

             Refusal always closes the whole wheel (matches vanilla Mutt) - it
             does not step back one level, so treat it as "never mind", not
             "back". -->
        <Dialog Name="order_wheel_chat">
            <Ports>
                <Port Name="order_follow" Direction="Out" Type="trigger" />
                <Port Name="order_wait" Direction="Out" Type="trigger" />
                <Port Name="order_status" Direction="Out" Type="trigger" />
                <Port Name="order_focus" Direction="Out" Type="trigger" />
                <Port Name="order_escort" Direction="Out" Type="trigger" />
                <Port Name="engage_default" Direction="Out" Type="trigger" />
                <Port Name="engage_aggressive" Direction="Out" Type="trigger" />
                <Port Name="engage_defend" Direction="Out" Type="trigger" />
                <Port Name="engage_hold" Direction="Out" Type="trigger" />
                <Port Name="aggro_tight" Direction="Out" Type="trigger" />
                <Port Name="aggro_balanced" Direction="Out" Type="trigger" />
                <Port Name="aggro_loose" Direction="Out" Type="trigger" />

                <Port Name="formation_column" Direction="Out" Type="trigger" />
                <Port Name="formation_line" Direction="Out" Type="trigger" />
                <Port Name="formation_square" Direction="Out" Type="trigger" />
                <Port Name="formation_wedge" Direction="Out" Type="trigger" />
                <Port Name="formation_circle" Direction="Out" Type="trigger" />
                <Port Name="formation_escort" Direction="Out" Type="trigger" />

                <Port Name="order_camp_make" Direction="Out" Type="trigger" />
                <Port Name="order_camp_break" Direction="Out" Type="trigger" />

                <Port Name="order_equip_generic" Direction="Out" Type="trigger" />
                <Port Name="order_equip_bandits" Direction="Out" Type="trigger" />
                <Port Name="order_equip_cumans" Direction="Out" Type="trigger" />
                <Port Name="order_equip_leipa" Direction="Out" Type="trigger" />
                <Port Name="order_equip_kuttenberg" Direction="Out" Type="trigger" />
                <Port Name="order_equip_skalitz" Direction="Out" Type="trigger" />

                <Port Name="order_weapon_random" Direction="Out" Type="trigger" />
                <Port Name="order_weapon_swordshield" Direction="Out" Type="trigger" />
                <Port Name="order_weapon_axeshield" Direction="Out" Type="trigger" />
                <Port Name="order_weapon_longsword" Direction="Out" Type="trigger" />
                <Port Name="order_weapon_maceshield" Direction="Out" Type="trigger" />
                <Port Name="order_weapon_shortsword" Direction="Out" Type="trigger" />
                <Port Name="order_weapon_mace" Direction="Out" Type="trigger" />
                <Port Name="order_weapon_axe" Direction="Out" Type="trigger" />
                <Port Name="order_weapon_polearm" Direction="Out" Type="trigger" />

                <Port Name="order_archer_weapon_bow" Direction="Out" Type="trigger" />
                <Port Name="order_archer_weapon_crossbow" Direction="Out" Type="trigger" />
                <Port Name="order_archer_weapon_handcannon" Direction="Out" Type="trigger" />
            </Ports>
            <Text StringName="ui_merc_wheel_root" />
            <Dialogue Type="chat" TechnicalStatus="Enabled" Hearing="10" DefaultMaxDistance="10" DefaultChatTimeLimit="0"
                      Initiator="Player" ForceMood="noScope" ClashPriority="OpenWorld" GesturesNotNeeded="true">

                <!-- The opening beat exists only so the merc is a participant
                     from the first frame; both responses are silent. -->
                <Decision Name="dec_wheel_root" Priority="General" Autoselect="true">
                    <Sequences>
                        <Sequence EndType="Decision" Name="seq_wheel_open">
                            <Elements>
                                <Response Role="HENRY" />
                                <Response Role="role_mercenary_test" />
                            </Elements>

                            <!-- Top level: 4 categories - squad orders, camp,
                                 report, equipment - fits First..Fourth exactly. -->
                            <Decision Name="dec_wheel_orders" Priority="General" TimeLimit="0">
                                <Sequences>

                                    <Sequence EndType="Decision" ChatPosition="First" Name="seq_wheel_squad_hub">
                                        <UiPrompt StringName="ui_mercenary_squad_orders_hub" />
                                        <Elements><Response Role="role_mercenary_test" /></Elements>

                                        <Decision Name="dec_wheel_squad" Priority="General" TimeLimit="0">
                                            <Sequences>
                                            <Sequence EndType="EndDialogue" ChatPosition="First" Name="seq_wheel_follow">
                                                <UiPrompt StringName="ui_mercenary_follow_action" />
                                                <Triggers><Port Name="order_follow" /></Triggers>
                                                <Elements><Response Role="role_mercenary_test" /></Elements>
                                            </Sequence>
                                            <Sequence EndType="EndDialogue" ChatPosition="Second" Name="seq_wheel_wait">
                                                <UiPrompt StringName="ui_mercenary_wait_action" />
                                                <Triggers><Port Name="order_wait" /></Triggers>
                                                <Elements><Response Role="role_mercenary_test" /></Elements>
                                            </Sequence>
                                            <Sequence EndType="EndDialogue" ChatPosition="Third" Name="seq_wheel_report">
                                                <UiPrompt StringName="ui_merc_wheel_report" />
                                                <Triggers><Port Name="order_status" /></Triggers>
                                                <Elements><Response Role="role_mercenary_test" /></Elements>
                                            </Sequence>
                                            <!-- Fighting orders. The chat menu holds four options plus the
                                                 refusal, so the combat side lives one level down rather than
                                                 displacing follow/wait/report. -->
                                            <Sequence EndType="Decision" ChatPosition="Fourth" Name="seq_wheel_fight_hub">
                                                <UiPrompt StringName="ui_merc_wheel_fight" />
                                                <Elements><Response Role="role_mercenary_test" /></Elements>

                                                <Decision Name="dec_wheel_fight" Priority="General" TimeLimit="0">
                                                    <Sequences>

                                                        <Sequence EndType="Decision" ChatPosition="First" Name="seq_wheel_engage_hub">
                                                            <UiPrompt StringName="ui_merc_wheel_engage" />
                                                            <Elements><Response Role="role_mercenary_test" /></Elements>

                                                            <Decision Name="dec_wheel_engage" Priority="General" TimeLimit="0">
                                                                <Sequences>
                                                                    <Sequence EndType="EndDialogue" ChatPosition="First" Name="seq_wheel_engage_default">
                                                                        <UiPrompt StringName="ui_merc_engage_default" />
                                                                        <Triggers><Port Name="engage_default" /></Triggers>
                                                                        <Elements><Response Role="role_mercenary_test" /></Elements>
                                                                    </Sequence>
                                                                    <Sequence EndType="EndDialogue" ChatPosition="Second" Name="seq_wheel_engage_aggressive">
                                                                        <UiPrompt StringName="ui_merc_engage_aggressive" />
                                                                        <Triggers><Port Name="engage_aggressive" /></Triggers>
                                                                        <Elements><Response Role="role_mercenary_test" /></Elements>
                                                                    </Sequence>
                                                                    <Sequence EndType="EndDialogue" ChatPosition="Third" Name="seq_wheel_engage_defend">
                                                                        <UiPrompt StringName="ui_merc_engage_defend" />
                                                                        <Triggers><Port Name="engage_defend" /></Triggers>
                                                                        <Elements><Response Role="role_mercenary_test" /></Elements>
                                                                    </Sequence>
                                                                    <Sequence EndType="EndDialogue" ChatPosition="Fourth" Name="seq_wheel_engage_hold">
