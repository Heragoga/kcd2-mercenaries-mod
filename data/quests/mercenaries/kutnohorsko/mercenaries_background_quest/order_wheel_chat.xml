                                                                        <Triggers><Port Name="engage_hold" /></Triggers>
                                                                        <Elements><Response Role="role_mercenary_test" /></Elements>
                                                                    </Sequence>
                                                                    <Sequence EndType="EndDialogue" ChatPosition="Refusal" Name="seq_wheel_engage_cancel">
                                                                        <Elements><Response Role="HENRY" /></Elements>
                                                                    </Sequence>
                                                                </Sequences>
                                                            </Decision>
                                                        </Sequence>

                                                        <Sequence EndType="Decision" ChatPosition="Second" Name="seq_wheel_aggro_hub">
                                                            <UiPrompt StringName="ui_merc_wheel_aggro" />
                                                            <Elements><Response Role="role_mercenary_test" /></Elements>

                                                            <Decision Name="dec_wheel_aggro" Priority="General" TimeLimit="0">
