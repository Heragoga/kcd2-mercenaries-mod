                                                                        <Triggers><Port Name="aggro_loose" /></Triggers>
                                                                        <Elements><Response Role="role_mercenary_test" /></Elements>
                                                                    </Sequence>
                                                                    <Sequence EndType="EndDialogue" ChatPosition="Refusal" Name="seq_wheel_aggro_cancel">
