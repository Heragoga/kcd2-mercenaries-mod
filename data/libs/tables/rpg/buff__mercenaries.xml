        <!-- Static (tower) archer: a fast, deadly marksman. marksmanship is the
             verified lever for an archer's aim speed/steadiness and hit rate (the
             mod's combat tiers use it), cranked hard here; agility and rms*2 push
             his action/handling speed. NOTE: a literal "reload speed x2" stat code
             is not confirmable from the reference data, so marksmanship+agility is
             the working proxy - swap in the real reload code here if found.
             Applied on spawn by mercenaries_static_archer.lua. -->
        <!-- Keep-up: every merc carries this permanently. Dash is the highest RelativeSpeedLimit
             the engine has, so the ONLY way to make a follower faster is to raise his actual
             movement speed. A fully levelled Henry is a little quicker than a base NPC, which is
             why the squad strings out when the player sprints. rms is the movement multiplier
             (the mod's own buffs already use it); mst raises max stamina so a long run does not
             leave them winded. Deliberately modest - this closes a small gap, it does not make
             mercs outrun the player. -->
        <buff buff_class_id="15" buff_exclusivity_id="11" buff_id="e5a10011-2c4b-4e6a-9f01-000000000011" buff_lifetime_id="1" buff_name="merc_keepup_buff"
              buff_params="rms*1.3,mst*1.5"
              duration="-1" implementation="Cpp:Constant" is_persistent="false" />

        <!-- Mounted keep-up, on the HORSE's own soul (not the merc_keepup_buff above - that
             rides on the rider's soul, which does nothing while mounted; the horse carries
             him). Deliberately stronger than the on-foot buff: 1.3x still left mounted
             mercs falling behind in play, so this is tuned higher and kept as its own buff
             so the two can be retuned independently. Applied by
             mercenaries:ApplyKeepUpBuff(horseEnt, mercenaries.HorseKeepUpBuff) from
             follow.xml's horse lifecycle. -->
        <buff buff_class_id="15" buff_exclusivity_id="8" buff_id="e5a10013-2c4b-4e6a-9f01-000000000013" buff_lifetime_id="1" buff_name="merc_horse_keepup_buff"
              buff_params="rms*1.6,mst*2.0"
              duration="-1" implementation="Cpp:Constant" is_persistent="false" />

        <!-- Raborsch garrison archer. They must survive a long assault and chip at it rather
             than delete anyone: hlh*0.2 is a fifth of the damage taken (the 5x health), and
             the marksmanship/rms terms take their output back below an ordinary archer's
             instead of the +40/x2.0 the marksman buff grants. hlh is verified - it is the same
             code the Heinrich buff below documents. -->
        <buff buff_class_id="15" buff_exclusivity_id="6" buff_id="e5a10012-2c4b-4e6a-9f01-000000000012" buff_name="merc_raborsch_defender"
              buff_params="hlh*0.1,slh*0.1,marksmanship-25,rms*0.5"
              buff_lifetime_id="1" duration="-1" implementation="Cpp:Constant" is_persistent="false" />
        <buff buff_class_id="15" buff_exclusivity_id="6" buff_id="e5a10008-2c4b-4e6a-9f01-000000000008" buff_lifetime_id="1" buff_name="merc_static_archer_buff"
              buff_params="marksmanship+40,agility+30,rms*2.0"
              duration="-1" implementation="Cpp:Constant" is_persistent="false" />
        <!-- Heinrich (boss): near-imba combat buff so one Heinrich can wade into
             a group and win. Modelled on vanilla's imba_combat_guy but toned down
             so he is still beatable. Stat codes verified from vanilla buffs:
             srg = stamina regen (x4), mst = max stamina (+50%), src/sco = stamina
             cooldowns (0 = attack relentlessly), hlh/slh = health/stamina damage
             taken (x0.3 = 70% resistance), health+/s = regen in combat. Applied to
             his soul via the perk chain (perk__/perk_buff__/soul2perk__mercenaries). -->
        <buff buff_class_id="15" buff_exclusivity_id="7"
              buff_id="e5a10009-2c4b-4e6a-9f01-000000000009"
              buff_lifetime_id="0" buff_name="heinrich_imba_buff"
              buff_params="strength+40,agility+40,vitality+40,fencing+45,defense+45,weapon_sword+45,weapon_unarmed+40,weapon_large+45,heavy_weapons+40,marksmanship+30,mor+2.5,rms+0.02,hlh*0.3,slh*0.3,srg*4,mst*1.5,src=0,sco=0,health+5/s"
              duration="-1" icon_id="0" implementation="Cpp:Constant" is_persistent="false" />

        <!-- Player-facing status indicators. No buff_params on purpose: these
             only exist to show a HUD/inventory icon, they change nothing.
             Added/removed from Lua - see mercenaries_management.lua.

             Low morale uses the ShortTerm + Cpp:Fading shape (the T2 test): a
             timed buff draws a red countdown ring that drains to grey, which
             reads far better than an untimed icon. duration is a drain rate,
             not how long the state lasts - a week means the ring sits at full
             red for any realistic session, so the Lua never has to re-apply it
             (and never replays the buff-appeared animation). How long low
             morale actually lasts is the management layer's call. -->
        <buff buff_class_id="15" buff_exclusivity_id="1"
              buff_id="e5a10010-2c4b-4e6a-9f01-000000000010"
              buff_lifetime_id="0" buff_name="merc_low_morale"
              buff_ui_name="buff_merc_low_morale_name"
              buff_desc="buff_merc_low_morale_desc"
              buff_ui_order="-100" buff_ui_type_id="2" buff_ui_visibility_id="3"
              duration="604800" icon_id="low_morale_merc"
              implementation="Cpp:Fading" is_persistent="false" />

