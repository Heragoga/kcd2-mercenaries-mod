<?xml version="1.0" encoding="utf-8"?>
<database xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="barbora" xsi:noNamespaceSchemaLocation="FactionTree.xsd">
	<FactionTree version="1">

        <Faction Name="mercenariesFaction">
			<Relations>
				<Relation target="player" reputation="1" />
				<Relation target="players_friends" reputation="1" />
				<Relation target="kutnohorsko_allies" reputation="1" />
				<Relation target="trosecko_allies" reputation="1" />
				<Relation target="players_enemies" reputation="-1" />
				<Relation target="trosecko_enemies" reputation="-1" />
				<Relation target="kutnohorsko_enemies" reputation="-1" />
				<Relation target="kutnohorsko_enemies_oblehaniSuchdoleEnemyArmy" reputation="-1" />
				<Relation target="enemiesFaction" reputation="-1" />
			</Relations>
		</Faction>
		<Faction Name="enemiesFaction">
            <Relations>
                <Relation target="player"              reputation="-1" />
                <Relation target="mercenariesFaction"  reputation="-1" />
				<Relation target="players_friends" reputation="1" />
				<Relation target="kutnohorsko_allies" reputation="1" />
				<Relation target="trosecko_allies" reputation="1" />
				<Relation target="players_enemies" reputation="1" />
				<Relation target="trosecko_enemies" reputation="1" />
				<Relation target="kutnohorsko_enemies" reputation="1" />
				<Relation target="kutnohorsko_enemies_oblehaniSuchdoleEnemyArmy" reputation="1" />
            </Relations>
        </Faction>
		<!-- Test-only faction: friendly to the player and to our mercs, so the test NPC
		     can be walked around the camp without anyone drawing on him. -->
		<Faction Name="testFaction">
			<Relations>
				<Relation target="player" reputation="1" />
				<Relation target="mercenariesFaction" reputation="1" />
				<Relation target="players_friends" reputation="1" />
			</Relations>
		</Faction>
		<!-- Roaming patrols. Hostile to the player, to his mercenaries and to the mod's
		     bandit groups - and deliberately silent about every other faction, so
		     civilians and quest NPCs fall through to the default neutral relation
		     rather than being dragged into a war they have nothing to do with. -->
		<Faction Name="patrolFaction">
			<Relations>
				<Relation target="player" reputation="-1" />
				<Relation target="mercenariesFaction" reputation="-1" />
				<Relation target="enemiesFaction" reputation="-1" />
			</Relations>
		</Faction>
    </FactionTree>
</database>