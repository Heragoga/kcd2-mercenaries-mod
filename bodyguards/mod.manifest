<?xml version="1.0" encoding="utf-8"?>
<kcd_mod xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <info>
    <name>KCD2 Companion</name>
    <description>Summon a squad of up to 10 bodyguards and command them from an in-game menu (F5): they follow you on foot and on horseback, fight for you, obey orders (wait, regroup, dispatch, individual commands) and can be healed. Save-friendly and dependency-free. Localized into 16 languages.</description>
    <author>oskar</author>
    <version>1.1.1</version>
    <created_on>2026-06-30T00:00:00.0000000+02:00</created_on>
    <modid>kcdcompanion</modid>
    <modifies_level>false</modifies_level>
  </info>
</kcd_mod>
