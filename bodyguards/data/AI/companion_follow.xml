<?xml version="1.0" encoding="us-ascii"?>
<BehaviorTrees>
    <BehaviorTree name="companion_follow" is_function="0">
        <Variables>
            <Variable name="followTarget"        type="_wuid"  values="" isPersistent="0" form="single" />
            <Variable name="playerWUID"          type="_wuid"  values="" isPersistent="0" form="single" />
            <Variable name="playerIsMounted"     type="_bool"  values="false" isPersistent="0" form="single" />
            <Variable name="horse"               type="_wuid"  values="" isPersistent="0" form="single" />
            <Variable name="horseSpawned"        type="_bool"  values="false" isPersistent="0" form="single" />
            <Variable name="mountAbandoned"      type="_bool"  values="false" isPersistent="0" form="single" />
            <Variable name="mountedDistToTarget" type="_float" values="0" isPersistent="0" form="single" />
            <Variable name="MoveParams_follow"   type="additionalMoveParams" values="destChangedThreshold('300ms')" isPersistent="0" form="single" />
                        <Variable name="playerStillTicks"    type="_float" values="0" isPersistent="0" form="single" />
            <Variable name="gestureTest"         type="_bool"  values="false" isPersistent="0" form="single" />
            <Variable name="gestureRandom"       type="_float" values="0" isPersistent="0" form="single" />
                        <Variable name="isNight"             type="_bool"  values="false" isPersistent="0" form="single" />
            <Variable name="torch"               type="_wuid"  values="" isPersistent="0" form="single" />
                        <Variable name="chatRole"            type="_float" values="0" isPersistent="0" form="single" />
            <Variable name="chatPartner"         type="_wuid"  values="" isPersistent="0" form="single" />
            <Variable name="polylog_participants"          type="_wuid"           values="" isPersistent="0" form="array" />
            <Variable name="polylog_participantsMetaroles" type="soulToMetaroles" values="" isPersistent="0" form="array" />
        </Variables>
        <Parameters>
            <Variable name="attackData" type="switch:interruptData:attack" values="" isPersistent="0" form="single" requirementType="In" />
        </Parameters>
        <Root OneTimeOnly="false" FailState="Recoverable" saveVersion="2">
            <Behavior canSkip="1">
                <Sequence>
                    <ExecuteLua code="System.LogAlways('[companion] BT START: companion_follow')" />
                    <Expression expressions="$playerWUID = $__player &#10; $followTarget = $__player" />
                    <Parallel successMode="Any" failureMode="Any">

                                                <Loop count="-1">
                            <Sequence>
                                <ExecuteLua code="kcdcompanion:CalculateFormationTarget(data, entity.this.id)" />
                                <Wait duration="'1s'" timeType="GameTime" doFail="false" variation="'200ms'" />
                            </Sequence>
                        </Loop>

                                                <Loop count="-1">
                            <Sequence>
                                <Wait duration="'2s'" timeType="GameTime" doFail="false" variation="'1s'" />
                                <StanceCheck soul="$__player" stance="horse" smartObject="" negate="false" failOnCondition="false" saveVersion="2">
                                    <Then canSkip="1"><ExecuteLua code="if not _G.PlayerMounted then _G.PlayerMounted = true end" /></Then>
                                    <Else canSkip="1"><ExecuteLua code="if _G.PlayerMounted then _G.PlayerMounted = false end" /></Else>
                                </StanceCheck>
                            </Sequence>
                        </Loop>

                                                <Loop count="-1">
                            <Sequence>
                                <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                                                <ExecuteLua code="
                                    data.playerIsMounted = _G.PlayerMounted or false
                                    pcall(function() kcdcompanion:UpdateStillness(data) end)
                                    data.gestureTest = _G.CompanionGestureTest or false
                                    pcall(function()
                                        local h = Calendar:GetWorldHourOfDay()
                                        data.isNight = (h &gt;= 21.0 or h &lt; 5.0)
                                    end)
                                    data.chatRole = 0
                                    pcall(function()
                                        local c = _G.CompanionChat
                                        if c then
                                            local myW = tostring(entity.this.id)
                                            if tostring(c.a) == myW then data.chatRole = 1; data.chatPartner = c.b
                                            elseif tostring(c.b) == myW then data.chatRole = 2; data.chatPartner = c.a end
                                        end
                                    end)
                                    local ok, err = pcall(function()
                                        local me = entity
                                        local horseName = 'CompanionHorse_' .. tostring(me:GetName())
                                        local exists = System.GetEntityByName(horseName)
                                        if data.playerIsMounted then
                                            if (not exists) and (not data.mountAbandoned) then
                                                local pos = me and me:GetPos()
                                                if pos then
                                                    local angle = math.random() * 2 * math.pi
                                                    local hp = { x = pos.x + math.cos(angle) * 5.0, y = pos.y + math.sin(angle) * 5.0, z = pos.z }
                                                    System.SpawnEntity({ class = 'Horse', name = horseName, position = hp, orientation = {x=0,y=0,z=0}, properties = {guidSharedSoulId = 'c0a9a0b1-4405-4c0a-9a01-0000000ce001', bSaved_by_game = false} })
                                                    local h = System.GetEntityByName(horseName)
                                                    if not h then
                                                        System.SpawnEntity({ class = 'Horse', name = horseName, position = hp, orientation = {x=0,y=0,z=0}, properties = {guidSharedSoulId = 'fc0e6251-b314-4398-b83f-3a66a52961ee', bSaved_by_game = false} })
                                                        h = System.GetEntityByName(horseName)
                                                    end
                                                    if h then data.horse = h.this.id; data.horseSpawned = true end
                                                    System.LogAlways('[companion] HL(lua) SPAWN '..horseName..' exists='..tostring(h~=nil))
                                                end
                                            end
                                        else
                                            data.horseSpawned = false
                                            data.mountAbandoned = false
                                            if exists then
                                                data.despawnCountdown = (data.despawnCountdown or 8) - 1
                                                if data.despawnCountdown &lt; 1 then
                                                    System.RemoveEntity(exists.id); data.horse = nil; data.despawnCountdown = nil
                                                    System.LogAlways('[companion] HL(lua) DESPAWN '..horseName)
                                                end
                                            else
                                                data.horse = nil; data.despawnCountdown = nil
                                            end
                                        end
                                    end)
                                    if not ok then System.LogAlways('[companion] HL(lua) err: '..tostring(err)) end
                                " />
                            </Sequence>
                        </Loop>

                                                <Loop count="-1">
                            <Sequence>
                                <MeasureDistance position1="$this.id" position2="$followTarget" mode="TwoDimensions" result="$mountedDistToTarget" />
                                <Wait duration="'1s'" timeType="GameTime" doFail="false" variation="'100ms'" />
                            </Sequence>
                        </Loop>

                                                <Loop count="-1">
                            <ContinuousSwitch>

                                                                <IfCondition failOnCondition="false" condition="$gestureTest">
                                    <Sequence>
                                        <ExecuteLua code="_G.CompanionGestureTest = false" />
                                        <SuppressFailure><UnstanceAction unstance="LookingAround" locationObject="" slaveObject="" /></SuppressFailure>
                                        <Wait duration="'1s'" timeType="GameTime" doFail="false" variation="'300ms'" />
                                    </Sequence>
                                </IfCondition>

                                                                <IfCondition failOnCondition="false" condition="$chatRole == 1.0 &amp; (~$horseSpawned | $mountAbandoned)">
                                    <Sequence>
                                        <SuppressFailure>
                                            <Sequence>
                                                <Turn target="$chatPartner" align="false" />
                                                <Expression expressions="$polylog_participants[0] = $chatPartner &#10;$polylog_participantsMetaroles[0].soul = $chatPartner &#10;$polylog_participantsMetaroles[0].metaroles = 'GOSSIP'" />
                                                <Parallel successMode="Any" failureMode="Any">
                                                    <Function_speech_schedulerPolylog_initiator alias="" animationApproach="$enum:animationApproach.dontPlayDialogAnimations" areaForPlayer="" context="" customParameters="" metarole="'GOSSIP'" participants="$polylog_participants" participantsMetaroles="$polylog_participantsMetaroles" preset="$enum:dialogPreset.ingame" nodeLabel="73132072" />
                                                    <Wait duration="'30s'" timeType="GameTime" doFail="false" variation="" />
                                                </Parallel>
                                            </Sequence>
                                        </SuppressFailure>
                                        <ExecuteLua code="pcall(function() kcdcompanion.EndChat() end)" />
                                        <Wait duration="'2s'" timeType="GameTime" doFail="false" variation="" />
                                    </Sequence>
                                </IfCondition>

                                                                <IfCondition failOnCondition="false" condition="$chatRole == 2.0 &amp; (~$horseSpawned | $mountAbandoned)">
                                    <Sequence>
                                        <SuppressFailure>
                                            <Sequence>
                                                <Turn target="$chatPartner" align="false" />
                                                <Parallel successMode="Any" failureMode="Any">
                                                    <Function_speech_schedulerPolylog_receiver aliasOrMetarole="'GOSSIP'" initiator="$chatPartner" numberOfParticipants="2" useIngameDialogPoseAndAnimations="false" nodeLabel="71778248" />
                                                    <Wait duration="'30s'" timeType="GameTime" doFail="false" variation="" />
                                                </Parallel>
                                            </Sequence>
                                        </SuppressFailure>
                                        <Wait duration="'2s'" timeType="GameTime" doFail="false" variation="" />
                                    </Sequence>
                                </IfCondition>

                                                                <IfCondition failOnCondition="false" condition="$playerStillTicks &gt; 30.0 &amp; $mountedDistToTarget &lt; 6.0 &amp; (~$horseSpawned | $mountAbandoned)">
                                    <Sequence>
                                        <ExecuteLua code="data.gestureRandom = math.random(1, 4)" />
                                        <IfCondition failOnCondition="false" condition="$gestureRandom == 1.0">
                                            <SuppressFailure><UnstanceAction unstance="LookingAround" locationObject="" slaveObject="" /></SuppressFailure>
                                        </IfCondition>
                                        <IfCondition failOnCondition="false" condition="$gestureRandom == 2.0">
                                            <SuppressFailure><UnstanceAction unstance="waiting_armsCrossed" locationObject="" slaveObject="" /></SuppressFailure>
                                        </IfCondition>
                                        <IfCondition failOnCondition="false" condition="$gestureRandom == 3.0">
                                            <SuppressFailure><UnstanceAction unstance="waiting_armAkimbo" locationObject="" slaveObject="" /></SuppressFailure>
                                        </IfCondition>
                                        <IfCondition failOnCondition="false" condition="$gestureRandom == 4.0">
                                            <SuppressFailure><UnstanceAction unstance="LeaningBack" locationObject="" slaveObject="" /></SuppressFailure>
                                        </IfCondition>
                                        <Wait duration="'25s'" timeType="GameTime" doFail="false" variation="'12s'" />
                                    </Sequence>
                                </IfCondition>

                                                                <IfCondition failOnCondition="false" condition="$isNight &amp; (~$horseSpawned | $mountAbandoned)">
                                    <Sequence>
                                        <SuppressFailure>
                                            <Function_findItemOnSlot linkName="'torch'" npc="$this.id" searchOrigin="$this.id" item="$torch" nodeLabel="30465299" />
                                        </SuppressFailure>
                                        <IfElseCondition failOnCondition="false" condition="$torch ~= $__null" saveVersion="2">
                                            <Then canSkip="1">
                                                <HandContentElement hand="Left" item="$torch" allowAny="false" decisionLabel="companion_torch" useDecision="true" enabled="true" saveVersion="2">
                                                    <Sequence>
                                                        <MoveParamsDecorator speed="Any" pathFindingParams="" doorClosingPolicy="LeaveOpened">
                                                            <CrimeFollower Target="$followTarget" Mode="Default" Role="Assist" RelativeSpeedLimit="Dash" DisableGhosting="false" BlockWay="false" />
                                                        </MoveParamsDecorator>
                                                        <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                                    </Sequence>
                                                </HandContentElement>
                                            </Then>
                                            <Else canSkip="1">
                                                <Sequence>
                                                    <MoveParamsDecorator speed="Any" pathFindingParams="" doorClosingPolicy="LeaveOpened">
                                                        <CrimeFollower Target="$followTarget" Mode="Default" Role="Assist" RelativeSpeedLimit="Dash" DisableGhosting="false" BlockWay="false" />
                                                    </MoveParamsDecorator>
                                                    <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                                </Sequence>
                                            </Else>
                                        </IfElseCondition>
                                    </Sequence>
                                </IfCondition>

                                                                <IfCondition failOnCondition="false" condition="~$horseSpawned | $mountAbandoned">
                                    <Sequence>
                                                                                <MoveParamsDecorator speed="Any" pathFindingParams="" doorClosingPolicy="LeaveOpened">
                                            <CrimeFollower Target="$followTarget" Mode="Default" Role="Assist" RelativeSpeedLimit="Dash" DisableGhosting="false" BlockWay="false" />
                                        </MoveParamsDecorator>
                                        <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                    </Sequence>
                                </IfCondition>

                                                                <IfCondition failOnCondition="false" condition="$horseSpawned &amp; ~$mountAbandoned">
                                    <Sequence>
                                        <SuppressFailure>
                                            <Parallel successMode="Any" failureMode="Any">
                                                <StanceElement smartObject="$horse" stance="horse" allowAny="false" enabled="true">
                                                    <CrimeFollower Target="$followTarget" Mode="Default" Role="Assist" RelativeSpeedLimit="Dash" DisableGhosting="false" BlockWay="false" />
                                                </StanceElement>
                                                <Wait duration="'10s'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                            </Parallel>
                                        </SuppressFailure>

                                        <StanceCheck soul="$this.id" stance="horse" smartObject="" negate="false" failOnCondition="false" saveVersion="2">
                                            <Then canSkip="1">
                                                                                                <Loop count="-1">
                                                    <SuppressFailure>
                                                        <StanceElement smartObject="$horse" stance="horse" allowAny="false" enabled="true">
                                                            <ContinuousSwitch>
                                                                <IfCondition failOnCondition="false" condition="$mountedDistToTarget &gt; 10.0">
                                                                    <Move stopWithinDistance="14.0" stopDistanceVariation="3.0" rayCasteFlee="false" successDistance="0.0" changeNPCState="false" fastForwardIncludesMove="false" destinationSpecification="$followTarget" destinationSpecification2="16.0" destinationSpecification3="4.0" speed="Dash" additionalParams="$MoveParams_follow" pathFindingParams="" staminaPolicy="" pathInfo="" />
                                                                </IfCondition>
                                                                <IfCondition failOnCondition="false" condition="$mountedDistToTarget &lt;= 10.0">
                                                                    <Move stopWithinDistance="10.0" stopDistanceVariation="2.0" rayCasteFlee="false" successDistance="0.0" changeNPCState="false" fastForwardIncludesMove="false" destinationSpecification="$followTarget" destinationSpecification2="11.0" destinationSpecification3="2.0" speed="Walk" additionalParams="$MoveParams_follow" pathFindingParams="" staminaPolicy="" pathInfo="" />
                                                                </IfCondition>
                                                            </ContinuousSwitch>
                                                        </StanceElement>
                                                    </SuppressFailure>
                                                </Loop>
                                            </Then>
                                            <Else canSkip="1">
                                                                                                <Sequence>
                                                    <ExecuteLua code="
                                                        local ok = pcall(function()
                                                            local h = System.GetEntityByName('CompanionHorse_' .. tostring(entity:GetName()))
                                                            if h then System.RemoveEntity(h.id) end
                                                        end)
                                                        pcall(function() System.LogAlways('[companion] HL MOUNT FAIL (10s) - abandoning horse, back on foot') end)
                                                    " />
                                                    <Expression expressions="$horseSpawned = false &#10; $horse = $__null &#10; $mountAbandoned = true" />
                                                </Sequence>
                                            </Else>
                                        </StanceCheck>
                                    </Sequence>
                                </IfCondition>

                                <IfCondition failOnCondition="false" condition="true">
                                    <Wait duration="'300ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                </IfCondition>

                            </ContinuousSwitch>
                        </Loop>

                                                <Loop count="-1">
                            <Sequence>
                                <Wait duration="'1s'" timeType="GameTime" doFail="false" variation="'200ms'" />
                                <IfCondition failOnCondition="false" condition="~$horseSpawned &amp; $mountedDistToTarget &gt; 60.0">
                                    <ExecuteLua code="
                                        local ok, err = pcall(function()
                                            local pe = XGenAIModule.GetEntityByWUID(data.playerWUID)
                                            if not pe then return end
                                            local pp = pe:GetWorldPos()
                                            local pd = pe:GetDirectionVector()
                                            local bx, by = -(pd and pd.x or 0), -(pd and pd.y or 0)
                                            local sp = { x = pp.x + bx * 4.0, y = pp.y + by * 4.0, z = pp.z + 2.0 }
                                            local ht = {}
                                            local gh = Physics.RayWorldIntersection(sp, {x=0,y=0,z=-100}, 2, ent_terrain + ent_static, 0, nil, ht)
                                            if gh &gt; 0 and ht[1] then sp.z = ht[1].pos.z else sp.z = pp.z end
                                            entity:SetPos({ x = sp.x, y = sp.y, z = sp.z })
                                        end)
                                        if not ok then System.LogAlways('[companion] teleport err: ' .. tostring(err)) end
                                    " />
                                </IfCondition>
                            </Sequence>
                        </Loop>

                    </Parallel>
                </Sequence>
            </Behavior>
        </Root>
        <ForestContainer />
    </BehaviorTree>
</BehaviorTrees>
