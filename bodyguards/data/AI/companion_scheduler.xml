<?xml version="1.0" encoding="us-ascii"?>
<BehaviorTrees>
    <BehaviorTree name="onUpdate" is_function="0">
        <Variables>
            <Variable name="playerWUID"        type="_wuid" values="" isPersistent="0" form="single" />
            <Variable name="isFollowingActive" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="isIdle"            type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="mrkev"             type="_wuid" values="" isPersistent="0" form="single" />
            <Variable name="attackData"        type="switch:interruptData:attack" values="" isPersistent="0" form="single" />
            <Variable name="crimeInformation"  type="information" values="" isPersistent="0" form="single" />
                        <Variable name="inCombat"        type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="isFriendly"      type="_bool" values="true"  isPersistent="0" form="single" />
            <Variable name="foundTarget"     type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="playerTarget"    type="_wuid" values="" isPersistent="0" form="single" />
            <Variable name="currentTarget"   type="_wuid" values="" isPersistent="0" form="single" />
            <Variable name="mercTarget"      type="_wuid" values="" isPersistent="0" form="single" />
            <Variable name="candidate"       type="_wuid" values="" isPersistent="0" form="single" />
            <Variable name="candidateTarget" type="_wuid" values="" isPersistent="0" form="single" />
            <Variable name="enemiesArray"    type="_wuid" values="" isPersistent="0" form="array" />
                        <Variable name="barkNow"         type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="ackNow"          type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="ackRandom"       type="_float" values="0" isPersistent="0" form="single" />
        </Variables>
        <Root OneTimeOnly="false" FailState="Recoverable" saveVersion="2">
            <Behavior canSkip="1">
                <SuppressFailure>
                    <Parallel successMode="Any" failureMode="Any">

                                                <Loop count="-1">
                            <Sequence>
                                <Expression expressions="$playerWUID = $__player" />
                                <ExecuteLua code="data.isIdle = _G.CompanionWait or false" />
                                <Wait duration="'300ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                            </Sequence>
                        </Loop>

                                                <Loop count="-1">
                            <Sequence>
                                <Wait duration="'2s'" timeType="GameTime" doFail="false" variation="'900ms'" />
                                <ExecuteLua code="
                                    data.barkNow = false
                                    data.ackNow = false
                                    pcall(function()
                                        if _G.CompanionAck then _G.CompanionAck = false; data.ackNow = true; data.ackRandom = math.random(1, 4); return end
                                        if _G.CompanionBarkTest then _G.CompanionBarkTest = false; data.barkNow = true; return end
                                        if _G.CompanionSpeakLock then return end
                                        _G.CompanionBarkCd = (_G.CompanionBarkCd or 0) + 1
                                        if _G.CompanionBarkCd &gt;= 40 and math.random(1, 6) == 1 then
                                            _G.CompanionBarkCd = 0
                                            data.barkNow = true
                                        end
                                    end)
                                    if data.barkNow or data.ackNow then
                                        _G.CompanionSpeakLock = true
                                        pcall(function() Script.SetTimerForFunction(12000, 'kcdcompanion.ReleaseSpeakLock') end)
                                    end
                                " />
                                <IfCondition failOnCondition="false" condition="$barkNow &amp; ~$inCombat">
                                    <SuppressFailure>
                                        <Function_speech_schedulerMonolog alias="" animationApproach="$enum:animationApproach.dontPlayDialogAnimations" context="" lookAtId="$__null" metarole="'SAMOMLUVA'" skipInLod="false" subtitlesDown="false" />
                                    </SuppressFailure>
                                </IfCondition>
                                                                <IfCondition failOnCondition="false" condition="$ackNow &amp; $ackRandom == 1.0">
                                    <SuppressFailure>
                                        <Function_speech_schedulerMonolog alias="" animationApproach="$enum:animationApproach.dontPlayDialogAnimations" context="" lookAtId="$__null" metarole="'NPC_NASLO_ZDROJ_ZVUKU_(PISKANI_BLIZKO)'" skipInLod="false" subtitlesDown="false" />
                                    </SuppressFailure>
                                </IfCondition>
                                <IfCondition failOnCondition="false" condition="$ackNow &amp; $ackRandom == 2.0">
                                    <SuppressFailure>
                                        <Function_speech_schedulerMonolog alias="" animationApproach="$enum:animationApproach.dontPlayDialogAnimations" context="" lookAtId="$__null" metarole="'NPC_NASLO_ZDROJ_ZVUKU_(PISKANI_DALEKO)'" skipInLod="false" subtitlesDown="false" />
                                    </SuppressFailure>
                                </IfCondition>
                                <IfCondition failOnCondition="false" condition="$ackNow &amp; $ackRandom == 3.0">
                                    <SuppressFailure>
                                        <Function_speech_schedulerMonolog alias="" animationApproach="$enum:animationApproach.dontPlayDialogAnimations" context="" lookAtId="$__null" metarole="'NPC_ZDRAVI_HRACE'" skipInLod="false" subtitlesDown="false" />
                                    </SuppressFailure>
                                </IfCondition>
                                <IfCondition failOnCondition="false" condition="$ackNow &amp; $ackRandom == 4.0">
                                    <SuppressFailure>
                                        <Function_speech_schedulerMonolog alias="" animationApproach="$enum:animationApproach.dontPlayDialogAnimations" context="" lookAtId="$__null" metarole="'SITUACE_POZDRAVY'" skipInLod="false" subtitlesDown="false" />
                                    </SuppressFailure>
                                </IfCondition>
                            </Sequence>
                        </Loop>

                                                <Loop count="-1">
                            <Sequence>
                                <Wait duration="'1s'" timeType="GameTime" doFail="false" variation="'300ms'" />
                                <AtomicDecorator>
                                    <Sequence>
                                        <Expression expressions="$playerWUID = $__player &#10; $playerTarget = $__null &#10; $mercTarget = $__null &#10; $foundTarget = false &#10; $isFriendly = true" />
                                        <SuppressFailure>
                                            <IfCondition failOnCondition="false" condition="~$inCombat &amp; ~$isIdle">
                                                                                                <ExecuteLua code="kcdcompanion:PickTarget(data, entity.this.id)" />
                                            </IfCondition>
                                        </SuppressFailure>
                                        <SuppressFailure><GetTarget ReferenceNPC="$this.id" TargetVarOut="$mercTarget" /></SuppressFailure>
                                    </Sequence>
                                </AtomicDecorator>

                                <IfCondition failOnCondition="false" condition="~$isIdle">
                                    <EntityContextCheck context="crime_interruptAttack" target="$this.id" saveVersion="2">
                                        <Then canSkip="1">
                                            <Wait duration="'300ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                        </Then>
                                        <Else canSkip="1">
                                            <IfCondition failOnCondition="false" condition="$playerTarget ~= $__null &amp; ~$isFriendly &amp; $playerTarget ~= $this.id &amp; $playerTarget ~= $currentTarget">
                                                <Sequence>
                                                    <ExecuteLua code="System.LogAlways('[companion] ATTACK: enemy detected -> companion_attack')" />
                                                    <Expression expressions="$currentTarget = $playerTarget" />
                                                    <SuppressFailure>
                                                        <Function_crime_getMrkev mrkev="$mrkev" nodeLabel="1234" />
                                                        <CreateInformationWrapper Label="'assault'" PerceivedWuid="$this.id" PositionType="positionWuid" PositionVec3="" PositionWuid="$playerTarget" Information="$crimeInformation" />
                                                        <LockDynamicInformationValues Information="$crimeInformation">
                                                            <SetDynamicInformationValue Information="$crimeInformation" Tag="'stimulusKind'" Variable="$enum:crime_stimulusKind.combat" Type="" Value="" />
                                                        </LockDynamicInformationValues>
                                                        <Function_crime_limits_reserveReactionLink ffCrimeIcon="false" information="$crimeInformation" priority="160" reactionKind="$enum:crime_reactionKind.attack" nodeLabel="898990" />
                                                    </SuppressFailure>
                                                    <Expression expressions="$attackData.target = $playerTarget &#10; $attackData.information = $crimeInformation &#10; $attackData.stimulusKind = $enum:crime_stimulusKind.combat &#10; $attackData.previousReaction = $enum:crime_reactionKind.unknown &#10; $attackData.initiatedBy = $enum:switch_interruptInitiator.switch &#10; $attackData.defenceMode = false &#10; $attackData.relationOverride = true &#10; $attackData.source = $enum:crime_source.direct &#10; $attackData.freshlyAttributedCrime = false &#10; $attackData.criminalFreshness = $enum:crime_criminalFreshness.unknown &#10; $attackData.escalatedFromFailedSurrender = false" />
                                                    <AddInterrupt_attack attackData="$attackData" Target="$this.id" Host="$mrkev" Behavior="'companion_attack'" Priority="160" IgnorePriorityOnPreviousInterrupt="true" urgency="Fast" Aliveness="Alive" Privileged="false" FastForward="false" />
                                                </Sequence>
                                            </IfCondition>
                                        </Else>
                                    </EntityContextCheck>
                                </IfCondition>
                            </Sequence>
                        </Loop>

                                                <Loop count="-1">
                            <Sequence>
                                <EntityContextCheck context="crime_interruptAttack" target="$this.id" saveVersion="2">
                                    <Then canSkip="1"><Expression expressions="$inCombat = true" /></Then>
                                    <Else canSkip="1"><Expression expressions="$inCombat = false &#10; $currentTarget = $__null" /></Else>
                                </EntityContextCheck>
                                <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                            </Sequence>
                        </Loop>

                                                <Loop count="-1">
                            <ContinuousSwitch>

                                                                <IfCondition failOnCondition="false" condition="$isIdle">
                                    <EntityContext context="crime_suppressBehavioralReaction" target="$this.id">
                                        <Sequence>
                                            <IfCondition failOnCondition="false" condition="$isFollowingActive">
                                                <Sequence>
                                                    <ExecuteLua code="System.LogAlways('[companion] stop -> waiting')" />
                                                    <Expression expressions="$isFollowingActive = false" />
                                                    <SuppressFailure>
                                                        <AddInterrupt_teleport destination="$this.id" Target="$this.id" Host="$__land" Behavior="'teleport'" Priority="160" IgnorePriorityOnPreviousInterrupt="true" urgency="Instant" Aliveness="Alive" Privileged="false" FastForward="true" />
                                                    </SuppressFailure>
                                                </Sequence>
                                            </IfCondition>
                                            <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                        </Sequence>
                                    </EntityContext>
                                </IfCondition>

                                <IfCondition failOnCondition="false" condition="$inCombat | $mercTarget ~= $__null">
                                    <EntityContext context="crime_suppressBehavioralReaction" target="$this.id">
                                        <Sequence>
                                            <Expression expressions="$isFollowingActive = false" />
                                            <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                        </Sequence>
                                    </EntityContext>
                                </IfCondition>

                                                                <IfCondition failOnCondition="false" condition="true">
                                    <EntityContext context="crime_suppressBehavioralReaction" target="$this.id">
                                        <Sequence>
                                            <IfCondition failOnCondition="false" condition="~$isFollowingActive">
                                                <Sequence>
                                                    <ExecuteLua code="System.LogAlways('[companion] issuing follow order')" />
                                                    <SuppressFailure>
                                                        <Function_crime_getMrkev mrkev="$mrkev" nodeLabel="1234" />
                                                        <CreateInformationWrapper Label="'assault'" PerceivedWuid="$this.id" PositionType="positionWuid" PositionVec3="" PositionWuid="$__player" Information="$crimeInformation" />
                                                        <LockDynamicInformationValues Information="$crimeInformation">
                                                            <SetDynamicInformationValue Information="$crimeInformation" Tag="'stimulusKind'" Variable="$enum:crime_stimulusKind.combat" Type="" Value="" />
                                                        </LockDynamicInformationValues>
                                                        <Function_crime_limits_reserveReactionLink ffCrimeIcon="false" information="$crimeInformation" priority="160" reactionKind="$enum:crime_reactionKind.attack" nodeLabel="898990" />
                                                    </SuppressFailure>

                                                    <Expression expressions="$attackData.target = $__player &#10; $attackData.information = $crimeInformation &#10; $attackData.stimulusKind = $enum:crime_stimulusKind.combat &#10; $attackData.previousReaction = $enum:crime_reactionKind.unknown &#10; $attackData.initiatedBy = $enum:switch_interruptInitiator.switch &#10; $attackData.defenceMode = false &#10; $attackData.relationOverride = true &#10; $attackData.source = $enum:crime_source.direct &#10; $attackData.freshlyAttributedCrime = false &#10; $attackData.criminalFreshness = $enum:crime_criminalFreshness.unknown &#10; $attackData.escalatedFromFailedSurrender = false" />
                                                    <AddInterrupt_attack attackData="$attackData" Target="$this.id" Host="$mrkev" Behavior="'companion_follow'" Priority="160" IgnorePriorityOnPreviousInterrupt="true" urgency="Fast" Aliveness="Alive" Privileged="false" FastForward="false" />
                                                    <Expression expressions="$isFollowingActive = true" />
                                                </Sequence>
                                            </IfCondition>
                                            <Wait duration="'500ms'" timeType="GameTime" doFail="false" variation="'100ms'" />
                                        </Sequence>
                                    </EntityContext>
                                </IfCondition>

                            </ContinuousSwitch>
                        </Loop>

                    </Parallel>
                </SuppressFailure>
            </Behavior>
        </Root>
    </BehaviorTree>
</BehaviorTrees>
