references/
voice/tools/testsaves/

# Blender workspace: built from the installed game's paks, never committed
kcd2_blender/

# Source art: Blender scenes, UI artwork and thumbnails, ~274 MB. Build inputs only -
# nothing under assets/ is shipped; data/Objects and data/libs/UI carry the built results.
# The generator scripts stay tracked: they are what produce the wall pieces and materials.
assets/
!assets/*.py
*.blend1
tmp/castle-rework/
__pycache__/

# Native research plugin build output (not shipped; see docs/walls-and-sieges.md)
native/*/out/

# Scratch: working paks, pre-change backups, one-off extraction dirs. ~150 MB of it.
tmp/

# Tool build output (regenerated by tools/make_*.py)
tools/out/
tools/kcdui/examples/out/
tools/local.paths.txt
