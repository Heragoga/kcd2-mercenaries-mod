<kcd_mod>
	<info>
		<name>magdalenaToRosaRuthard</name>
		<modid>magdalenatorosaruthard</modid>
		<description>Replaces the Legacy of the Forge DLC NPC Magdalena with Rosa Ruthard. All of Magdalena’s voice lines have been converted to Rosa’s voice. Cosmetic-only (no quest changes).</description>
